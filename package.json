{
  "name": "zhiwei",
  "version": "0.1.0",
  "private": true,
  "description": "知微：开源论文结构化理解基础设施",
  "license": "Apache-2.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node apps/web/server.js",
    "start": "node apps/web/server.js",
    "check": "node --check apps/web/static/app.js && node --check static/app.js",
    "check:api": "node --check api/_demo.js && node --check apps/api/_demo.js",
    "validate:schemas": "node packages/paper-ir/scripts/validate-schemas.js",
    "validate:examples": "node packages/benchmark/scripts/validate-examples.js",
    "test": "npm run check && npm run check:api && npm run validate:schemas && npm run validate:examples",
    "deploy": "vercel deploy --prod --yes"
  },
  "engines": {
    "node": ">=18"
  }
}
