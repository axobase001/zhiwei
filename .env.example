ZHIWEI_HOST=127.0.0.1
ZHIWEI_PORT=8765

# 默认可使用启发式 grounded extractor，不需要 API key。
# ZHIWEI_LLM_PROVIDER=heuristic

# 也兼容 OpenAI-compatible 环境变量名。
# 如果 OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL 都存在，
# 后端会自动使用 openai_compatible provider。
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# 或使用知微专用变量覆盖。
# ZHIWEI_LLM_PROVIDER=openai_compatible
# ZHIWEI_LLM_BASE_URL=
# ZHIWEI_LLM_API_KEY=
# ZHIWEI_LLM_MODEL=
