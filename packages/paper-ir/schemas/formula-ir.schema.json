{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhiwei.dev/schemas/formula-ir.schema.json",
  "title": "Zhiwei Formula IR",
  "type": "object",
  "required": ["formulas"],
  "additionalProperties": true,
  "properties": {
    "formulas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["formula_id", "latex", "role", "variables", "anchors"],
        "additionalProperties": true,
        "properties": {
          "formula_id": { "type": "string" },
          "latex": { "type": "string" },
          "plain_language_summary": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["definition", "loss", "objective", "metric", "update_rule", "probability", "attention", "optimization", "constraint"]
          },
          "variables": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["symbol", "meaning", "confidence"],
              "additionalProperties": true,
              "properties": {
                "symbol": { "type": "string" },
                "name": { "type": "string" },
                "meaning": { "type": "string" },
                "type": {
                  "type": "string",
                  "enum": ["input", "parameter", "latent", "output", "label", "hyperparameter", "metric", "index", "constant"]
                },
                "anchors": { "type": "array", "items": { "type": "string" } },
                "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
              }
            }
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["from", "to", "relation"],
              "additionalProperties": true,
              "properties": {
                "from": { "type": "string" },
                "to": { "type": "string" },
                "relation": {
                  "type": "string",
                  "enum": ["affects", "normalizes", "weights", "predicts", "compares_with", "optimizes"]
                }
              }
            }
          },
          "intuition": { "type": "string" },
          "anchors": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
