{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhiwei.dev/schemas/source-anchor.schema.json",
  "title": "Zhiwei Source Anchor",
  "type": "object",
  "required": ["anchor_id", "page", "text_span", "source_type"],
  "additionalProperties": true,
  "properties": {
    "anchor_id": { "type": "string", "minLength": 1 },
    "page": { "type": "integer", "minimum": 1 },
    "section": { "type": ["string", "null"] },
    "bbox": {
      "type": ["object", "null"],
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" }
      }
    },
    "text_span": { "type": "string" },
    "source_type": {
      "type": "string",
      "enum": ["paragraph", "formula", "figure", "table", "caption", "reference"]
    }
  }
}
