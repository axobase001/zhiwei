{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhiwei.dev/schemas/experiment-matrix.schema.json",
  "title": "Zhiwei Experiment Matrix",
  "type": "object",
  "required": ["experiments"],
  "additionalProperties": true,
  "properties": {
    "experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["experiment_id", "name", "type", "result_summary", "what_it_tries_to_prove", "anchors"],
        "additionalProperties": true,
        "properties": {
          "experiment_id": { "type": "string" },
          "name": { "type": "string" },
          "type": {
            "type": "string",
            "enum": ["main_result", "ablation", "robustness", "scaling", "case_study", "human_eval", "benchmark", "efficiency"]
          },
          "dataset": { "type": "array", "items": { "type": "string" } },
          "baseline": { "type": "array", "items": { "type": "string" } },
          "metrics": { "type": "array", "items": { "type": "string" } },
          "result_summary": { "type": "string" },
          "what_it_tries_to_prove": { "type": "string" },
          "evidence_strength": { "type": "string", "enum": ["strong", "medium", "weak", "unclear", "unknown"] },
          "anchors": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
