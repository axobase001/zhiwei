{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhiwei.dev/schemas/reproduction-roadmap.schema.json",
  "title": "Zhiwei Reproduction Roadmap",
  "type": "object",
  "required": ["reproduction"],
  "additionalProperties": true,
  "properties": {
    "reproduction": {
      "type": "object",
      "required": ["difficulty", "steps", "missing_details", "risk_points"],
      "additionalProperties": true,
      "properties": {
        "difficulty": { "type": "string", "enum": ["low", "medium", "high", "unknown"] },
        "required_datasets": { "type": "array", "items": { "type": "string" } },
        "required_models": { "type": "array", "items": { "type": "string" } },
        "required_compute": { "type": "string" },
        "code_available": { "type": "string", "enum": ["yes", "no", "unknown"] },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["step", "description", "anchors"],
            "additionalProperties": true,
            "properties": {
              "step": { "type": "string" },
              "description": { "type": "string" },
              "anchors": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "missing_details": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["detail", "why_it_matters"],
            "additionalProperties": true,
            "properties": {
              "detail": { "type": "string" },
              "why_it_matters": { "type": "string" },
              "anchors": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "risk_points": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["risk", "suggestion"],
            "additionalProperties": true,
            "properties": {
              "risk": { "type": "string" },
              "suggestion": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
