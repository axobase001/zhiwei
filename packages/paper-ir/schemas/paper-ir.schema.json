{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhiwei.dev/schemas/paper-ir.schema.json",
  "title": "Zhiwei Paper IR",
  "type": "object",
  "required": [
    "schema_version",
    "metadata",
    "anchors",
    "paper_skeleton",
    "method_graph",
    "method_delta",
    "formula_ir",
    "experiment_matrix",
    "claim_evidence_map",
    "glossary",
    "reproduction_roadmap"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "string" },
    "generated_at": { "type": "string" },
    "metadata": {
      "type": "object",
      "required": ["paper_id", "title", "authors", "uploaded_at", "language"],
      "additionalProperties": true,
      "properties": {
        "paper_id": { "type": "string" },
        "title": { "type": "string" },
        "authors": { "type": "array", "items": { "type": "string" } },
        "venue": { "type": ["string", "null"] },
        "year": { "type": ["integer", "null"] },
        "arxiv_id": { "type": ["string", "null"] },
        "doi": { "type": ["string", "null"] },
        "uploaded_at": { "type": "string" },
        "language": { "type": "string", "enum": ["en", "zh", "mixed"] }
      }
    },
    "anchors": {
      "type": "array",
      "items": { "$ref": "./source-anchor.schema.json" }
    },
    "paper_skeleton": {
      "type": "object",
      "required": ["problem", "core_idea", "method", "experiments", "claims"],
      "additionalProperties": true,
      "properties": {
        "problem": { "$ref": "#/$defs/anchoredSummary" },
        "motivation": { "$ref": "#/$defs/anchoredSummary" },
        "core_idea": { "$ref": "#/$defs/anchoredSummary" },
        "method": { "$ref": "#/$defs/anchoredSummary" },
        "experiments": { "$ref": "#/$defs/anchoredSummary" },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["claim_id", "claim", "anchors"],
            "additionalProperties": true,
            "properties": {
              "claim_id": { "type": "string" },
              "claim": { "type": "string" },
              "anchors": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["limitation", "anchors"],
            "additionalProperties": true,
            "properties": {
              "limitation": { "type": "string" },
              "anchors": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "method_graph": {
      "type": "object",
      "required": ["nodes", "edges"],
      "additionalProperties": true,
      "properties": {
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["node_id", "type", "anchors"],
            "additionalProperties": true,
            "properties": {
              "node_id": { "type": "string" },
              "label": { "type": "string" },
              "title": { "type": "string" },
              "summary": { "type": "string" },
              "description": { "type": "string" },
              "type": {
                "type": "string",
                "enum": ["input", "module", "process", "objective", "output", "dataset", "evaluation"]
              },
              "anchors": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["from", "to", "relation"],
            "additionalProperties": true,
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "relation": { "type": "string" },
              "description": { "type": "string" },
              "anchors": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "method_delta": { "type": "object" },
    "formula_ir": { "$ref": "./formula-ir.schema.json" },
    "experiment_matrix": { "$ref": "./experiment-matrix.schema.json" },
    "claim_evidence_map": { "$ref": "./claim-evidence.schema.json" },
    "glossary": { "type": "object" },
    "reproduction_roadmap": { "$ref": "./reproduction-roadmap.schema.json" },
    "verification": { "type": "object" }
  },
  "$defs": {
    "anchoredSummary": {
      "type": "object",
      "required": ["summary", "anchors"],
      "additionalProperties": true,
      "properties": {
        "summary": { "type": "string" },
        "anchors": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
