{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://zhiwei.dev/schemas/claim-evidence.schema.json",
  "title": "Zhiwei Claim-Evidence Map",
  "type": "object",
  "required": ["claims"],
  "additionalProperties": true,
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim_id", "claim", "claim_type", "evidence", "overall_support"],
        "additionalProperties": true,
        "properties": {
          "claim_id": { "type": "string" },
          "claim": { "type": "string" },
          "claim_type": {
            "type": "string",
            "enum": ["performance", "efficiency", "generalization", "interpretability", "robustness", "simplicity", "cost", "safety", "theoretical"]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["evidence_id", "source_type", "summary", "supports_claim", "anchors"],
              "additionalProperties": true,
              "properties": {
                "evidence_id": { "type": "string" },
                "source_type": {
                  "type": "string",
                  "enum": ["table", "figure", "experiment", "ablation", "theorem", "case_study", "paragraph"]
                },
                "summary": { "type": "string" },
                "supports_claim": { "type": "string", "enum": ["strongly", "partially", "weakly", "not_enough"] },
                "anchors": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "risk_flags": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "unsupported_claim",
                "only_case_study",
                "no_ablation",
                "small_dataset",
                "unclear_baseline",
                "metric_mismatch",
                "missing_implementation_detail"
              ]
            }
          },
          "overall_support": { "type": "string", "enum": ["strong", "medium", "weak", "unsupported"] }
        }
      }
    }
  }
}
