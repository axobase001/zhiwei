  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "对抗样本生成方法",
        "label": "方法概述",
        "summary": "本文使用三种方法生成对抗样本：快速梯度符号法（FGSM）、基本迭代法和迭代最不可能类法。",
        "description": "对抗样本是通过对原始图像添加微小扰动来欺骗分类器。本文比较了三种生成方法：快速法（单步）、基本迭代法（多步）和迭代最不可能类法（针对特定目标类）。",
        "type": "method",
        "anchors": [
          "anc_00028",
          "anc_00039",
          "anc_00047",
          "anc_00057"
        ]
      },
      {
        "node_id": "node_002",
        "title": "快速梯度符号法（FGSM）",
        "label": "快速法",
        "summary": "通过线性化损失函数并求解最大化损失的扰动，生成对抗样本。",
        "description": "公式为 X_adv = X + ε * sign(∇_X J(X, y_true))，其中ε是扰动大小。该方法快速，但扰动较大。",
        "type": "method",
        "anchors": [
          "anc_00039",
          "anc_00040",
          "anc_00042",
          "anc_00044",
          "anc_00045"
        ]
      },
      {
        "node_id": "node_003",
        "title": "基本迭代法",
        "label": "迭代法",
        "summary": "多次应用快速法，每次步长较小，并裁剪像素值以确保在ε邻域内。",
        "description": "公式为 X_adv^{N+1} = Clip_{X,ε}(X_adv^N + α * sign(∇_X J(X_adv^N, y_true)))，其中α=1，迭代次数为 min(ε+4, 1.25ε)。",
        "type": "method",
        "anchors": [
          "anc_00047",
          "anc_00048",
          "anc_00049",
          "anc_00051",
          "anc_00053",
          "anc_00054",
          "anc_00055",
          "anc_00056"
        ]
      },
      {
        "node_id": "node_004",
        "title": "迭代最不可能类法",
        "label": "最不可能类法",
        "summary": "针对最不可能的类（y_LL）生成对抗样本，使图像被分类为该类。",
        "description": "首先计算最不可能类 y_LL = arg min_y p(y|X)，然后通过最大化 log p(y_LL|X) 生成对抗样本。公式类似基本迭代法，但梯度方向相反。",
        "type": "method",
        "anchors": [
          "anc_00057",
          "anc_00060",
          "anc_00061",
          "anc_00063",
          "anc_00064",
          "anc_00065",
          "anc_00067",
          "anc_00069",
          "anc_00070",
          "anc_00072",
          "anc_00073",
          "anc_00075",
          "anc_00076"
        ]
      },
      {
        "node_id": "node_005",
        "title": "物理世界实验设置",
        "label": "实验设置",
        "summary": "将对抗样本打印、拍照、裁剪后输入Inception v3分类器，测量分类准确率。",
        "description": "实验步骤：1. 生成对抗样本并打印；2. 用手机拍照；3. 自动裁剪和扭曲图像；4. 输入分类器。使用平均情况和预过滤情况两种设置。",
        "type": "experiment",
        "anchors": [
          "anc_00099",
          "anc_00100",
          "anc_00101",
