        ]
      },
      {
        "node_id": "node_006",
        "title": "破坏率度量",
        "label": "破坏率",
        "summary": "定义破坏率来量化对抗样本在物理变换后的失效比例。",
        "description": "破坏率 d = (∑ C(X,y_true) * C(X_adv,y_true) * C(T(X_adv),y_true)) / (∑ C(X,y_true) * C(X_adv,y_true))，其中C是分类正确指示函数。",
        "type": "metric",
        "anchors": [
          "anc_00088",
          "anc_00089",
          "anc_00090",
          "anc_00091",
          "anc_00092",
          "anc_00093",
          "anc_00095"
        ]
      },
      {
        "node_id": "node_007",
        "title": "实验结果分析",
        "label": "结果分析",
        "summary": "快速法对抗样本对物理变换更鲁棒，迭代方法更精细但更易被破坏。",
        "description": "在平均情况下，快速法对抗样本在ε=16时仍有较高错误率；迭代方法在ε较小时效果更好，但随ε增大而下降。预过滤情况下，迭代方法破坏率更高。",
        "type": "analysis",
