{
  "paper_skeleton": {
    "problem": {
      "summary": "机器学习分类器在物理世界中是否容易受到对抗样本的攻击？先前工作假设攻击者可以直接向分类器输入数据，但物理世界系统（如使用摄像头）的威胁模型不同。",
      "anchors": [
        "anc_00003",
        "anc_00020"
      ]
    },
    "motivation": {
      "summary": "对抗样本对机器学习系统构成安全威胁。先前工作假设攻击者可直接输入数据，但物理世界系统（如摄像头输入）的威胁模型不同。本文旨在研究对抗样本在物理世界中的鲁棒性。",
      "anchors": [
        "anc_00003",
        "anc_00012",
        "anc_00017",
        "anc_00020"
      ]
    },
    "core_idea": {
      "summary": "通过将对抗样本打印并拍照，再输入图像分类器，证明即使经过物理世界的变换（如打印和拍照），对抗样本仍能导致分类错误。",
      "anchors": [
        "anc_00020",
        "anc_00021",
        "anc_00100"
      ]
    },
    "method": {
      "summary": "使用三种方法生成对抗样本：快速梯度符号法（FGSM）、基本迭代法和迭代最不可能类法。然后将对抗样本打印、拍照、裁剪后输入Inception v3分类器，测量分类准确率。",
      "anchors": [
        "anc_00028",
        "anc_00039",
        "anc_00047",
        "anc_00057",
        "anc_00099",
        "anc_00100",
        "anc_00101"
      ]
    },
    "experiments": {
      "summary": "在ImageNet验证集上，使用Inception v3模型，比较不同对抗方法和不同扰动大小（ε）下的分类准确率。实验包括平均情况和预过滤情况，并计算对抗样本的破坏率。",
      "anchors": [
        "anc_00079",
        "anc_00080",
        "anc_00088",
        "anc_00099",
        "anc_00100",
        "anc_00103",
        "anc_00109"
      ]
    },
