  "glossary": {
    "terms": [
      {
        "term": "Trainable Bag-of-Freebies",
        "definition": "指在训练阶段应用、但不增加推理成本的技术集合，旨在提升模型精度。",
        "anchors": [
          "anc_00002",
          "anc_00005",
          "anc_00006",
          "anc_00010",
          "anc_00011",
          "anc_00012"
        ]
      },
      {
        "term": "E-ELAN (Extended Efficient Layer Aggregation Networks)",
        "definition": "扩展高效层聚合网络，通过分组卷积扩展通道和基数，并以shuffle和merge方式组合特征，增强学习能力。",
        "anchors": [
          "anc_00015",
          "anc_00016",
          "anc_00019",
          "anc_00020"
        ]
      },
      {
        "term": "Model Re-parameterization",
        "definition": "模型重参数化，在推理阶段将多个计算模块合并为一个，以提升推理效率。",
        "anchors": [
          "anc_00006",
          "anc_00012",
          "anc_00027",
          "anc_00028"
        ]
      },
      {
        "term": "Dynamic Label Assignment",
        "definition": "动态标签分配，根据模型预测动态分配训练目标，用于处理多输出层模型。",
        "anchors": [
          "anc_00006",
          "anc_00007",
          "anc_00008",
          "anc_00009",
          "anc_00029",
          "anc_00030",
          "anc_00031",
          "anc_00032"
        ]
      },
      {
        "term": "Coarse-to-Fine Lead Guided Label Assignment",
        "definition": "粗到细引导标签分配，使用主头预测和真值生成粗标签（用于辅助头）和细标签（用于主头），优化训练。",
        "anchors": [
          "anc_00029",
          "anc_00030",
          "anc_00031",
          "anc_00032",
          "anc_00033",
          "anc_00034",
          "anc_00035",
          "anc_00036"
        ]
      },
      {
        "term": "Compound Scaling",
        "definition": "复合缩放，同时缩放模型的深度和宽度，以实现更好的速度-精度权衡。",
        "anchors": [
          "anc_00023",
          "anc_00024",
          "anc_00025",
          "anc_00026",
          "anc_00052",
          "anc_00053",
          "anc_00054",
          "anc_00055",
          "anc_00056",
          "anc_00057",
          "anc_00058"
        ]
      },
      {
        "term": "Partial Auxiliary Head",
        "definition": "部分辅助头，连接到E-ELAN中合并基数前的一组特征图，以弥补下一级金字塔预测可能丢失的信息。",
        "anchors": [
          "anc_00096",
          "anc_00097",
          "anc_00098",
          "anc_00100"
        ]
      },
      {
        "term": "EMA (Exponential Moving Average) Model",
        "definition": "指数移动平均模型，在训练过程中维护模型参数的移动平均，用于最终推理以提升稳定性。",
        "anchors": [
          "anc_00043"
        ]
      }
    ]
  },
