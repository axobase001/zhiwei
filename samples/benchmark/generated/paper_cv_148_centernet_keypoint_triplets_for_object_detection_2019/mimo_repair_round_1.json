  "glossary": {
    "terms": [
      {
        "term": "CenterNet",
        "definition": "本文提出的目标检测方法，使用关键点三元组（一个中心关键点和一对角点）表示物体。",
        "anchors": [
          "anc_00001",
          "anc_00009"
        ],
        "appears_in": [
          "anc_00001",
          "anc_00009"
        ]
      },
      {
        "term": "CornerNet",
        "definition": "一种基于关键点的单阶段目标检测器，使用一对角点表示物体。本文的基线方法。",
        "anchors": [
          "anc_00009",
          "anc_00015"
        ],
        "appears_in": [
          "anc_00009",
          "anc_00015"
        ]
      },
      {
        "term": "关键点三元组 (Keypoint Triplets)",
        "definition": "表示一个物体的三个关键点：一个中心关键点和一对角点（左上角和右下角）。",
        "anchors": [
          "anc_00009",
          "anc_00018"
        ],
        "appears_in": [
          "anc_00009",
          "anc_00018"
        ]
      },
      {
        "term": "中心池化 (Center Pooling)",
        "definition": "一种池化操作，通过取水平方向和垂直方向的最大响应值之和来增强中心关键点的特征。",
        "anchors": [
          "anc_00018",
          "anc_00076"
        ],
        "appears_in": [
          "anc_00018",
          "anc_00076"
        ]
      },
      {
        "term": "级联角点池化 (Cascade Corner Pooling)",
        "definition": "一种改进的角点池化操作，首先在边界方向找最大值，然后沿该位置向内部方向找最大值并相加，以增强角点对内部信息的感知。",
        "anchors": [
          "anc_00020",
          "anc_00080",
          "anc_00083",
          "anc_00084",
          "anc_00085"
        ],
        "appears_in": [
          "anc_00020",
          "anc_00080",
          "anc_00083",
          "anc_00084",
          "anc_00085"
        ]
      },
      {
        "term": "中心区域 (Central Region)",
        "definition": "边界框内部靠近几何中心的一个区域，其尺度由参数n决定。用于检查是否存在中心关键点。",
        "anchors": [
          "anc_00057",
          "anc_00059",
          "anc_00061",
          "anc_00063",
          "anc_00067"
        ],
        "appears_in": [
          "anc_00057",
          "anc_00059",
          "anc_00061",
          "anc_00063",
          "anc_00067"
        ]
