{
  "paper_skeleton": {
    "problem": {
      "summary": "从单张图像中识别人脸，面临由位置、大小、表情和姿态变化引起的图像差异问题。",
      "anchors": [
        "anc_00007",
        "anc_00008",
        "anc_00010"
      ]
    },
    "motivation": {
      "summary": "需要一种能够处理图像变化并强调判别特征的系统，以在仅有一张每人图像的大型数据库中进行人脸识别。",
      "anchors": [
        "anc_00010",
        "anc_00011",
        "anc_00012",
        "anc_00013"
      ]
    },
    "core_idea": {
      "summary": "使用基于Gabor小波变换的标记图（labeled graphs）表示人脸，通过弹性图匹配（elastic graph matching）提取图像图，并利用新颖的束图（bunch graph）数据结构来处理面部变化。",
      "anchors": [
        "anc_00018",
        "anc_00026",
        "anc_00028",
        "anc_00031"
      ]
    },
    "method": {
      "summary": "系统包括三个关键改进：1) 使用相位信息进行精确节点定位；2) 使用对象自适应图处理深度旋转；3) 基于束图的图像图提取。束图由少量样本图像图构建，用于匹配新图像并生成图像图，然后通过简单的相似性函数进行比较。",
      "anchors": [
        "anc_00026",
        "anc_00027",
        "anc_00028",
        "anc_00030",
        "anc_00031",
        "anc_00032",
        "anc_00033",
        "anc_00034",
        "anc_00035",
        "anc_00036"
      ]
    },
    "experiments": {
      "summary": "在FERET数据库和Bochum数据库上进行了识别实验，包括跨姿态识别。结果表明，系统在正面视图识别中表现优异（98%），在跨姿态识别中也有一定效果（如右轮廓对左轮廓84%）。",
      "anchors": [
        "anc_00175",
        "anc_00177",
        "anc_00181",
