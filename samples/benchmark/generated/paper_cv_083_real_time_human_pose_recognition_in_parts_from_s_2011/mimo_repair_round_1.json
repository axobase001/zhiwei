        "formula_id": "formula_001",
        "formula": "f_\\theta(I, x) = d_I\\left(x + \\frac{u}{d_I(x)}\\right) - d_I\\left(x + \\frac{v}{d_I(x)}\\right)",
        "variables": [
          {
            "name": "f_\\theta(I, x)",
            "description": "在图像I中像素x处的深度比较特征值",
            "confidence": "high",
