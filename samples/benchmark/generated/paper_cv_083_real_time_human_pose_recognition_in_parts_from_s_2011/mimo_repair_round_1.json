{
  "paper_skeleton": {
    "problem": {
      "summary": "从单张深度图像中实时、准确地预测人体关节的3D位置，无需时序信息。现有系统在交互速率、处理全范围人体形状和尺寸、以及快速重新初始化方面存在局限。",
      "anchors": [
        "anc_00003",
        "anc_00005",
        "anc_00007"
      ]
    },
    "motivation": {
      "summary": "深度相机的出现简化了任务，但现有系统仍有限制。需要一种能在消费级硬件上实时运行、对各种体型和动作鲁棒的方法，以支持游戏、人机交互等应用。",
      "anchors": [
        "anc_00007",
        "anc_00009"
      ]
    },
    "core_idea": {
      "summary": "将姿态估计问题转化为物体识别问题，设计一个中间身体部位表示，将困难的姿态估计问题转化为更简单的逐像素分类问题。通过随机决策森林分类器进行身体部位识别，然后通过均值漂移找到局部模式来生成关节位置提案。",
      "anchors": [
        "anc_00003",
        "anc_00009",
        "anc_00011",
        "anc_00052",
        "anc_00054"
      ]
    },
    "method": {
      "summary": "1. 使用运动捕捉数据合成大量带标签的深度图像和身体部位图像作为训练数据。2. 使用深度比较特征（公式1）进行3D平移不变的特征提取。3. 训练随机决策森林分类器（公式2-6）对每个像素进行身体部位分类。4. 对分类结果进行重投影，使用均值漂移（公式8）找到每个身体部位分布的局部模式，生成置信度加权的3D关节位置提案。",
      "anchors": [
