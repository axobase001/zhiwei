          "anc_00081",
          "anc_00083",
          "anc_00084",
          "anc_00085",
          "anc_00086",
          "anc_00091"
        ]
      },
      {
        "node_id": "node_004",
        "title": "逐像素身体部位分类",
        "label": "推理",
        "summary": "在推理时，使用训练好的森林对输入深度图像的每个像素进行身体部位概率分类。",
        "description": "对于像素x，分类概率P(c|I, x)是所有树预测的平均值（公式2）。该过程可在GPU上并行执行。",
        "type": "inference",
        "anchors": [
          "anc_00072",
          "anc_00073"
        ]
      },
      {
        "node_id": "node_005",
        "title": "关节位置提案生成",
        "label": "后处理",
        "summary": "将分类结果重投影到3D世界空间，使用均值漂移找到每个身体部位分布的局部模式，生成置信度加权的关节位置提案。",
        "description": "对每个身体部位c，计算加权密度（公式8），其中权重wic = P(c|I, xi) * dI(xi)^2。使用均值漂移找到模式，置信度为达到该模式的像素权重之和。",
        "type": "post_processing",
        "anchors": [
          "anc_00091",
          "anc_00092",
          "anc_00093"
        ]
      }
    ],
