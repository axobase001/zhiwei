  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "合成训练数据生成",
        "label": "数据准备",
        "summary": "使用运动捕捉数据和随机渲染管线生成大量带标签的深度图像和身体部位图像，作为训练数据。",
        "description": "从运动捕捉数据库中采样姿态，将其重定向到15个基础网格以覆盖不同体型，并随机化相机姿态、噪声、服装等参数，生成合成深度图像和对应的身体部位标签图像。",
        "type": "data_preparation",
        "anchors": [
          "anc_00042",
          "anc_00043",
          "anc_00044",
          "anc_00048",
          "anc_00049",
          "anc_00050"
        ]
      },
      {
        "node_id": "node_002",
        "title": "深度图像特征提取",
        "label": "特征工程",
        "summary": "使用深度比较特征，通过归一化偏移实现3D平移不变性，计算高效。",
        "description": "对于像素x，特征fθ(I, x) = dI(x + u/dI(x)) - dI(x + v/dI(x))，其中dI(x)是深度，θ=(u,v)是偏移参数。偏移除以深度确保特征深度不变。",
        "type": "feature_extraction",
        "anchors": [
          "anc_00059",
          "anc_00060",
          "anc_00061",
          "anc_00062",
          "anc_00063",
          "anc_00064",
          "anc_00065",
          "anc_00066",
          "anc_00067"
        ]
      },
      {
        "node_id": "node_003",
        "title": "随机决策森林分类器训练",
        "label": "模型训练",
        "summary": "训练一个由多棵决策树组成的随机森林分类器，用于对每个像素进行身体部位分类。",
        "description": "森林由T棵树组成。每棵树通过随机选择特征和阈值进行训练，使用信息增益（公式6）选择最佳分裂。训练在分布式集群上进行。",
        "type": "model_training",
        "anchors": [
          "anc_00071",
          "anc_00072",
          "anc_00073",
          "anc_00074",
          "anc_00076",
          "anc_00078",
          "anc_00079",
