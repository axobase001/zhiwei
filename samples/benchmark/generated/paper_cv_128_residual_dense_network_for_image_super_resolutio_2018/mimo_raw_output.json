  "glossary": {
    "terms": [
      {
        "term": "残差密集网络 (RDN)",
        "definition": "提出的深度网络，用于图像超分辨率，通过残差密集块提取和融合层次化特征。",
        "anchors": [
          "anc_00003",
          "anc_00011"
        ]
      },
      {
        "term": "残差密集块 (RDB)",
        "definition": "RDN的基本构建块，包含密集连接卷积层、局部特征融合和局部残差学习。",
        "anchors": [
          "anc_00003",
          "anc_00022",
          "anc_00023",
          "anc_00024"
        ]
      },
      {
        "term": "连续记忆机制 (CM)",
        "definition": "RDB中允许前一个RDB状态直接连接到当前所有层的机制，增强特征传递。",
        "anchors": [
          "anc_00024",
          "anc_00040",
          "anc_00041"
        ]
      },
      {
        "term": "局部特征融合 (LFF)",
        "definition": "RDB内使用1×1卷积自适应融合前一个RDB和当前所有层特征的操作。",
        "anchors": [
          "anc_00027",
          "anc_00028",
          "anc_00029",
          "anc_00042"
        ]
      },
      {
        "term": "局部残差学习 (LRL)",
        "definition": "RDB内将输入与局部特征融合输出相加的残差连接。",
        "anchors": [
          "anc_00031",
          "anc_00032",
          "anc_00042"
        ]
      },
      {
        "term": "密集特征融合 (DFF)",
        "definition": "包括全局特征融合和全局残差学习，用于融合所有RDB的层次化特征。",
        "anchors": [
          "anc_00033",
          "anc_00034",
          "anc_00035",
          "anc_00036",
          "anc_00037"
        ]
      },
      {
        "term": "全局特征融合 (GFF)",
        "definition": "使用1×1和3×3卷积融合所有RDB输出特征的操作。",
        "anchors": [
          "anc_00034",
          "anc_00035",
          "anc_00042"
        ]
      },
      {
        "term": "全局残差学习 (GRL)",
        "definition": "将浅层特征与全局特征融合输出相加的操作。",
        "anchors": [
          "anc_00036",
          "anc_00037"
        ]
      },
      {
        "term": "增长率 (G)",
        "definition": "RDB中每个卷积层输出的特征图数量。",
        "anchors": [
          "anc_00026",
          "anc_00042",
          "anc_00054",
          "anc_00055"
        ]
      },
      {
        "term": "退化模型",
        "definition": "模拟低分辨率图像的方法，包括BI（双三次下采样）、BD（高斯模糊+下采样）、DN（噪声+下采样）。",
        "anchors": [
          "anc_00044"
        ]
      }
    ]
  },
