          "anc_00034",
          "anc_00035",
          "anc_00036",
          "anc_00037"
        ]
      },
      {
        "node_id": "node_004",
        "title": "上采样网络 (UPNet)",
        "label": "UPNet",
        "summary": "将低分辨率空间特征上采样到高分辨率空间，生成最终超分辨率图像。",
        "description": "UPNet使用ESPCN进行上采样，后接一个卷积层输出3通道彩色图像。",
        "type": "upsampling",
        "anchors": [
          "anc_00020",
          "anc_00039"
        ]
      },
      {
        "node_id": "node_005",
        "title": "连续记忆机制 (CM)",
        "label": "CM",
        "summary": "允许前一个RDB的状态直接连接到当前RDB的所有层，增强特征传递。",
        "description": "通过将前一个RDB的输出F_{d-1}与当前RDB各层输出拼接，实现连续记忆。",
        "type": "mechanism",
        "anchors": [
          "anc_00024",
