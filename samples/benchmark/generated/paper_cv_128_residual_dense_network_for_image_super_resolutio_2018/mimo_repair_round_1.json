{
  "paper_skeleton": {
    "problem": {
      "summary": "现有深度CNN超分辨率模型未能充分利用原始低分辨率图像的层次化特征，导致性能相对较低。",
      "anchors": [
        "anc_00003"
      ]
    },
    "motivation": {
      "summary": "层次化特征对图像恢复任务（如超分辨率）非常有用，但现有方法（如SRDenseNet、MemNet）在特征提取和融合上存在局限，未能完全利用所有卷积层的特征。",
      "anchors": [
        "anc_00003",
        "anc_00008"
      ]
    },
    "core_idea": {
      "summary": "提出残差密集网络（RDN），通过残差密集块（RDB）提取丰富的局部特征，并利用密集特征融合（DFF）自适应地学习全局层次化特征，从而充分利用所有卷积层的特征。",
      "anchors": [
        "anc_00003",
        "anc_00011"
      ]
    },
    "method": {
      "summary": "RDN由浅层特征提取网络（SFENet）、多个残差密集块（RDBs）、密集特征融合（DFF）和上采样网络（UPNet）组成。RDB包含密集连接层、局部特征融合（LFF）和局部残差学习（LRL），实现连续记忆（CM）机制。DFF包括全局特征融合（GFF）和全局残差学习（GRL）。",
      "anchors": [
        "anc_00011",
        "anc_00022",
        "anc_00023",
        "anc_00024",
        "anc_00033",
        "anc_00034",
        "anc_00035",
        "anc_00036",
        "anc_00037"
      ]
    },
    "experiments": {
      "summary": "在多个基准数据集（Set5、Set14、B100、Urban100、Manga109）上，使用三种退化模型（BI、BD、DN）进行实验，与多种先进方法（SRCNN、LapSRN、DRRN、SRDenseNet、MemNet、MDSR等）比较，通过PSNR/SSIM指标评估性能。",
      "anchors": [
        "anc_00044",
        "anc_00066",
        "anc_00070",
        "anc_00071",
        "anc_00079",
        "anc_00080",
        "anc_00086",
        "anc_00087"
      ]
    },
