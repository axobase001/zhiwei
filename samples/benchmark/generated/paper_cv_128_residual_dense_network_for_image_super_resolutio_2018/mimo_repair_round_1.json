  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "浅层特征提取网络 (SFENet)",
        "label": "SFENet",
        "summary": "从输入低分辨率图像中提取浅层特征，为后续RDB提供输入。",
        "description": "SFENet包含两个卷积层：第一层提取特征F_{-1}，第二层进一步提取特征F_0作为RDB的输入。",
        "type": "feature_extraction",
        "anchors": [
          "anc_00011",
          "anc_00012",
          "anc_00013",
          "anc_00014"
        ]
      },
      {
        "node_id": "node_002",
        "title": "残差密集块 (RDB)",
        "label": "RDB",
        "summary": "通过密集连接卷积层提取局部特征，并利用连续记忆机制和局部残差学习增强信息流。",
        "description": "RDB包含C个密集连接的卷积层，每层输出G个特征图。通过局部特征融合（LFF）自适应融合特征，并利用局部残差学习（LRL）输出最终特征F_d。",
        "type": "building_block",
        "anchors": [
          "anc_00022",
