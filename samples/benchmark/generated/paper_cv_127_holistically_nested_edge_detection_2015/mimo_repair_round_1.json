          "anc_00043"
        ]
      },
      {
        "formula_id": "formula_002",
        "formula": "\\ell_{side}^{(m)}(W, w^{(m)}) = -\\beta \\sum_{j \\in Y^+} \\log \\Pr(y_j=1|X; W, w^{(m)}) - (1-\\beta) \\sum_{j \\in Y^-} \\log \\Pr(y_j=0|X; W, w^{(m)})",
        "variables": [
          {
            "name": "\\beta",
            "description": "类平衡权重，\\beta = |Y^-|/|Y|",
            "confidence": "high",
            "anchors": [
