        "anc_00048",
        "anc_00049",
        "anc_00050"
      ]
    },
    "experiments": {
      "summary": "在MOT基准数据集上进行评估，使用FrRCNN(VGG16)检测器。评估指标包括MOTA、MOTP、FP、FN、ID sw、Frag等。与多种在线和批处理跟踪器进行比较。",
      "anchors": [
        "anc_00051",
        "anc_00053",
        "anc_00054",
        "anc_00055",
        "anc_00056",
        "anc_00062"
      ]
    },
    "claims": [
      {
        "claim_id": "claim_1",
        "claim": "检测质量是影响跟踪性能的关键因素，更换检测器可提升跟踪性能高达18.9%。",
        "anchors": [
          "anc_00004",
          "anc_00018"
        ]
      },
      {
        "claim_id": "claim_2",
        "claim": "尽管使用简单的技术组合，SORT的精度可与最先进的在线跟踪器相媲美。",
        "anchors": [
          "anc_00004",
          "anc_00056",
          "anc_00062"
        ]
      },
      {
        "claim_id": "claim_3",
        "claim": "由于方法的简单性，SORT的更新速率可达260 Hz，比其他先进跟踪器快20倍以上。",
        "anchors": [
          "anc_00004",
          "anc_00062"
        ]
      },
      {
        "claim_id": "claim_4",
