  "glossary": {
    "terms": [
      {
        "term": "神经机器翻译 (Neural Machine Translation, NMT)",
        "definition": "一种完全基于神经网络的统计机器翻译方法，通常由编码器和解码器组成。",
        "anchors": [
          "anc_00005",
          "anc_00007"
        ],
        "appears_in": [
          "anc_00005",
          "anc_00007"
        ]
      },
      {
        "term": "编码器-解码器架构 (Encoder-Decoder Architecture)",
        "definition": "一种神经网络架构，编码器将输入序列压缩为固定长度向量，解码器基于该向量生成输出序列。",
        "anchors": [
          "anc_00005",
          "anc_00059",
          "anc_00060",
          "anc_00070"
        ],
        "appears_in": [
          "anc_00005",
          "anc_00059",
          "anc_00060",
          "anc_00070"
        ]
      },
      {
        "term": "RNN编码器-解码器 (RNN Encoder-Decoder, RNNenc)",
        "definition": "一种具体的编码器-解码器模型，其中编码器和解码器均为循环神经网络（RNN）。",
        "anchors": [
          "anc_00015",
          "anc_00080"
        ],
        "appears_in": [
          "anc_00015",
          "anc_00080"
        ]
      },
      {
