  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "深度卷积神经网络（DNN）架构",
        "label": "DNN Architecture",
        "summary": "构建深度卷积神经网络，使用小卷积核和最大池化层，实现类似哺乳动物视觉皮层的层次结构。",
        "description": "DNN由多个卷积层、最大池化层和全连接层堆叠而成。卷积层使用小卷积核（如2x2、3x3），最大池化层通过局部抑制选择获胜神经元，实现下采样。网络深度可达6-10层，顶层为标准多层感知器（MLP）。",
        "type": "architecture",
        "anchors": [
          "anc_00012",
          "anc_00013",
          "anc_00014",
          "anc_00015",
          "anc_00016",
          "anc_00017",
          "anc_00018",
          "anc_00019",
          "anc_00020",
          "anc_00021"
        ]
      },
      {
        "node_id": "node_002",
        "title": "获胜神经元训练",
        "label": "Winner-Take-All Training",
        "summary": "仅训练获胜神经元，减少突触变化，降低能耗，符合生物合理性。",
        "description": "在最大池化层中，只有获胜神经元（即局部区域内最活跃的神经元）被训练，其他神经元不更新权重。这减少了权重更新次数，降低了能量消耗，并防止非获胜神经元遗忘已学知识。",
        "type": "training_mechanism",
        "anchors": [
          "anc_00022",
          "anc_00023"
        ]
      },
      {
        "node_id": "node_003",
        "title": "多列DNN（MCDNN）集成",
        "label": "Multi-column DNN Ensemble",
        "summary": "组合多个DNN列，每列处理不同预处理输入，通过平均预测提升性能。",
        "description": "MCDNN由多个DNN列组成，每列可以独立训练在相同或不同预处理的输入上。在测试时，对所有列的预测进行民主平均，得到最终分类结果。这类似于大脑皮层微柱结构。",
        "type": "ensemble_method",
        "anchors": [
          "anc_00024",
          "anc_00030",
          "anc_00031"
        ]
      },
      {
        "node_id": "node_004",
        "title": "数据增强与预处理",
        "label": "Data Augmentation and Preprocessing",
        "summary": "通过平移、缩放、旋转、弹性变形等增强训练数据，并使用多种预处理方法生成不同输入视图。",
        "description": "训练时，图像在每个epoch前进行随机平移、缩放、旋转和弹性变形（针对字符）。此外，使用多种预处理方法（如直方图均衡化、自适应直方图均衡化、对比度归一化）生成不同输入，用于训练不同DNN列。",
        "type": "data_processing",
        "anchors": [
          "anc_00035",
          "anc_00039",
          "anc_00040",
          "anc_00041",
          "anc_00065",
          "anc_00070",
          "anc_00124",
          "anc_00125",
          "anc_00128"
        ]
      },
      {
        "node_id": "node_005",
        "title": "在线梯度下降训练",
        "label": "Online Gradient Descent Training",
        "summary": "使用在线梯度下降和退火学习率训练DNN，权重随机初始化。",
        "description": "DNN使用在线梯度下降训练，即每个样本后更新权重。学习率从初始值（如0.001）按因子（如0.993/epoch）退火，直到达到最小值（如0.00003）。权重从均匀随机分布初始化。",
        "type": "optimization",
        "anchors": [
          "anc_00035",
          "anc_00036",
          "anc_00040"
        ]
      },
      {
        "node_id": "node_006",
        "title": "GPU加速训练",
        "label": "GPU-Accelerated Training",
        "summary": "利用图形处理器（GPU）实现快速训练，处理大规模数据集。",
        "description": "GPU实现使得大规模深度网络训练可行，例如在中文字符数据集上，CPU训练需数天，而GPU训练大幅缩短时间。",
        "type": "implementation",
        "anchors": [
          "anc_00008",
          "anc_00061"
        ]
      }
    ],
