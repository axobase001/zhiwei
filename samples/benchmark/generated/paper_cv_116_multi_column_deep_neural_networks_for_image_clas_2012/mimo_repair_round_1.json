      ]
    },
    "experiments": {
      "summary": "在MNIST手写数字、NIST SD 19拉丁字符、CASIA中文字符、GTSRB交通标志、CIFAR10自然图像和NORB 3D玩具等多个基准数据集上进行实验，评估MCDNN的分类错误率，并与现有最佳方法比较。",
      "anchors": [
