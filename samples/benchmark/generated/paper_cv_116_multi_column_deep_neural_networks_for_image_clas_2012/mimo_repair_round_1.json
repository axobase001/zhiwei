  "glossary": {
    "MCDNN": "多列深度神经网络，由多个DNN列组成，每列处理不同预处理输入，预测平均。",
    "DNN": "深度神经网络，本文特指深度卷积神经网络。",
    "Winner-Take-All": "获胜者全得，指最大池化中仅获胜神经元被训练的机制。",
    "Max Pooling": "最大池化，通过局部区域选择最大激活值实现下采样。",
    "Data Augmentation": "数据增强，通过变换（如平移、旋转）增加训练数据多样性。",
    "Preprocessing": "预处理，如直方图均衡化、对比度归一化，用于生成不同输入视图。",
    "Online Gradient Descent": "在线梯度下降，每个样本后更新权重。",
    "Annealed Learning Rate": "退火学习率，学习率随训练逐渐减小。",
    "GPU": "图形处理器，用于加速矩阵运算和网络训练。",
    "Confusion Matrix": "混淆矩阵，显示分类错误分布。",
    "terms": []
  },
