{
  "paper_skeleton": {
    "problem": {
      "summary": "传统计算机视觉和机器学习方法在手写数字识别、交通标志识别等任务上无法达到人类水平性能。",
      "anchors": [
        "anc_00004",
        "anc_00005",
        "anc_00006",
        "anc_00007"
      ]
    },
    "motivation": {
      "summary": "受生物视觉系统启发，通过构建深度、宽的卷积神经网络架构来提升图像分类性能，特别是利用多列DNN（MCDNN）集成不同预处理输入的预测。",
      "anchors": [
        "anc_00008",
        "anc_00024"
      ]
    },
    "core_idea": {
      "summary": "提出多列深度神经网络（MCDNN），每列DNN是深度卷积网络，使用小感受野和最大池化实现深度结构，仅训练获胜神经元；多列DNN对不同预处理输入的预测进行平均，以提升分类准确性和鲁棒性。",
      "anchors": [
        "anc_00008",
        "anc_00014",
        "anc_00015",
        "anc_00016",
        "anc_00020",
        "anc_00021",
        "anc_00022",
        "anc_00024"
      ]
    },
    "method": {
      "summary": "构建深度卷积神经网络（DNN）架构，使用小卷积核和最大池化层；采用在线梯度下降训练，仅更新获胜神经元的权重；通过数据增强（平移、缩放、旋转、弹性变形）和多种预处理（如直方图均衡化、对比度归一化）生成不同输入；组合多个DNN列形成MCDNN，对各列预测进行民主平均。",
      "anchors": [
        "anc_00014",
        "anc_00015",
        "anc_00016",
        "anc_00020",
        "anc_00021",
        "anc_00022",
        "anc_00024",
