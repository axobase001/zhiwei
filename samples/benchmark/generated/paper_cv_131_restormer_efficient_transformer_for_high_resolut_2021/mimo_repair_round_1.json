{
  "paper_skeleton": {
    "problem": {
      "summary": "图像恢复任务（如去雨、去模糊、去噪）需要处理高分辨率图像，但传统Transformer模型的自注意力机制计算复杂度随空间分辨率呈二次增长，导致其难以应用于高分辨率图像恢复。",
      "anchors": [
        "anc_00005",
        "anc_00006",
        "anc_00007",
        "anc_00008",
        "anc_00009",
        "anc_00010",
        "anc_00011",
        "anc_00012",
        "anc_00013",
        "anc_00014",
        "anc_00015",
        "anc_00016",
        "anc_00017",
        "anc_00018"
      ]
    },
    "motivation": {
      "summary": "CNN具有局部感受野和静态权重的局限性，而Transformer虽能建模长距离依赖但计算成本过高。需要一种高效的Transformer架构，既能捕获全局上下文，又能适用于大尺寸图像。",
      "anchors": [
        "anc_00005",
        "anc_00006",
        "anc_00007",
        "anc_00008",
        "anc_00009",
        "anc_00010",
        "anc_00011",
