        "anc_00013",
        "anc_00014",
        "anc_00015",
        "anc_00016",
        "anc_00017",
        "anc_00018"
      ]
    },
    "core_idea": {
      "summary": "提出Restormer，一种高效的编码器-解码器Transformer模型，通过多Dconv头转置注意力（MDTA）和门控Dconv前馈网络（GDFN）两个关键设计，在保持线性计算复杂度的同时建模全局像素交互。",
      "anchors": [
        "anc_00018",
        "anc_00026",
        "anc_00027",
        "anc_00028",
        "anc_00029",
        "anc_00030",
        "anc_00031",
        "anc_00043",
        "anc_00044",
        "anc_00045"
      ]
    },
    "method": {
      "summary": "1. MDTA：在特征通道维度而非空间维度计算自注意力，通过深度卷积增强局部上下文，实现线性复杂度。2. GDFN：引入门控机制和深度卷积，控制信息流动以增强特征变换。3. 渐进式学习：训练时从小尺寸图像块逐步增加到大尺寸图像块，提升模型对不同分辨率的泛化能力。",
      "anchors": [
