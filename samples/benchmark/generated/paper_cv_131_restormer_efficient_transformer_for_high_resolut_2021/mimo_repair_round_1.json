  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "整体架构",
        "label": "Restormer编码器-解码器",
        "summary": "Restormer采用多尺度层次化设计，包含编码器、解码器和细化阶段，通过跳跃连接融合多尺度特征。",
        "description": "模型接收退化图像I，输出残差R，最终恢复图像为I+R。编码器逐步下采样，解码器逐步上采样，中间通过Transformer块处理特征。",
        "type": "architecture",
        "anchors": [
          "anc_00026",
          "anc_00027",
          "anc_00029"
        ]
      },
      {
        "node_id": "node_002",
        "title": "多Dconv头转置注意力",
        "label": "MDTA",
        "summary": "MDTA在特征通道维度计算自注意力，实现线性复杂度，并通过深度卷积融合局部上下文。",
        "description": "从层归一化特征Y生成查询Q、键K、值V，通过1x1点卷积和3x3深度卷积增强局部上下文。将Q和K重塑后计算转置注意力图A（尺寸为C×C），而非空间注意力图（HW×HW）。注意力计算为V·Softmax(K^T·Q/α)。α为可学习缩放参数。",
        "type": "module",
        "anchors": [
          "anc_00031",
          "anc_00032",
          "anc_00033",
          "anc_00034",
          "anc_00035",
          "anc_00036",
          "anc_00037",
          "anc_00038",
          "anc_00039",
          "anc_00040",
          "anc_00041",
          "anc_00042",
          "anc_00043"
        ]
      },
      {
        "node_id": "node_003",
        "title": "门控Dconv前馈网络",
        "label": "GDFN",
        "summary": "GDFN通过门控机制和深度卷积控制信息流动，增强特征变换能力。",
        "description": "GDFN包含两个并行路径：一条经过GELU激活，另一条不激活，两者逐元素相乘实现门控。公式为：Gating(X) = φ(W1d W1p (LN(X))) ⊙ W2d W2p (LN(X))。输出为W0p Gating(X) + X。深度卷积用于编码局部空间信息。",
        "type": "module",
        "anchors": [
          "anc_00044",
          "anc_00045",
          "anc_00046",
          "anc_00047",
          "anc_00048",
          "anc_00049"
        ]
      },
      {
        "node_id": "node_004",
        "title": "渐进式学习策略",
        "label": "Progressive Learning",
        "summary": "训练时从小图像块和大批次开始，逐步增加图像块尺寸并减小批次大小，以学习大图像上下文。",
        "description": "训练初期使用128×128图像块和批次大小64，随后在指定迭代次数更新为更大的图像块和更小的批次（如160²/40, 192²/32, 256²/16, 320²/8, 384²/8）。这有助于模型在测试时处理不同分辨率的图像。",
        "type": "training_strategy",
        "anchors": [
          "anc_00019",
          "anc_00020",
          "anc_00021",
          "anc_00022",
          "anc_00050",
          "anc_00051",
          "anc_00052",
          "anc_00053"
        ]
      },
      {
        "node_id": "node_005",
        "title": "损失函数与优化",
        "label": "Training Details",
        "summary": "使用L1损失和AdamW优化器，配合余弦退火学习率调度。",
        "description": "损失函数为L1损失。优化器为AdamW（β1=0.9, β2=0.999, 权重衰减1e-4）。训练300K次迭代，初始学习率3e-4，余弦退火至1e-6。数据增强包括水平和垂直翻转。",
        "type": "training_details",
        "anchors": [
          "anc_00059",
          "anc_00060",
          "anc_00061"
        ]
      }
    ],
