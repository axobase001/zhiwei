{
  "paper_skeleton": {
    "problem": {
      "summary": "现有自动驾驶数据集主要基于图像，缺乏包含完整传感器套件（摄像头、激光雷达、雷达）的大规模多模态数据集，限制了基于机器学习的3D目标检测和跟踪方法的发展。",
      "anchors": [
        "anc_00005",
        "anc_00013"
      ]
    },
    "motivation": {
      "summary": "自动驾驶车辆通常配备摄像头和测距传感器（激光雷达、雷达）。随着基于机器学习的检测和跟踪方法日益普及，需要在包含测距传感器数据和图像的数据集上训练和评估这些方法。",
      "anchors": [
        "anc_00005",
        "anc_00013"
      ]
    },
    "core_idea": {
      "summary": "发布nuScenes数据集，这是首个包含完整自动驾驶传感器套件（6个摄像头、5个雷达、1个激光雷达，均具有360度视场）的大规模多模态数据集，并定义新的3D检测和跟踪评估指标。",
      "anchors": [
        "anc_00005",
        "anc_00013",
        "anc_00057",
        "anc_00058",
        "anc_00060"
      ]
    },
    "method": {
      "summary": "数据集收集：在波士顿和新加坡使用两辆配备相同传感器布局的电动汽车驾驶，手动选择1000个20秒的场景。数据标注：为23个类别提供3D边界框标注和8个属性。评估指标：提出nuScenes检测分数（NDS）和平均多目标跟踪精度（sAMOTA）等新指标。基线方法：提供基于激光雷达（PointPillars）和图像（OFT）的检测与跟踪基线。",
      "anchors": [
