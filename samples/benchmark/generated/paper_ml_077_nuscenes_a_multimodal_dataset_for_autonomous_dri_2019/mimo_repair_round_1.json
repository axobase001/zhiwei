  "formula_ir": {
    "formulas": [
      {
        "formula_id": "formula_001",
        "formula": "mAP = \\frac{1}{|C||D|} \\sum_{c \\in C} \\sum_{d \\in D} AP_{c,d}",
        "variables": [
          {
            "name": "C",
            "description": "类别集合",
            "confidence": "high",
            "anchors": [
              "anc_00051"
            ]
          },
          {
            "name": "D",
            "description": "中心距离阈值集合，例如{0.5, 1, 2, 4}米",
            "confidence": "high",
            "anchors": [
              "anc_00051"
            ]
          },
          {
            "name": "AP_{c,d}",
            "description": "在类别c和距离阈值d下的平均精度",
            "confidence": "high",
            "anchors": [
              "anc_00052"
            ]
          }
        ],
        "dependencies": [],
        "intuition": "通过在不同中心距离阈值下计算各类别的平均精度，然后取平均，得到对位置误差更鲁棒的检测性能评估。",
        "anchors": [
          "anc_00051",
          "anc_00052"
        ]
      },
      {
        "formula_id": "formula_002",
        "formula": "NDS = \\frac{1}{10} [5 \\cdot mAP + \\sum_{TP \\in \\{mATE, mASE, mAOE, mAVE, mAAE\\}} (1 - \\min(1, TP))]",
        "variables": [
          {
            "name": "mAP",
            "description": "平均精度",
            "confidence": "high",
            "anchors": [
              "anc_00057"
            ]
          },
          {
            "name": "mATE",
            "description": "平均平移误差（米）",
            "confidence": "high",
            "anchors": [
              "anc_00054"
            ]
          },
          {
            "name": "mASE",
            "description": "平均尺度误差（1-IOU）",
            "confidence": "high",
            "anchors": [
              "anc_00054"
            ]
          },
          {
            "name": "mAOE",
            "description": "平均方向误差（弧度）",
            "confidence": "high",
            "anchors": [
              "anc_00054"
            ]
          },
          {
            "name": "mAVE",
            "description": "平均速度误差（米/秒）",
            "confidence": "high",
            "anchors": [
              "anc_00054"
            ]
          },
          {
            "name": "mAAE",
            "description": "平均属性误差（1-准确率）",
            "confidence": "high",
            "anchors": [
              "anc_00055"
            ]
          }
        ],
        "dependencies": [],
        "intuition": "将检测性能的不同方面（精度、位置、大小、方向、速度、属性）综合成一个分数，便于比较不同方法。",
        "anchors": [
