{
  "paper_skeleton": {
    "problem": {
      "summary": "传统GAN生成器架构将潜在码直接输入输入层，导致潜在空间中的变化因素不可避免地纠缠，且难以实现对生成图像的高分辨率细节和全局属性的独立控制。",
      "anchors": [
        "anc_00005",
        "anc_00007"
      ]
    },
    "motivation": {
      "summary": "借鉴风格迁移文献，提出一种新的生成器架构，以实现对生成图像的高层属性（如姿态、身份）和随机变化（如雀斑、头发）的自动、无监督分离，并实现直观的、尺度特定的控制。",
      "anchors": [
        "anc_00003",
        "anc_00010"
      ]
    },
    "core_idea": {
      "summary": "将输入潜在码映射到一个中间潜在空间W，该空间不受训练数据概率密度的限制，从而允许更解耦的表示。通过自适应实例归一化（AdaIN）将W中的风格注入合成网络的每一层，并通过显式噪声输入提供随机细节。",
      "anchors": [
        "anc_00005",
        "anc_00007",
        "anc_00010",
        "anc_00012",
        "anc_00018"
      ]
    },
    "method": {
      "summary": "提出基于风格的生成器架构，包含映射网络f和合成网络g。映射网络将输入潜在码z映射到中间潜在空间w。合成网络通过AdaIN操作在每一卷积层后注入风格y，并通过添加高斯噪声输入提供随机变化。引入混合正则化以提高风格的局部化。",
      "anchors": [
        "anc_00010",
        "anc_00012",
        "anc_00018",
        "anc_00034",
        "anc_00036"
      ]
    },
    "experiments": {
      "summary": "在CelebA-HQ、FFHQ、LSUN BEDROOM、LSUN CAR等数据集上进行实验。使用Fréchet起始距离（FID）评估生成质量。提出感知路径长度和线性可分性两个新指标来量化插值质量和解耦程度。进行消融研究（Table 1）和混合正则化测试（Table 2）。",
      "anchors": [
        "anc_00016",
        "anc_00017",
        "anc_00019",
        "anc_00020",
        "anc_00064",
        "anc_00065",
        "anc_00066",
        "anc_00069",
        "anc_00070",
        "anc_00041",
        "anc_00042",
        "anc_00043"
      ]
    },
