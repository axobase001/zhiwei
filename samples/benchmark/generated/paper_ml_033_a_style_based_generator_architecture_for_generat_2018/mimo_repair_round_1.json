  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "输入潜在码z",
        "label": "Input Latent Code",
        "summary": "从标准正态分布或均匀分布中采样的初始潜在向量。",
        "description": "传统GAN的输入潜在码，其分布必须匹配训练数据的概率密度，这可能导致纠缠。",
        "type": "input",
        "anchors": [
          "anc_00005",
          "anc_00057"
        ]
      },
      {
        "node_id": "node_002",
        "title": "映射网络f",
        "label": "Mapping Network",
        "summary": "一个由8个全连接层组成的网络，将输入潜在码z映射到中间潜在空间W。",
        "description": "映射网络f将z映射到w，其目的是“解开”W，使得变化因素更加线性。该网络使用较小的学习率（λ' = 0.01·λ）以稳定训练。",
        "type": "network",
        "anchors": [
          "anc_00010",
          "anc_00072",
          "anc_00101",
          "anc_00102"
        ]
      },
      {
        "node_id": "node_003",
        "title": "中间潜在空间W",
        "label": "Intermediate Latent Space",
        "summary": "映射网络的输出空间，其分布不受训练数据限制，允许更解耦的表示。",
        "description": "W空间是自由的，不受输入潜在空间Z必须匹配训练数据密度的限制，因此可以更解耦。风格y是从w通过仿射变换A得到的。",
        "type": "representation",
        "anchors": [
          "anc_00005",
          "anc_00007",
          "anc_00057",
          "anc_00059"
        ]
      },
      {
        "node_id": "node_004",
        "title": "仿射变换A",
        "label": "Affine Transform",
        "summary": "将中间潜在码w转换为风格向量y = (ys, yb)的线性变换。",
        "description": "仿射变换A将w映射到风格y，y包含缩放因子ys和偏置yb，用于控制AdaIN操作。",
        "type": "operation",
        "anchors": [
          "anc_00010",
          "anc_00011"
        ]
      },
      {
        "node_id": "node_005",
        "title": "合成网络g",
        "label": "Synthesis Network",
        "summary": "由18层组成的网络（每个分辨率2层），通过AdaIN和噪声输入生成图像。",
        "description": "合成网络g接收风格y和噪声输入，通过AdaIN操作在每一卷积层后注入风格，并通过添加高斯噪声提供随机细节。从常量输入（4×4×512）开始。",
        "type": "network",
        "anchors": [
          "anc_00010",
          "anc_00012",
          "anc_00018"
        ]
      },
      {
        "node_id": "node_006",
        "title": "自适应实例归一化（AdaIN）",
        "label": "Adaptive Instance Normalization",
        "summary": "一种操作，对每个特征图进行归一化，然后使用风格y进行缩放和偏置。",
        "description": "AdaIN(xi, y) = ys,i * (xi - μ(xi)) / σ(xi) + yb,i。它将风格y注入到合成网络的每一层。",
        "type": "operation",
        "anchors": [
          "anc_00012",
          "anc_00013",
          "anc_00014"
        ]
      },
      {
        "node_id": "node_007",
        "title": "噪声输入",
        "label": "Noise Inputs",
        "summary": "单通道高斯噪声图像，通过学习的缩放因子B添加到合成网络的每一层。",
        "description": "噪声输入提供随机细节（如头发、雀斑），不影响全局属性。噪声在卷积后、非线性前添加。",
        "type": "input",
        "anchors": [
          "anc_00010",
          "anc_00018",
          "anc_00044",
          "anc_00047"
        ]
      },
      {
        "node_id": "node_008",
        "title": "混合正则化",
        "label": "Mixing Regularization",
        "summary": "一种训练技术，在训练期间以一定概率使用两个不同的潜在码生成图像，以提高风格的局部化。",
        "description": "在训练期间，以一定百分比（如90%）的样本使用两个随机潜在码z1, z2，并随机选择交叉点来混合风格。这提高了网络对多个潜在码混合的容忍度。",
        "type": "regularization",
        "anchors": [
