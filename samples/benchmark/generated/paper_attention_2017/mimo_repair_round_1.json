  "glossary": {
    "terms": [
      {
        "term": "Transformer",
        "definition": "本文提出的完全基于注意力机制的序列转导模型架构。",
        "anchors": [
          "anc_00006",
          "anc_00022"
        ],
        "appears_in": [
          "anc_00006",
          "anc_00022"
        ]
      },
      {
        "term": "自注意力 (Self-Attention)",
        "definition": "一种注意力机制，将单个序列的不同位置联系起来以计算该序列的表示。在Transformer中，键、值和查询来自同一序列。",
        "anchors": [
          "anc_00014",
          "anc_00058"
        ],
        "appears_in": [
          "anc_00014",
          "anc_00058"
        ]
      },
      {
        "term": "多头注意力 (Multi-Head Attention)",
        "definition": "将查询、键、值通过不同的线性投影多次，分别执行注意力函数，然后拼接结果并再次投影的机制。",
        "anchors": [
          "anc_00050",
          "anc_00051",
          "anc_00052",
          "anc_00053",
          "anc_00054",
          "anc_00055"
        ],
        "appears_in": [
          "anc_00050",
          "anc_00051",
          "anc_00052",
          "anc_00053",
          "anc_00054",
          "anc_00055"
        ]
      },
      {
        "term": "缩放点积注意力 (Scaled Dot-Product Attention)",
        "definition": "计算查询与所有键的点积，除以√d_k后应用softmax得到权重，再对值进行加权求和的注意力函数。",
        "anchors": [
          "anc_00035",
          "anc_00036",
          "anc_00038",
          "anc_00039"
        ],
        "appears_in": [
          "anc_00035",
          "anc_00036",
          "anc_00038",
          "anc_00039"
        ]
      },
      {
        "term": "位置编码 (Positional Encoding)",
        "definition": "注入到输入嵌入中的向量，用于向模型提供序列中标记的位置信息。本文使用正弦和余弦函数。",
        "anchors": [
          "anc_00076",
          "anc_00077",
          "anc_00078"
        ],
        "appears_in": [
          "anc_00076",
          "anc_00077",
          "anc_00078"
        ]
      },
      {
        "term": "残差连接 (Residual Connection)",
        "definition": "将子层的输入直接加到其输出上，有助于训练非常深的网络。",
        "anchors": [
          "anc_00025"
        ],
        "appears_in": [
          "anc_00025"
        ]
      },
      {
        "term": "层归一化 (Layer Normalization)",
        "definition": "对每个样本的特征进行归一化，有助于稳定训练。",
        "anchors": [
          "anc_00025"
        ],
        "appears_in": [
          "anc_00025"
        ]
      },
      {
        "term": "标签平滑 (Label Smoothing)",
        "definition": "一种正则化技术，在训练时使用平滑后的标签分布，使模型更不确定，但能提高准确率和BLEU分数。",
        "anchors": [
          "anc_00114",
          "anc_00115"
        ],
        "appears_in": [
          "anc_00114",
