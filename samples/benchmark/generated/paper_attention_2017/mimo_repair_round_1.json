        ]
      },
      {
        "node_id": "node_010",
        "title": "推理细节",
        "label": "推理",
        "summary": "使用波束搜索进行解码，波束大小为4，长度惩罚α=0.6，并对检查点进行平均。",
        "description": "对于基础模型，使用最后5个检查点的平均值（每10分钟写入一次）。对于大模型，使用最后20个检查点的平均值。使用波束搜索，波束大小为4，长度惩罚α=0.6。推理时最大输出长度为输入长度+50，但会提前终止。",
        "type": "inference",
        "anchors": [
