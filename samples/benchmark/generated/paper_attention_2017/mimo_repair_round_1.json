{
  "paper_skeleton": {
    "problem": {
      "summary": "序列转导模型（如机器翻译）主要依赖复杂的循环神经网络（RNN）或卷积神经网络（CNN），这些模型存在顺序计算限制，难以并行化，且训练时间长。",
      "anchors": [
        "anc_00010",
        "anc_00012"
      ]
    },
    "motivation": {
      "summary": "RNN/CNN架构在处理长距离依赖时存在困难，且顺序计算阻碍了并行化，导致训练效率低下。注意力机制已被证明能有效连接编码器和解码器，但尚未被用作唯一的核心组件。",
      "anchors": [
        "anc_00012",
        "anc_00013",
        "anc_00014"
      ]
    },
    "core_idea": {
      "summary": "提出一种完全基于注意力机制的新型简单网络架构——Transformer，完全摒弃循环和卷积结构，仅使用自注意力机制来构建编码器和解码器。",
      "anchors": [
        "anc_00006",
        "anc_00014"
      ]
    },
    "method": {
      "summary": "Transformer采用编码器-解码器结构，编码器和解码器均由N=6个相同的层堆叠而成。每层包含多头自注意力子层和位置全连接前馈网络子层，并使用残差连接和层归一化。引入缩放点积注意力和多头注意力机制，以及正弦/余弦位置编码。",
      "anchors": [
