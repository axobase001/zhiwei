        ]
      },
      {
        "term": "Explainability",
        "definition": "可解释性，指模型为澄清其内部功能而主动采取的任何行动或程序。是模型的一种主动特性。",
        "anchors": [
          "anc_00042",
          "anc_00053"
        ],
        "appears_in": [
          "anc_00042",
          "anc_00053"
        ]
      },
      {
        "term": "Simulatability",
        "definition": "可模拟性，指人类能够独立地、逐步地思考一个模型的整个推理过程。是透明度的最高层次。",
        "anchors": [
          "anc_00090"
        ],
        "appears_in": [
          "anc_00090"
        ]
      },
      {
        "term": "Decomposability",
        "definition": "可分解性，指模型的每个部分（输入、参数、计算）都能被解释。",
        "anchors": [
