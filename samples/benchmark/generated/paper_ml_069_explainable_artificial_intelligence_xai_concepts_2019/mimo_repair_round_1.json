  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "可解释性定义与受众",
        "label": "概念基础",
        "summary": "提出以受众为中心的可解释性新定义，强调解释的目的和目标受众（如开发者、终端用户、监管机构）是理解模型的关键。",
        "description": "该节点定义了可解释性（Explainability）为一种主动特性，指模型为澄清其内部功能而采取的任何行动或程序。它区分了可理解性（Understandability）、可解释性（Explainability）、可解读性（Interpretability）等相关概念，并强调解释必须针对特定受众和目的（如信任、公平、隐私）。",
        "type": "concept",
        "anchors": [
          "anc_00029",
          "anc_00042",
          "anc_00057",
          "anc_00058"
        ]
      },
      {
        "node_id": "node_002",
        "title": "透明度层次",
        "label": "模型分类",
        "summary": "定义了ML模型透明度的三个递进层次：可模拟性、可分解性和算法透明性，用于评估模型内在的可解释程度。",
        "description": "可模拟性（Simulatability）指人类能够独立地逐步思考模型的整个推理过程。可分解性（Decomposability）指模型的每个部分（输入、参数、计算）都能被解释。算法透明性（Algorithmic Transparency）指用户能够理解模型从输入到输出所经历的过程。一个模型可以同时具备多个层次的特性。",
        "type": "taxonomy",
        "anchors": [
          "anc_00085",
          "anc_00090",
          "anc_00100"
        ]
      },
      {
        "node_id": "node_003",
        "title": "透明模型",
        "label": "方法类别",
        "summary": "回顾了本身具有一定透明度的ML模型，如线性/逻辑回归、决策树、K近邻、朴素贝叶斯、广义可加模型等。",
        "description": "这些模型因其结构简单或设计特性而具有内在的可解释性。例如，线性回归的权重直接显示了特征的重要性；决策树的规则易于理解。它们通常满足可模拟性和可分解性，但可能在复杂任务上性能不如黑盒模型。",
        "type": "method_family",
        "anchors": [
          "anc_00121",
          "anc_00127",
          "anc_00128",
          "anc_00130",
          "anc_00146",
          "anc_00154",
          "anc_00155",
          "anc_00174"
        ]
      },
      {
        "node_id": "node_004",
        "title": "事后解释技术",
        "label": "方法类别",
        "summary": "系统分类了用于解释不透明（黑盒）模型的事后技术，包括文本解释、视觉解释、局部解释、基于示例的解释、简化解释和特征相关性解释。",
        "description": "事后解释技术不改变模型本身，而是通过外部手段来理解模型。例如，LIME通过扰动输入并观察预测变化来提供局部解释；SHAP基于博弈论为每个预测分配特征重要性得分；特征可视化（如激活最大化）用于理解神经网络学到了什么。",
        "type": "method_family",
        "anchors": [
          "anc_00104",
          "anc_00105",
          "anc_00106",
          "anc_00108",
          "anc_00116",
