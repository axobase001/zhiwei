  "glossary": {
    "terms": [
      {
        "term": "Explainable AI (XAI)",
        "definition": "可解释人工智能，指一套旨在使AI/ML模型的决策过程能够被人类理解的技术和方法。",
        "anchors": [
          "anc_00007",
          "anc_00020"
