      },
      {
        "term": "Interpretability",
        "definition": "可解读性，指模型本身的设计使其功能无需额外解释即可被理解的程度。是模型的一种被动特性。",
        "anchors": [
          "anc_00042",
          "anc_00053"
        ],
        "appears_in": [
