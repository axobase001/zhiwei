  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "视觉指令数据生成",
        "label": "数据生成",
        "summary": "利用GPT-4基于图像-文本对生成多样化的多模态指令跟随数据。",
        "description": "对于图像Xv及其关联的标题Xc，提示GPT-4生成问题列表Xq，以指导助手描述图像内容。通过扩展图像-文本对，创建指令跟随版本。为了增加多样性，使用纯文本GPT-4生成详细描述和复杂推理问题。",
        "type": "data_generation",
        "anchors": [
          "anc_00029",
          "anc_00031"
        ]
      },
      {
        "node_id": "node_002",
        "title": "LLaVA模型架构",
        "label": "模型架构",
        "summary": "连接CLIP视觉编码器和Vicuna LLM，使用可训练的投影矩阵将图像特征映射到语言嵌入空间。",
        "description": "视觉编码器g(Xv)提供视觉特征Zv。应用可训练的投影矩阵W将Zv转换为语言嵌入令牌Hv，其维度与语言模型中的词嵌入空间相同。输入序列包括系统消息、图像令牌、指令和答案。",
        "type": "model_architecture",
        "anchors": [
          "anc_00035",
          "anc_00038",
          "anc_00039",
          "anc_00048",
          "anc_00054"
        ]
      },
      {
        "node_id": "node_003",
        "title": "两阶段指令微调",
        "label": "训练过程",
        "summary": "两阶段训练：第一阶段预训练对齐特征，第二阶段端到端微调。",
        "description": "第一阶段：预训练特征对齐。在CC-595K子集上训练，冻结视觉编码器和LLM，仅训练投影矩阵W。第二阶段：端到端微调。在LLaVA-Instruct-158K数据集上训练，解冻LLM，训练参数θ={W, ϕ}。",
        "type": "training_procedure",
        "anchors": [
          "anc_00057",
          "anc_00058",
          "anc_00060"
        ]
      },
      {
        "node_id": "node_004",
        "title": "自回归训练目标",
        "label": "损失函数",
        "summary": "使用自回归训练目标，计算目标答案Xa的概率。",
        "description": "对于长度为L的序列，计算目标答案Xa的概率：pθ(xi|Xv, Xinstruct,<i, Xa,<i)。模型被训练来预测助手的答案以及停止位置。",
        "type": "loss_function",
        "anchors": [
          "anc_00049",
          "anc_00050",
          "anc_00052",
          "anc_00056"
        ]
      },
      {
