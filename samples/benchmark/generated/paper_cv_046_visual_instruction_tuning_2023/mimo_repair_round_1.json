  "glossary": {
    "terms": [
      {
        "term": "视觉指令微调",
        "definition": "使用视觉-语言指令数据对多模态模型进行微调，以提升其指令跟随能力。",
        "anchors": [
          "anc_00014"
        ],
        "appears_in": [
          "anc_00014"
        ]
      },
      {
        "term": "LLaVA",
        "definition": "Large Language and Vision Assistant，一个连接视觉编码器和LLM的端到端训练的大型多模态模型。",
        "anchors": [
          "anc_00005",
          "anc_00006"
        ],
        "appears_in": [
          "anc_00005",
          "anc_00006"
        ]
      },
      {
        "term": "Vicuna",
        "definition": "一个开源的LLM，在语言任务中具有最佳的指令跟随能力。",
        "anchors": [
          "anc_00035"
        ],
        "appears_in": [
          "anc_00035"
        ]
      },
      {
        "term": "CLIP",
        "definition": "一个视觉编码器，用于提供视觉特征。",
        "anchors": [
          "anc_00035"
        ],
        "appears_in": [
          "anc_00035"
        ]
      },
      {
        "term": "投影矩阵",
        "definition": "一个可训练的线性层，用于将视觉特征映射到语言嵌入空间。",
        "anchors": [
          "anc_00039"
        ],
        "appears_in": [
          "anc_00039"
        ]
      },
      {
        "term": "自回归训练目标",
        "definition": "基于历史上下文预测下一个令牌的训练目标。",
        "anchors": [
          "anc_00049",
          "anc_00050"
        ],
        "appears_in": [
          "anc_00049",
          "anc_00050"
        ]
      },
      {
        "term": "ScienceQA",
        "definition": "一个大规模多模态科学问题数据集。",
        "anchors": [
          "anc_00062",
          "anc_00097"
        ],
        "appears_in": [
          "anc_00062",
          "anc_00097"
        ]
      },
      {
        "term": "LLaVA-Bench",
        "definition": "用于评估多模态指令跟随能力的基准，包括COCO和In-the-Wild两个版本。",
        "anchors": [
          "anc_00085"
        ],
        "appears_in": [
          "anc_00085"
        ]
      },
      {
        "term": "GPT-4集成",
