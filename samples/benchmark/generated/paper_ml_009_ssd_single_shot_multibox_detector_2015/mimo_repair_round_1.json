  "formula_ir": {
    "formulas": [
      {
        "formula_id": "formula_001",
        "formula": "L(x, c, l, g) = \\frac{1}{N} (L_{loc}(x, l, g) + \\alpha L_{conf}(x, c))",
        "variables": [
          {
            "name": "L",
            "description": "总损失",
            "confidence": "high",
            "anchors": [
              "anc_00048"
            ]
          },
          {
            "name": "N",
            "description": "匹配的默认框数量",
            "confidence": "high",
            "anchors": [
              "anc_00050"
            ]
          },
          {
            "name": "L_{loc}",
            "description": "定位损失",
            "confidence": "high",
            "anchors": [
              "anc_00052"
            ]
          },
          {
            "name": "L_{conf}",
            "description": "置信度损失",
            "confidence": "high",
            "anchors": [
              "anc_00062",
              "anc_00063"
            ]
          },
          {
            "name": "\\alpha",
            "description": "权重系数（未明确给出，但损失是加权和）",
            "confidence": "medium",
            "anchors": [
              "anc_00024"
            ]
          }
        ],
        "dependencies": [],
        "intuition": "总损失是定位损失和置信度损失的加权平均，用于同时优化边界框回归和分类。",
        "anchors": [
          "anc_00041",
          "anc_00048",
          "anc_00050"
        ]
      },
      {
        "formula_id": "formula_002",
        "formula": "L_{loc}(x, l, g) = \\sum_{i \\in Pos} \\sum_{m \\in \\{cx, cy, w, h\\}} x_{ij}^k \\text{smooth}_{L1}(l_i^m - \\hat{g}_j^m)",
        "variables": [
          {
            "name": "x_{ij}^k",
            "description": "指示函数，表示第i个默认框与第j个真实框关于类别k匹配",
            "confidence": "high",
            "anchors": [
              "anc_00042",
              "anc_00044"
            ]
          },
          {
            "name": "l_i^m",
            "description": "预测的边界框偏移参数（中心坐标、宽、高）",
            "confidence": "high",
            "anchors": [
              "anc_00053"
            ]
          },
          {
            "name": "\\hat{g}_j^m",
            "description": "编码后的真实框参数",
            "confidence": "high",
            "anchors": [
              "anc_00053",
              "anc_00054",
              "anc_00056",
              "anc_00058",
              "anc_00060"
            ]
          }
        ],
        "dependencies": [],
        "intuition": "定位损失使用Smooth L1损失，仅对正样本（匹配的默认框）计算预测框与编码后真实框之间的偏移误差。",
        "anchors": [
          "anc_00052",
          "anc_00053"
        ]
      },
      {
        "formula_id": "formula_003",
        "formula": "L_{conf}(x, c) = -\\sum_{i \\in Pos} x_{ij}^p \\log(\\hat{c}_i^p) - \\sum_{i \\in Neg} \\log(\\hat{c}_i^0)",
        "variables": [
          {
            "name": "\\hat{c}_i^p",
            "description": "预测的第i个默认框属于类别p的softmax概率",
            "confidence": "high",
            "anchors": [
              "anc_00065",
              "anc_00069"
            ]
          },
          {
            "name": "\\hat{c}_i^0",
            "description": "预测的第i个默认框属于背景类别的softmax概率",
            "confidence": "high",
            "anchors": [
              "anc_00067"
            ]
          }
        ],
        "dependencies": [],
        "intuition": "置信度损失是标准的softmax交叉熵损失，对正样本计算对应类别的损失，对负样本计算背景类别的损失。",
        "anchors": [
          "anc_00062",
          "anc_00063",
          "anc_00064",
          "anc_00065",
          "anc_00066",
          "anc_00067"
        ]
      },
      {
        "formula_id": "formula_004",
        "formula": "s_k = s_{min} + \\frac{s_{max} - s_{min}}{m - 1} (k - 1), \\quad k \\in [1, m]",
