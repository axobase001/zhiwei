  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "输入特征图",
        "label": "Input Feature Map",
        "summary": "输入特征图X，尺寸为C×H×W，作为坐标注意力块的输入。",
        "description": "输入特征图X是来自前一个卷积层的输出，包含C个通道，高度H，宽度W。",
        "type": "input",
        "anchors": [
          "anc_00017",
          "anc_00022"
        ]
      },
      {
        "node_id": "node_002",
        "title": "坐标信息嵌入",
        "label": "Coordinate Information Embedding",
        "summary": "通过两个1D全局池化操作（水平和垂直）分别聚合特征，生成方向感知的特征图。",
        "description": "使用空间范围为(H,1)和(1,W)的池化核，分别沿水平和垂直方向聚合特征，生成两个特征图z^h和z^w，每个尺寸为C×H×1和C×1×W。",
        "type": "process",
        "anchors": [
          "anc_00029",
          "anc_00030",
          "anc_00031",
          "anc_00032",
          "anc_00033",
          "anc_00034",
          "anc_00035",
          "anc_00036",
          "anc_00037",
          "anc_00038",
          "anc_00039"
        ]
      },
      {
        "node_id": "node_003",
        "title": "特征拼接与中间编码",
        "label": "Concatenation and Intermediate Encoding",
        "summary": "将两个方向感知的特征图拼接，并通过1x1卷积和激活函数生成中间特征图f。",
        "description": "将z^h和z^w沿空间维度拼接，得到尺寸为C×(H+W)的特征图，然后通过1x1卷积F1和激活函数δ（如ReLU）生成中间特征图f，尺寸为C/r×(H+W)，其中r是缩减比。",
        "type": "process",
        "anchors": [
          "anc_00040",
          "anc_00041",
          "anc_00042",
          "anc_00043"
        ]
      },
      {
        "node_id": "node_004",
        "title": "注意力图生成",
        "label": "Attention Map Generation",
        "summary": "将中间特征图f分割为水平和垂直部分，分别通过1x1卷积和sigmoid生成水平注意力图g^h和垂直注意力图g^w。",
        "description": "将f沿空间维度分割为f^h（C/r×H）和f^w（C/r×W），然后分别通过1x1卷积F^h和F^w以及sigmoid函数σ，生成水平注意力图g^h（C×H×1）和垂直注意力图g^w（C×1×W）。",
        "type": "process",
        "anchors": [
          "anc_00045",
          "anc_00046",
          "anc_00047",
          "anc_00048"
        ]
      },
      {
        "node_id": "node_005",
        "title": "注意力应用与输出",
        "label": "Attention Application and Output",
        "summary": "将水平和垂直注意力图分别扩展并与输入特征图相乘，得到增强的输出特征图Y。",
        "description": "将g^h和g^w扩展到与输入特征图相同的尺寸，然后通过逐元素相乘应用到输入特征图X上，得到输出特征图Y，其中每个元素y_c(i,j) = x_c(i,j) × g^h_c(i) × g^w_c(j)。",
        "type": "output",
        "anchors": [
          "anc_00049",
          "anc_00050"
        ]
      }
    ],
