        "anc_00050"
      ]
    },
    "experiments": {
      "summary": "在ImageNet分类、COCO/Pascal VOC目标检测和Pascal VOC/Cityscapes语义分割上进行了广泛实验，使用MobileNetV2、MobileNeXt和EfficientNet作为基线网络。",
      "anchors": [
        "anc_00052",
        "anc_00054",
        "anc_00058",
        "anc_00069",
        "anc_00076",
        "anc_00077",
        "anc_00080",
