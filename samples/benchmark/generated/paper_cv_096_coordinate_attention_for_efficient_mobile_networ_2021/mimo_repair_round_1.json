{
  "paper_skeleton": {
    "problem": {
      "summary": "现有移动端网络中的注意力机制（如SE）忽略了位置信息，导致无法生成空间选择性的注意力图，限制了模型在视觉任务中的性能。",
      "anchors": [
        "anc_00003",
        "anc_00008"
      ]
    },
    "motivation": {
      "summary": "位置信息对于捕捉物体结构至关重要，但现有的通道注意力方法（如SE）通过2D全局池化丢失了位置信息。后续工作（如CBAM）尝试引入空间注意力，但卷积只能捕捉局部关系，无法建模长距离依赖。",
      "anchors": [
        "anc_00003",
        "anc_00008",
        "anc_00013"
      ]
    },
    "core_idea": {
      "summary": "提出坐标注意力（Coordinate Attention），通过将通道注意力分解为两个1D特征编码过程（水平和垂直方向），在捕捉长距离依赖的同时保留精确的位置信息，生成方向感知和位置敏感的注意力图。",
      "anchors": [
        "anc_00003",
        "anc_00016",
        "anc_00030",
        "anc_00039"
      ]
    },
    "method": {
      "summary": "坐标注意力块包含三个步骤：1）坐标信息嵌入：使用两个1D全局池化（水平和垂直）分别聚合特征，生成方向感知的特征图；2）坐标注意力生成：将两个特征图拼接，通过1x1卷积和激活函数生成中间特征，然后分割并分别通过1x1卷积和sigmoid生成水平和垂直注意力图；3）注意力应用：将两个注意力图分别扩展并与输入特征图相乘，得到增强的输出。",
      "anchors": [
        "anc_00029",
        "anc_00030",
        "anc_00031",
        "anc_00032",
        "anc_00033",
        "anc_00034",
        "anc_00035",
        "anc_00036",
        "anc_00037",
        "anc_00038",
        "anc_00039",
        "anc_00040",
