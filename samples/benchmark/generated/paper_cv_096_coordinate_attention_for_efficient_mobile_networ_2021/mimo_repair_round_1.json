  "glossary": {
    "terms": [
      {
        "term": "坐标注意力（Coordinate Attention）",
        "definition": "一种轻量级注意力机制，通过将通道注意力分解为两个1D特征编码过程（水平和垂直方向），在捕捉长距离依赖的同时保留精确的位置信息。",
        "anchors": [
          "anc_00003",
          "anc_00016"
        ],
        "appears_in": [
          "anc_00003",
          "anc_00016"
        ]
      },
