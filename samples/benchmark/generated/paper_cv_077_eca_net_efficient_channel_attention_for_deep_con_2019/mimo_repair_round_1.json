  "glossary": {
    "terms": [
      {
        "term": "通道注意力（Channel Attention）",
        "definition": "一种注意力机制，通过学习一组权重来重新校准（re-calibrate）特征图中各个通道的重要性。",
        "anchors": [
          "anc_00004",
          "anc_00010"
        ],
        "appears_in": [
          "anc_00004",
          "anc_00010"
        ]
      },
      {
        "term": "SENet（Squeeze-and-Excitation Networks）",
        "definition": "一种引入通道注意力机制的深度卷积神经网络架构，通过全局平均池化（Squeeze）和两个全连接层（Excitation）来学习通道权重。",
        "anchors": [
          "anc_00004",
          "anc_00016",
          "anc_00018",
          "anc_00019"
        ],
        "appears_in": [
          "anc_00004",
          "anc_00016",
          "anc_00018",
          "anc_00019"
        ]
      },
      {
        "term": "ECA模块（Efficient Channel Attention Module）",
        "definition": "本文提出的高效通道注意力模块，通过避免维度降维和采用局部跨通道交互（一维卷积）来高效学习通道注意力。",
        "anchors": [
          "anc_00004",
          "anc_00012",
          "anc_00013",
          "anc_00014",
