{
  "paper_skeleton": {
    "problem": {
      "summary": "现有通道注意力机制（如SENet）在提升深度卷积神经网络性能的同时，不可避免地增加了模型复杂度，导致性能与复杂度之间的权衡矛盾。",
      "anchors": [
        "anc_00004",
        "anc_00010",
        "anc_00016"
      ]
    },
    "motivation": {
      "summary": "为了克服性能与复杂度之间的矛盾，需要一种既能有效学习通道注意力，又能保持极低模型复杂度的方法。",
      "anchors": [
        "anc_00004",
        "anc_00010",
        "anc_00016"
      ]
    },
    "core_idea": {
      "summary": "提出高效通道注意力（ECA）模块，通过避免通道维度降维并采用局部跨通道交互策略，利用一维卷积高效实现，并自适应确定卷积核大小。",
      "anchors": [
        "anc_00004",
        "anc_00012",
        "anc_00013",
        "anc_00014",
        "anc_00015",
        "anc_00018",
        "anc_00019",
        "anc_00020"
      ]
    },
    "method": {
      "summary": "ECA模块首先对输入特征进行全局平均池化（GAP），然后通过一个快速的一维卷积（核大小k）生成通道权重，最后通过Sigmoid函数进行激活。核大小k通过一个非线性映射自适应地由通道维度C确定。",
      "anchors": [
        "anc_00011",
        "anc_00012",
        "anc_00013",
