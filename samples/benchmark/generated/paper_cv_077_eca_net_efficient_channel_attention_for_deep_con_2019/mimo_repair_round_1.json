  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "全局平均池化（GAP）",
        "label": "特征聚合",
        "summary": "对输入特征图的每个通道独立进行全局平均池化，得到通道描述符。",
        "description": "给定输入特征X，通过全局平均池化（GAP）得到聚合特征y，其中y的每个元素是对应通道所有空间位置的平均值。",
        "type": "feature_aggregation",
        "anchors": [
          "anc_00029",
          "anc_00030",
          "anc_00032",
          "anc_00033"
        ]
      },
      {
        "node_id": "node_002",
        "title": "一维卷积（1D Conv）",
        "label": "通道交互",
        "summary": "使用核大小为k的一维卷积在通道维度上进行局部跨通道交互，生成通道权重。",
        "description": "对聚合特征y应用一维卷积C1D_k，实现局部跨通道交互。卷积核大小k决定了交互的覆盖范围。",
        "type": "channel_interaction",
        "anchors": [
          "anc_00058",
          "anc_00059",
          "anc_00060"
        ]
      },
      {
        "node_id": "node_003",
        "title": "自适应核大小选择",
        "label": "参数自适应",
        "summary": "根据通道维度C自适应地确定一维卷积的核大小k，避免手动调参。",
        "description": "通过非线性映射k = ψ(C) = |log2(C)/γ + b/γ|_odd，将通道维度C映射到核大小k，其中γ和b是超参数，|·|_odd表示取最近的奇数。",
        "type": "parameter_adaptation",
        "anchors": [
          "anc_00068",
          "anc_00073",
          "anc_00076",
          "anc_00078"
        ]
      },
      {
        "node_id": "node_004",
        "title": "Sigmoid激活",
        "label": "权重生成",
        "summary": "对一维卷积的输出应用Sigmoid函数，生成最终的通道注意力权重。",
        "description": "将一维卷积的输出通过Sigmoid函数σ，得到0到1之间的通道权重ω，用于对原始特征进行通道加权。",
        "type": "activation",
        "anchors": [
          "anc_00058",
          "anc_00059"
        ]
      },
      {
        "node_id": "node_005",
        "title": "通道加权",
        "label": "特征调制",
        "summary": "将生成的通道注意力权重与原始输入特征进行逐元素相乘，实现通道注意力调制。",
        "description": "将通道权重ω与原始输入特征X进行逐元素相乘，得到加权后的特征输出。",
        "type": "feature_modulation",
        "anchors": [
