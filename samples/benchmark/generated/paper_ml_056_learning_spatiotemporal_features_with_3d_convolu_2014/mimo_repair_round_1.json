{
  "paper_skeleton": {
    "problem": {
      "summary": "缺乏通用的视频描述符，难以统一处理大规模视频分析任务（如动作识别、场景分类等）。",
      "anchors": [
        "anc_00009",
        "anc_00010"
      ]
    },
    "motivation": {
      "summary": "互联网视频爆炸式增长，需要一种通用、紧凑、高效且简单的视频特征描述符，以支持搜索、推荐、排序等应用。",
      "anchors": [
        "anc_00008",
        "anc_00011",
        "anc_00012",
        "anc_00013",
        "anc_00014",
        "anc_00015"
      ]
    },
    "core_idea": {
      "summary": "使用深度3D卷积网络（3D ConvNets）在大规模监督视频数据集上学习时空特征，提出C3D（Convolutional 3D）特征。",
      "anchors": [
        "anc_00003",
        "anc_00004",
        "anc_00005",
        "anc_00006",
        "anc_00007"
      ]
    },
    "method": {
      "summary": "设计并训练一个具有8个卷积层、5个池化层和2个全连接层的3D卷积网络，所有卷积核均为3×3×3，在Sports-1M数据集上训练，提取fc6层激活作为视频特征。",
      "anchors": [
        "anc_00060",
        "anc_00061",
        "anc_00062",
        "anc_00063",
        "anc_00064",
        "anc_00065",
        "anc_00066",
