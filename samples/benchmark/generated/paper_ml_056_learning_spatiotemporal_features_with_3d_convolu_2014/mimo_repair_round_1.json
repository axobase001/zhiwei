        "anc_00068",
        "anc_00069",
        "anc_00070",
        "anc_00072"
      ]
    },
    "experiments": {
      "summary": "在6个基准数据集（Sports-101、UCF101、ASLAN、YUPENN、UMD、Object）上评估C3D特征，与现有最佳方法比较，并进行架构搜索、紧凑性、效率等分析。",
      "anchors": [
        "anc_00018",
        "anc_00020",
