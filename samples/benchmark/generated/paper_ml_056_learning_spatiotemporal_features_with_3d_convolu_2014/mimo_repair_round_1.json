  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "3D卷积与池化",
        "label": "核心操作",
        "summary": "3D卷积和池化操作在时空维度上进行，能够同时建模外观和运动信息，而2D操作仅在空间维度进行。",
        "description": "3D卷积核在视频体积上滑动，输出另一个体积，保留时间信息；2D卷积在多帧上操作会输出图像，丢失时间信息。3D池化类似，在时空维度上降采样。",
        "type": "operation",
        "anchors": [
          "anc_00034",
          "anc_00035",
          "anc_00036",
          "anc_00037"
        ]
      },
      {
        "node_id": "node_002",
        "title": "架构搜索",
        "label": "实验设计",
        "summary": "在UCF101上搜索最佳3D卷积核时间深度，发现3×3×3同构架构表现最佳。",
        "description": "固定空间感受野为3×3，仅变化卷积核时间深度d。实验了同构深度（所有层相同d）和变化深度架构。结果表明深度-3（d=3）的同构架构在准确率和参数效率上最优。",
        "type": "experiment",
        "anchors": [
          "anc_00041",
          "anc_00047",
          "anc_00050",
          "anc_00051",
          "anc_00052",
          "anc_00053",
          "anc_00054",
          "anc_00055",
          "anc_00056"
        ]
      },
      {
        "node_id": "node_003",
        "title": "C3D网络架构",
        "label": "模型定义",
        "summary": "最终的C3D网络包含8个3×3×3卷积层、5个池化层（pool1为1×2×2）、2个4096单元的全连接层和softmax输出层。",
        "description": "所有3D卷积滤波器为3×3×3，步长1×1×1。池化层为2×2×2，步长2×2×2，除了pool1为1×2×2以保留早期时间信息。输入为16帧112×112的视频片段。",
        "type": "architecture",
        "anchors": [
          "anc_00060",
          "anc_00061",
          "anc_00062",
          "anc_00067",
          "anc_00068",
          "anc_00069",
          "anc_00070"
        ]
      },
      {
        "node_id": "node_004",
        "title": "训练过程",
        "label": "训练细节",
        "summary": "在Sports-1M数据集上从头训练C3D，使用SGD，初始学习率0.003，每150K迭代除以2，训练1.9M迭代。",
        "description": "从每个训练视频中随机提取5个2秒片段，调整为128×171，随机裁剪为16×112×112并水平翻转。小批量大小为30。",
        "type": "training",
        "anchors": [
          "anc_00064",
          "anc_00065",
          "anc_00066"
        ]
      },
      {
        "node_id": "node_005",
        "title": "特征提取",
        "label": "推理过程",
        "summary": "将视频分割为16帧片段（8帧重叠），通过C3D网络提取fc6激活，平均后L2归一化，得到4096维视频描述符。",
        "description": "在推理时，视频被分成重叠的16帧片段，每个片段通过网络得到fc6层激活，所有片段的激活取平均，然后L2归一化，形成最终的C3D视频特征。",
        "type": "inference",
        "anchors": [
          "anc_00072"
        ]
      },
      {
        "node_id": "node_006",
        "title": "特征可视化与分析",
        "label": "可解释性",
        "summary": "使用反卷积方法可视化C3D学习的特征，发现早期层学习低级运动模式，后期层学习高级语义运动模式。",
        "description": "可视化显示C3D在最初几帧捕获外观，之后只关注显著运动。在conv2a层学习边缘、斑块等低级运动，在conv3b层学习角点、纹理、身体部位等，在conv5b层学习更抽象的运动模式。",
        "type": "analysis",
        "anchors": [
          "anc_00073",
          "anc_00074",
          "anc_00109",
          "anc_00110",
          "anc_00111"
        ]
      }
