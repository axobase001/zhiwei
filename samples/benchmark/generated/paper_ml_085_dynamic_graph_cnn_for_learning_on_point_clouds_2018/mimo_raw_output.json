  "glossary": {
    "EdgeConv": "本文提出的核心模块，通过动态图和边特征学习点云局部几何结构。",
    "DGCNN": "Dynamic Graph CNN，使用EdgeConv的动态图卷积网络。",
    "置换不变性": "函数输出不依赖于输入顺序的性质，点云处理的基本要求。",
    "k近邻图": "基于k个最近邻构建的图结构，用于定义局部邻域。",
    "动态图": "在每一层基于特征空间重新构建的图，与固定图相对。",
    "边特征": "描述图中两点之间关系的特征向量。",
    "对称聚合": "对邻域特征进行与顺序无关的聚合操作，如max或sum。"
  },
