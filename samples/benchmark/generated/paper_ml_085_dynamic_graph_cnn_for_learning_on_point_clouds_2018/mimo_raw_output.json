      {
        "node_id": "node_002",
        "title": "动态图构建",
        "label": "Dynamic Graph Construction",
        "summary": "在每一层基于当前特征空间构建k近邻图G = (V, E)。",
        "description": "图在每一层动态更新，基于特征空间中的最近邻关系。这是DGCNN与固定图方法的关键区别。",
        "type": "process",
        "anchors": [
