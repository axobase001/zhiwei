          {
            "name": "\\square",
            "description": "对称聚合操作（如max或sum）",
            "confidence": "high",
            "anchors": [
              "anc_00056"
            ]
          },
          {
            "name": "h_\\Theta",
            "description": "可学习的边特征函数，参数为Θ",
            "confidence": "high",
            "anchors": [
              "anc_00054"
            ]
          },
          {
            "name": "E",
            "description": "边集合，由k近邻图定义",
            "confidence": "high",
            "anchors": [
              "anc_00052"
            ]
          }
        ],
        "dependencies": [],
        "intuition": "EdgeConv的核心公式：通过聚合邻域点的边特征来更新点特征。聚合操作保证置换不变性。",
        "anchors": [
          "anc_00057"
        ]
      },
      {
        "formula_id": "formula_002",
        "latex": "h_\\Theta(x_i, x_j) = \\bar{h}_\\Theta(x_i, x_j - x_i)",
        "variables": [
          {
            "name": "\\bar{h}_\\Theta",
            "description": "可学习函数，输入为中心点和相对向量",
            "confidence": "high",
            "anchors": [
              "anc_00069"
            ]
          },
          {
            "name": "x_j - x_i",
            "description": "邻域点相对于中心点的位置差",
            "confidence": "high",
            "anchors": [
              "anc_00069"
            ]
          }
        ],
        "dependencies": [],
        "intuition": "边函数的一种实现：显式使用相对位置信息，有助于捕捉局部几何。",
        "anchors": [
          "anc_00069"
        ]
      },
      {
        "formula_id": "formula_003",
        "latex": "h_{\\Theta m}(x_i, x_j) = \\text{ReLU}(\\theta_m \\cdot (x_j - x_i) + \\phi_m \\cdot x_i)",
        "variables": [
          {
            "name": "\\theta_m, \\phi_m",
            "description": "可学习权重参数",
            "confidence": "high",
            "anchors": [
              "anc_00071",
              "anc_00075"
            ]
          },
          {
            "name": "x_j - x_i",
            "description": "相对位置向量",
            "confidence": "high",
            "anchors": [
              "anc_00071"
            ]
          },
          {
            "name": "x_i",
            "description": "中心点坐标",
            "confidence": "high",
            "anchors": [
              "anc_00071"
            ]
          }
        ],
        "dependencies": [],
        "intuition": "边函数的具体MLP实现：结合相对位置和绝对位置，通过ReLU激活。",
        "anchors": [
