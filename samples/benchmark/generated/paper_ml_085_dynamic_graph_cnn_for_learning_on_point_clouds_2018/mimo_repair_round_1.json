    "deltas": [
      {
        "before": "PointNet: hΘ(xi, xj) = hΘ(xi)，仅考虑中心点。",
        "after": "DGCNN: hΘ(xi, xj) = hΘ(xi, xj) 或 hΘ(xi, xj-xi)，考虑点对关系。",
        "why_it_matters": "能捕捉局部几何结构，而不仅仅是全局特征。",
        "anchors": [
          "anc_00095",
          "anc_00096",
          "anc_00097",
          "anc_00069"
        ],
        "delta_id": "delta_1"
      },
      {
        "before": "PointNet++: hΘ(xi, xj) = hΘ(xj)，仅考虑邻域点。",
        "after": "DGCNN: 同时考虑中心点和邻域点，或相对位置。",
        "why_it_matters": "更好地建模局部上下文，提升特征区分度。",
        "anchors": [
          "anc_00099",
          "anc_00100"
        ],
        "delta_id": "delta_2"
      },
      {
        "before": "固定图：图在输入层构建后不变。",
        "after": "动态图：每一层基于特征空间重新构建图。",
        "why_it_matters": "深层特征空间能捕捉语义相似性，即使原始空间距离远。",
        "anchors": [
          "anc_00077",
          "anc_00116"
        ],
        "delta_id": "delta_3"
      },
      {
        "before": "MoNet等：使用预定义图或固定图。",
        "after": "DGCNN：图随训练动态变化。",
        "why_it_matters": "首次实现图在层间和训练中动态更新，增强表示能力。",
        "anchors": [
          "anc_00116"
        ],
        "delta_id": "delta_4"
      }
    ]
  },
  "formula_ir": {
    "formulas": [
      {
        "formula_id": "formula_001",
        "latex": "x'_i = \\square_{j:(i,j)\\in E} h_\\Theta(x_i, x_j)",
        "variables": [
