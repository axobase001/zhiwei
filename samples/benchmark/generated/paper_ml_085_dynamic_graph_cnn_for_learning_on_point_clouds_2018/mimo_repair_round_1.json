{
  "paper_skeleton": {
    "problem": {
      "summary": "点云数据缺乏拓扑信息，传统方法独立处理各点，无法有效捕捉局部几何结构，限制了表示能力。",
      "anchors": [
        "anc_00011",
        "anc_00014",
        "anc_00022",
        "anc_00028",
        "anc_00032"
      ]
    },
    "motivation": {
      "summary": "CNN在图像分析中取得巨大成功，但点云缺乏规则网格结构。需要设计能恢复拓扑信息、捕捉局部几何关系并保持置换不变性的模块。",
      "anchors": [
        "anc_00011",
        "anc_00012",
        "anc_00013",
        "anc_00014",
        "anc_00022"
      ]
    },
    "core_idea": {
      "summary": "提出EdgeConv模块，通过动态构建图并学习边特征来捕捉局部几何结构。EdgeConv在每一层动态更新图，结合局部邻域信息，通过堆叠学习全局形状属性。",
      "anchors": [
        "anc_00023",
        "anc_00033",
        "anc_00077"
      ]
    },
    "method": {
      "summary": "EdgeConv模块：1) 对每个点构建k近邻图；2) 计算边特征hΘ(xi, xj)；3) 通过对称聚合操作（如max）生成新点特征。图在每一层基于特征空间动态更新。",
      "anchors": [
        "anc_00051",
        "anc_00052",
        "anc_00054",
        "anc_00056",
        "anc_00057",
        "anc_00077",
        "anc_00080"
      ]
    },
    "experiments": {
      "summary": "在ModelNet40分类、ShapeNetPart部件分割、S3DIS语义分割三个基准上评估。与PointNet、PointNet++、PCNN等方法比较。",
      "anchors": [
        "anc_00117",
        "anc_00118",
        "anc_00120",
        "anc_00125",
        "anc_00126",
        "anc_00153",
        "anc_00162"
      ]
    },
    "claims": [
      {
        "claim_id": "claim_1",
        "claim": "EdgeConv能有效捕捉局部几何结构；动态图更新能学习语义特征；模型在分类和分割任务上达到SOTA；模型复杂度和计算效率优于现有方法。",
        "anchors": [
          "anc_00023",
          "anc_00033",
          "anc_00077",
          "anc_00116",
          "anc_00125",
          "anc_00131",
          "anc_00166",
          "anc_00172"
        ]
      }
    ],
    "limitations": [
      {
        "limitation": "当k过大时，欧氏距离无法近似测地距离，破坏局部几何；点云密度极低时性能下降；未探索快速数据结构优化计算效率。",
        "anchors": [
          "anc_00138",
          "anc_00139",
          "anc_00140",
          "anc_00141",
          "anc_00143",
          "anc_00176"
        ]
      }
    ]
  },
  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "输入点云",
        "label": "Input Point Cloud",
        "summary": "输入为点云集合X = {x1, ..., xn} ⊆ RF，通常F=3表示3D坐标。",
        "description": "点云是散乱点集合，缺乏拓扑信息。每个点包含坐标信息，可能包含法向量等附加特征。",
        "type": "input",
        "anchors": [
          "anc_00048",
          "anc_00049"
        ]
      },
      {
        "node_id": "node_002",
        "title": "动态图构建",
        "label": "Dynamic Graph Construction",
        "summary": "在每一层基于当前特征空间构建k近邻图G = (V, E)。",
        "description": "图在每一层动态更新，基于特征空间中的最近邻关系。这是DGCNN与固定图方法的关键区别。",
        "type": "process",
        "anchors": [
          "anc_00051",
          "anc_00052",
          "anc_00077",
          "anc_00080"
        ]
      },
      {
        "node_id": "node_003",
        "title": "边特征计算",
        "label": "Edge Feature Computation",
        "summary": "对每条边(i,j)计算边特征ei j = hΘ(xi, xj)，其中hΘ是可学习函数。",
        "description": "边特征描述点对之间的关系。hΘ可以是MLP，输入为xi和xj的拼接或差值。",
        "type": "process",
        "anchors": [
          "anc_00054",
          "anc_00069",
          "anc_00071"
        ]
      },
      {
        "node_id": "node_004",
        "title": "对称聚合",
        "label": "Symmetric Aggregation",
        "summary": "对每个顶点，聚合其所有出边的边特征：x′i = □j:(i,j)∈E hΘ(xi, xj)。",
        "description": "聚合操作□可以是求和或max，保证置换不变性。max pooling是常用选择。",
        "type": "process",
        "anchors": [
          "anc_00056",
          "anc_00057",
          "anc_00086"
        ]
      },
      {
        "node_id": "node_005",
        "title": "EdgeConv层",
        "label": "EdgeConv Layer",
        "summary": "EdgeConv层整合图构建、边特征计算和聚合操作，输出新的点特征。",
        "description": "EdgeConv可堆叠，深层能捕捉更全局的语义特征。特征空间中的邻近性反映语义相似性。",
        "type": "module",
        "anchors": [
          "anc_00023",
          "anc_00057"
        ]
      },
      {
        "node_id": "node_006",
        "title": "全局特征聚合",
        "label": "Global Feature Aggregation",
        "summary": "通过全局max/sum pooling将点特征聚合为全局形状特征。",
        "description": "用于分类任务，将点云转换为固定长度的全局表示。",
        "type": "process",
        "anchors": [
          "anc_00122"
        ]
      },
      {
        "node_id": "node_007",
        "title": "分类/分割头",
        "label": "Classification/Segmentation Head",
        "summary": "全连接层用于分类，逐点分类用于分割。",
        "description": "分类：全局特征后接FC层；分割：拼接各层特征后逐点分类。",
        "type": "output",
        "anchors": [
          "anc_00044",
          "anc_00123"
        ]
      }
    ],
