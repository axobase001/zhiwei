{
  "paper_skeleton": {
    "problem": {
      "summary": "深度卷积网络在图像识别中取得巨大进展，但如何结合Inception架构的计算效率与残差连接的训练加速效果是一个开放问题。",
      "anchors": [
        "anc_00007",
        "anc_00012",
        "anc_00013"
      ]
    },
    "motivation": {
      "summary": "残差连接在传统架构中取得了与Inception-v3相似的性能，但将两者结合是否能带来益处尚不明确。同时，需要设计更高效、更统一的Inception架构变体。",
      "anchors": [
        "anc_00007",
        "anc_00012",
        "anc_00013",
        "anc_00014"
      ]
    },
    "core_idea": {
      "summary": "提出三种新架构：纯Inception-v4、Inception-ResNet-v1和Inception-ResNet-v2，通过实证研究残差连接对Inception网络训练速度和最终精度的影响，并引入残差缩放技术以稳定训练。",
      "anchors": [
        "anc_00010",
        "anc_00014",
        "anc_00032",
        "anc_00086"
      ]
    },
    "method": {
      "summary": "设计统一的Inception模块（A、B、C）和缩减模块，将残差连接引入Inception架构，并在残差分支末端使用线性激活和缩放（约0.1倍）以稳定训练。使用RMSProp优化器和指数学习率衰减进行训练。",
      "anchors": [
        "anc_00029",
        "anc_00030",
        "anc_00031",
        "anc_00032",
        "anc_00084",
        "anc_00085",
        "anc_00086",
        "anc_00088",
        "anc_00091",
        "anc_00092"
      ]
    },
    "experiments": {
      "summary": "在ILSVRC 2012分类任务上评估单模型单裁剪、多裁剪（10/12、144）以及集成性能。比较了Inception-v3、Inception-v4、Inception-ResNet-v1和Inception-ResNet-v2的训练曲线和最终错误率。",
      "anchors": [
