  "glossary": {
    "terms": [
      {
        "term": "Inception架构",
        "definition": "一种卷积神经网络架构，其核心思想是在同一层内使用不同尺寸的卷积核（如1x1, 3x3, 5x5）和池化操作，并将它们的输出拼接起来，以捕获多尺度特征。",
        "anchors": [
          "anc_00007",
          "anc_00012",
          "anc_00014"
        ],
        "appears_in": [
          "anc_00007",
          "anc_00012",
          "anc_00014"
        ]
      },
      {
        "term": "残差连接",
        "definition": "一种网络连接方式，将层的输入直接加到其输出上，即 y = F(x) + x。这有助于梯度流动，使得训练非常深的网络成为可能。",
        "anchors": [
          "anc_00012",
          "anc_00013",
          "anc_00021",
          "anc_00022",
          "anc_00023",
          "anc_00024"
        ],
        "appears_in": [
          "anc_00012",
          "anc_00013",
          "anc_00021",
          "anc_00022",
          "anc_00023",
          "anc_00024"
        ]
      },
      {
        "term": "滤波器拼接",
        "definition": "Inception架构中，将来自不同卷积/池化分支的输出张量在通道维度上拼接起来的操作。",
        "anchors": [
          "anc_00014"
        ],
        "appears_in": [
          "anc_00014"
        ]
      },
      {
        "term": "残差缩放",
        "definition": "在残差连接中，对残差分支F(x)的输出乘以一个小的常数（如0.1）的技术，用于稳定训练，特别是在网络很宽（滤波器数量多）时。",
        "anchors": [
          "anc_00084",
          "anc_00085",
          "anc_00086"
        ],
        "appears_in": [
          "anc_00084",
          "anc_00085",
          "anc_00086"
        ]
      },
      {
        "term": "ILSVRC 2012",
        "definition": "ImageNet大规模视觉识别挑战赛2012，是一个广泛使用的图像分类基准数据集，包含1000个类别。",
        "anchors": [
          "anc_00010",
          "anc_00092",
          "anc_00097",
          "anc_00098"
