  "glossary": {
    "terms": [
      {
        "term": "可变形卷积",
        "definition": "一种卷积操作，其采样网格的位置通过额外学习的2D偏移量进行动态调整，从而能够适应输入特征的几何变换。",
        "anchors": [
          "anc_00003",
          "anc_00019",
          "anc_00024"
        ],
        "appears_in": [
          "anc_00003",
          "anc_00019",
          "anc_00024"
        ]
      },
      {
        "term": "可变形RoI池化",
        "definition": "一种RoI池化操作，其固定的空间分箱通过额外学习的偏移量进行动态调整，使池化区域能够自适应地聚焦于物体的关键部分。",
        "anchors": [
          "anc_00003",
          "anc_00048",
          "anc_00051"
        ],
        "appears_in": [
          "anc_00003",
          "anc_00048",
          "anc_00051"
        ]
      },
      {
        "term": "偏移量",
        "definition": "在可变形模块中，为每个采样位置或分箱学习的2D向量，用于调整其相对于标准网格或固定分箱的位置。",
        "anchors": [
          "anc_00024",
          "anc_00048"
        ],
        "appears_in": [
          "anc_00024",
          "anc_00048"
        ]
      },
      {
        "term": "双线性插值",
        "definition": "一种插值方法，用于计算分数坐标位置处的特征值。在可变形卷积和RoI池化中，用于实现分数偏移量的采样。",
        "anchors": [
          "anc_00028",
          "anc_00029",
