      }
    ],
    "limitations": [
      {
        "limitation": "论文未明确讨论局限性。潜在局限可能包括：偏移量学习增加了少量计算开销；对于某些简单任务，性能提升可能不显著；偏移量的可解释性有待研究。",
        "anchors": []
      }
    ]
  },
  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "标准卷积",
        "label": "Baseline Convolution",
        "summary": "标准卷积操作，使用固定的规则网格R对输入特征图进行采样，然后加权求和。",
        "description": "对于输出特征图上的每个位置p0，标准卷积的计算公式为 y(p0) = Σ_{p_n∈R} w(p_n)·x(p0 + p_n)，其中R定义了感受野大小和膨胀率。",
        "type": "基础模块",
        "anchors": [
          "anc_00021",
          "anc_00022",
          "anc_00023"
        ]
      },
      {
        "node_id": "node_002",
        "title": "可变形卷积",
        "label": "Deformable Convolution",
        "summary": "在标准卷积的采样网格上增加可学习的2D偏移量，使采样位置能够自由变形。",
        "description": "公式变为 y(p0) = Σ_{p_n∈R} w(p_n)·x(p0 + p_n + Δp_n)。偏移量Δp_n通过一个与当前卷积层具有相同空间分辨率和膨胀率的额外卷积层从输入特征图学习得到。由于偏移量通常是分数，通过双线性插值实现。",
        "type": "核心创新模块",
        "anchors": [
          "anc_00024",
          "anc_00025",
          "anc_00026",
          "anc_00027",
          "anc_00039"
        ]
      },
      {
        "node_id": "node_003",
        "title": "双线性插值",
        "label": "Bilinear Interpolation",
        "summary": "用于实现分数位置采样的操作，是可变形卷积和RoI池化的关键计算步骤。",
        "description": "对于任意分数位置p，其特征值x(p)通过双线性插值计算：x(p) = Σ_q G(q, p)·x(q)，其中G(q, p) = g(q_x, p_x)·g(q_y, p_y)，g(a, b) = max(0, 1 - |a - b|)。梯度可以通过此操作反向传播。",
        "type": "计算操作",
        "anchors": [
          "anc_00028",
          "anc_00029",
          "anc_00030",
          "anc_00031",
          "anc_00032",
          "anc_00033"
        ]
      },
      {
        "node_id": "node_004",
        "title": "标准RoI池化",
        "label": "Standard RoI Pooling",
        "summary": "将感兴趣区域（RoI）划分为固定的空间分箱，并对每个分箱内的特征进行池化。",
        "description": "对于k×k的特征图，第(i,j)个分箱的输出为 y(i,j) = Σ_{p∈bin(i,j)} x(p0 + p) / n_ij，其中n_ij是分箱内的像素数。",
        "type": "基础模块",
        "anchors": [
          "anc_00040",
          "anc_00042",
          "anc_00043"
        ]
      },
      {
        "node_id": "node_005",
        "title": "可变形RoI池化",
        "label": "Deformable RoI Pooling",
        "summary": "在标准RoI池化的每个空间分箱上增加可学习的偏移量，使分箱区域能够自适应变形。",
        "description": "公式变为 y(i,j) = Σ_{p∈bin(i,j)} x(p0 + p + Δp_ij) / n_ij。偏移量Δp_ij通过一个全连接层从RoI特征学习得到，并经过归一化（Δp_ij = γ·Δp̂_ij ∘ (w, h)，γ=0.1）以保持对RoI大小的不变性。",
        "type": "核心创新模块",
        "anchors": [
          "anc_00048",
          "anc_00050",
          "anc_00051",
          "anc_00054",
          "anc_00056"
        ]
      },
      {
        "node_id": "node_006",
        "title": "可变形位置敏感RoI池化",
        "label": "Deformable PS RoI Pooling",
        "summary": "对位置敏感（PS）RoI池化进行可变形扩展，为每个分箱学习偏移量。",
        "description": "在R-FCN框架中，输入特征图首先被转换为k²个分数图。可变形PS RoI池化在这些分数图的每个分箱上增加偏移量，偏移量通过卷积层学习。",
        "type": "核心创新模块",
        "anchors": [
          "anc_00057",
          "anc_00037",
          "anc_00038"
        ]
      },
      {
        "node_id": "node_007",
        "title": "偏移量学习",
        "label": "Offset Learning",
        "summary": "可变形模块中偏移量的学习机制，通过额外的卷积层或全连接层实现，并与主网络联合训练。",
        "description": "对于可变形卷积，偏移量通过一个卷积层生成；对于可变形RoI池化，偏移量通过一个全连接层生成。这些额外层的权重初始化为零，学习率设置为现有层的β倍（默认β=1，对于Faster R-CNN中的fc层β=0.01）。梯度通过双线性插值操作反向传播。",
        "type": "学习机制",
        "anchors": [
          "anc_00039",
          "anc_00058",
          "anc_00059",
          "anc_00060",
          "anc_00061"
        ]
      },
      {
        "node_id": "node_008",
        "title": "可变形卷积网络",
        "label": "Deformable ConvNets",
        "summary": "将可变形卷积和可变形RoI池化模块集成到现有CNN架构中形成的网络。",
        "description": "可变形模块可以即插即用地替换其标准对应模块。论文将其集成到ResNet-101和Aligned-Inception-ResNet等主干网络中，用于语义分割（DeepLab）和目标检测（Faster R-CNN, R-FCN）任务。",
        "type": "完整网络",
        "anchors": [
          "anc_00061",
          "anc_00065",
          "anc_00120",
          "anc_00121"
        ]
      }
    ],
