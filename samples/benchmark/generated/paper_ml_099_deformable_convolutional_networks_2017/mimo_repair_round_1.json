{
  "paper_skeleton": {
    "problem": {
      "summary": "卷积神经网络（CNN）因其构建模块的固定几何结构，在建模几何变换方面存在固有局限性。",
      "anchors": [
        "anc_00003",
        "anc_00010"
      ]
    },
    "motivation": {
      "summary": "现有CNN模块（如卷积、池化）的采样位置固定，无法自适应地处理物体的尺度、长宽比、旋转等几何变化，这限制了其在目标检测和语义分割等任务中的性能。",
      "anchors": [
        "anc_00010",
        "anc_00012"
      ]
    },
    "core_idea": {
      "summary": "引入可变形卷积和可变形RoI池化两个新模块，通过为标准模块的采样位置添加可学习的偏移量，使CNN能够自适应地学习空间变换，从而增强其几何变换建模能力。",
      "anchors": [
        "anc_00003",
        "anc_00005",
        "anc_00019"
      ]
    },
    "method": {
      "summary": "提出可变形卷积网络（Deformable ConvNets），包含两个核心模块：1) 可变形卷积：在标准卷积的规则网格采样位置上增加2D偏移量，偏移量通过额外的卷积层从输入特征图学习得到；2) 可变形RoI池化：在标准RoI池化的固定空间分箱上增加偏移量，偏移量通过全连接层从RoI特征学习得到。两个模块均可通过反向传播端到端训练。",
      "anchors": [
        "anc_00024",
        "anc_00025",
        "anc_00026",
        "anc_00027",
        "anc_00039",
        "anc_00048",
        "anc_00050",
        "anc_00051",
        "anc_00054",
        "anc_00056",
        "anc_00058",
        "anc_00061"
      ]
    },
    "experiments": {
      "summary": "在PASCAL VOC和MS COCO数据集上，针对语义分割（DeepLab）和目标检测（Faster R-CNN, R-FCN）任务进行了广泛实验。实验包括消融研究（可变形卷积层数、与空洞卷积对比）、模型复杂度与运行时分析、以及在COCO test-dev上的全面性能对比。",
      "anchors": [
        "anc_00091",
        "anc_00092",
        "anc_00093",
        "anc_00103",
        "anc_00107",
        "anc_00108",
        "anc_00109",
        "anc_00110",
        "anc_00117",
        "anc_00118",
        "anc_00119",
        "anc_00121",
        "anc_00122",
        "anc_00123",
        "anc_00125"
      ]
    },
    "claims": [
      {
        "claim_id": "claim_1",
        "claim": "可变形卷积和RoI池化能有效增强CNN的几何变换建模能力。",
        "anchors": [
          "anc_00003",
          "anc_00005",
          "anc_00091",
          "anc_00107",
          "anc_00119"
        ]
      },
      {
        "claim_id": "claim_2",
        "claim": "学习密集的空间变换对于目标检测和语义分割等复杂视觉任务是有效的。",
        "anchors": [
          "anc_00005",
          "anc_00091",
          "anc_00121",
          "anc_00123"
        ]
      },
      {
        "claim_id": "claim_3",
        "claim": "可变形模块可以即插即用，替换现有CNN中的标准模块，并能通过标准反向传播进行端到端训练。",
        "anchors": [
          "anc_00005",
          "anc_00058",
          "anc_00061"
        ]
      },
      {
        "claim_id": "claim_4",
        "claim": "可变形卷积是空洞卷积的泛化形式。",
        "anchors": [
