{
  "paper_skeleton": {
    "problem": {
      "summary": "实时、无基础设施的密集三维场景重建与跟踪，特别是使用低成本深度相机（如Kinect）在复杂室内环境中实现高精度、无漂移的实时映射。",
      "anchors": [
        "anc_00005",
        "anc_00013"
      ]
    },
    "motivation": {
      "summary": "现有SLAM和SFM/MVS方法要么无法实时运行，要么依赖稀疏特征导致跟踪精度低，要么无法充分利用新型深度传感器（如Kinect）提供的密集、高速数据。需要一种能实时融合所有深度数据、同时进行精确跟踪和密集重建的系统。",
      "anchors": [
        "anc_00005",
        "anc_00007",
        "anc_00013"
      ]
    },
    "core_idea": {
      "summary": "将所有深度数据实时融合到一个全局隐式表面模型（TSDF体积）中，并通过将当前深度帧与该全局模型进行对齐（帧到模型ICP）来同时估计传感器位姿，从而实现无漂移的实时密集重建。",
      "anchors": [
        "anc_00005",
        "anc_00013",
        "anc_00040",
        "anc_00042"
      ]
    },
    "method": {
      "summary": "系统包含四个主要组件：1) 表面测量（从原始深度图生成顶点和法线金字塔）；2) 表面重建（将深度数据融合到TSDF体积中）；3) 表面预测（从TSDF体积进行光线投射以生成预测的顶点和法线图）；4) 跟踪（使用粗到精的ICP算法将当前测量与预测表面对齐以估计传感器位姿）。",
      "anchors": [
        "anc_00058",
        "anc_00060"
      ]
    },
    "experiments": {
      "summary": "在圆形运动实验（转台序列）和自由运动实验中验证系统性能。比较了帧到帧ICP、帧到模型ICP以及重复数据输入（M=4）的效果。展示了实时重建结果、跟踪精度、漂移减少以及系统各组件的实时计时。",
