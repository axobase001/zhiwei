  "formula_ir": {
    "formulas": [
      {
        "formula_id": "formula_001",
        "latex": "F_k(p) = \\frac{W_{k-1}(p)F_{k-1}(p) + W_{R_k}(p)F_{R_k}(p)}{W_{k-1}(p) + W_{R_k}(p)}",
        "variables": [
          {
            "name": "F_k(p)",
            "description": "第k帧融合后，体素p处的TSDF值",
            "confidence": "high",
            "anchors": [
