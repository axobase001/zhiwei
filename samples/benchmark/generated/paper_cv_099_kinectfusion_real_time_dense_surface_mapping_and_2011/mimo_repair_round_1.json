  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "表面测量",
        "label": "Surface Measurement",
        "summary": "预处理阶段，从Kinect原始深度图生成密集的顶点图和法线图金字塔。",
        "description": "输入为Kinect的原始深度图。首先进行双边滤波等预处理以减少噪声。然后，对于每个像素u，通过相机内参K反投影得到3D点p_k。接着，计算该点的法线（通过邻域差分）。最后，构建L=3层的多尺度金字塔表示，用于后续的粗到精跟踪。",
        "type": "preprocessing",
        "anchors": [
          "anc_00058",
          "anc_00094"
        ]
      },
      {
        "node_id": "node_002",
        "title": "表面重建（TSDF融合）",
        "label": "Surface Reconstruction (TSDF Fusion)",
        "summary": "将当前深度帧的数据融合到全局TSDF体积中，更新隐式表面模型。",
        "description": "给定当前帧的位姿估计T_{g,k}，将深度数据投影到TSDF体积中。对于体积中的每个体素p，计算其到传感器测量表面的有符号距离（SDF），并截断到±μ范围内（TSDF）。然后，使用加权平均方案（公式12, 13）将新的TSDF值F_{R_k}(p)和权重W_{R_k}(p)与历史值F_{k-1}(p)和W_{k-1}(p)融合，得到更新后的F_k(p)和W_k(p)。权重可以基于法线与视线的夹角等因素。",
        "type": "mapping",
        "anchors": [
          "anc_00062",
          "anc_00086",
          "anc_00088",
          "anc_00102",
          "anc_00104",
          "anc_00106",
          "anc_00108",
          "anc_00118",
          "anc_00124",
          "anc_00126",
          "anc_00127",
          "anc_00131",
          "anc_00133"
        ]
      },
      {
        "node_id": "node_003",
        "title": "表面预测（光线投射）",
        "label": "Surface Prediction (Raycasting)",
        "summary": "从当前TSDF体积中渲染出预测的顶点图和法线图，用于跟踪。",
        "description": "从虚拟相机（位姿为T_{g,k}）出发，对每个像素发射一条光线。沿着光线在TSDF体积中行进，寻找零交叉点（F_k(p)=0），即表面。在表面点处，通过有限差分计算法线。为了加速，采用了空间跳跃技术（利用TSDF的截断距离μ）和基于最小/最大值的块加速结构。最终输出预测的顶点图V_{k-1}和法线图N_{k-1}。",
        "type": "prediction",
        "anchors": [
          "anc_00141",
          "anc_00143",
          "anc_00145",
          "anc_00147",
          "anc_00149",
          "anc_00151",
          "anc_00152",
          "anc_00159",
          "anc_00160",
          "anc_00161",
          "anc_00163",
          "anc_00165",
          "anc_00167"
        ]
      },
      {
        "node_id": "node_004",
        "title": "跟踪（帧到模型ICP）",
        "label": "Tracking (Frame-to-Model ICP)",
        "summary": "使用粗到精的ICP算法，将当前测量的顶点/法线与预测的表面对齐，以估计当前帧的传感器位姿。",
        "description": "输入为当前帧的测量顶点图V_k和法线图N_k，以及预测的顶点图V_{k-1}和法线图N_{k-1}。在L=3层金字塔上，从粗到精迭代。在每一层，对于每个有效测量点u，通过投影找到其在预测图上的对应点û（数据关联）。然后，最小化点到平面的距离误差（公式16, 23），构建一个6x6线性系统（公式21, 25）求解增量位姿变换T_{inc}。迭代直到收敛或达到最大迭代次数z_max。最终输出当前帧的位姿T_{g,k}。",
        "type": "tracking",
        "anchors": [
