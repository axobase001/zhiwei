            ]
          },
          {
            "name": "F_{k-1}(p)",
            "description": "第k-1帧融合后，体素p处的TSDF值",
            "confidence": "high",
            "anchors": [
              "anc_00127"
            ]
          },
          {
            "name": "F_{R_k}(p)",
            "description": "第k帧传感器测量在体素p处计算得到的TSDF值",
            "confidence": "high",
            "anchors": [
              "anc_00127"
            ]
          },
          {
            "name": "W_{k-1}(p)",
            "description": "第k-1帧融合后，体素p处的累积权重",
            "confidence": "high",
            "anchors": [
              "anc_00127"
            ]
          },
          {
            "name": "W_{R_k}(p)",
            "description": "第k帧传感器测量在体素p处对应的权重",
            "confidence": "high",
            "anchors": [
              "anc_00127"
            ]
          }
        ],
        "dependencies": [],
        "intuition": "这是TSDF体积融合的核心公式。它将当前帧的测量值F_{R_k}(p)与历史融合值F_{k-1}(p)进行加权平均，权重反映了测量的置信度（例如，基于法线与视线的夹角）。这实现了对多帧深度数据的平滑融合和去噪。",
        "anchors": [
          "anc_00127"
        ]
      },
      {
        "formula_id": "formula_002",
        "latex": "W_k(p) \\leftarrow \\min(W_{k-1}(p) + W_{R_k}(p), W_{\\eta})",
        "variables": [
          {
            "name": "W_k(p)",
            "description": "更新后的累积权重",
            "confidence": "high",
            "anchors": [
              "anc_00133"
            ]
          },
          {
            "name": "W_{\\eta}",
            "description": "权重上限，防止权重无限增长",
            "confidence": "medium",
            "anchors": [
              "anc_00133"
            ]
          }
        ],
        "dependencies": [],
        "intuition": "权重更新公式。累积权重随着新测量的加入而增加，但有一个上限W_η。这确保了旧测量的影响会逐渐饱和，系统更倾向于近期的测量，有助于适应场景变化。",
        "anchors": [
          "anc_00133"
        ]
      },
      {
        "formula_id": "formula_003",
        "latex": "\\min_{\\mathbf{x}} \\sum_{u} \\left( \\hat{\\mathbf{N}}_{k-1}(\\hat{u})^\\top ( \\mathbf{G}(u)\\mathbf{x} + \\tilde{\\mathbf{V}}_{k}^g(u) - \\hat{\\mathbf{V}}_{k-1}^g(\\hat{u}) ) \\right)^2",
        "variables": [
          {
            "name": "\\mathbf{x}",
            "description": "待求解的增量位姿变换参数向量（6自由度）",
            "confidence": "high",
            "anchors": [
              "anc_00215"
            ]
