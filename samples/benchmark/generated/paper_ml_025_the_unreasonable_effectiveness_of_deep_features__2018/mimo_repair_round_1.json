{
  "paper_skeleton": {
    "problem": {
      "summary": "传统图像质量评估指标（如PSNR、SSIM）是简单的浅层函数，无法捕捉人类感知的细微差别，导致与人类视觉判断不一致。",
      "anchors": [
        "anc_00007",
        "anc_00015",
        "anc_00016",
        "anc_00017"
      ]
    },
    "motivation": {
      "summary": "尽管深度学习社区发现VGG网络特征在图像合成任务中作为“感知损失”非常有效，但这些“感知损失”究竟有多“感知”？哪些因素对其成功至关重要？需要系统评估深度特征作为感知度量的有效性。",
      "anchors": [
        "anc_00007",
        "anc_00024"
      ]
    },
    "core_idea": {
      "summary": "深度视觉表征（即使来自不同架构和监督类型）具有作为感知度量的涌现特性，能够比传统指标更好地与人类感知判断对齐。",
      "anchors": [
        "anc_00009",
        "anc_00029",
        "anc_00030"
      ]
    },
    "method": {
      "summary": "1. 收集大规模人类感知相似性判断数据集（BAPPS）。2. 系统评估不同深度网络（监督、自监督、无监督）的特征空间作为感知度量。3. 通过线性校准（lin）、微调（tune）或从头训练（scratch）来优化深度特征以匹配人类判断。",
      "anchors": [
        "anc_00035",
        "anc_00036",
        "anc_00037",
        "anc_00049",
        "anc_00090",
        "anc_00091",
        "anc_00094",
        "anc_00097"
      ]
    },
    "experiments": {
      "summary": "在BAPPS数据集（包含传统失真、CNN失真和真实算法输出）上评估多种深度网络和传统指标，并与人类判断进行比较。同时评估在TID2013等现有数据集上的表现。",
      "anchors": [
        "anc_00093",
        "anc_00094",
        "anc_00100",
