  "glossary": {
    "terms": [
      {
        "term": "感知度量",
        "definition": "一种旨在衡量两幅图像在人类视觉感知上相似程度的函数或指标。",
        "anchors": [
          "anc_00007",
          "anc_00017"
        ],
        "appears_in": [
          "anc_00007",
          "anc_00017"
        ]
      },
      {
        "term": "感知损失",
        "definition": "在深度学习中，使用预训练深度网络（如VGG）的内部激活作为特征空间，在该空间中计算距离（如ℓ2距离）作为训练图像合成任务的损失函数。",
        "anchors": [
          "anc_00007",
          "anc_00024"
        ],
        "appears_in": [
          "anc_00007",
          "anc_00024"
        ]
      },
      {
        "term": "BAPPS数据集",
        "definition": "Berkeley-Adobe Perceptual Patch Similarity数据集，本文提出的大规模人类感知相似性判断数据集，包含传统失真、CNN失真和真实算法输出。",
        "anchors": [
          "anc_00035",
          "anc_00036",
          "anc_00037"
        ],
        "appears_in": [
          "anc_00035",
          "anc_00036",
          "anc_00037"
        ]
      },
      {
        "term": "2AFC",
        "definition": "二选一强制选择任务，给定一个参考图像块和两个失真图像块，要求人类判断哪一个更相似。",
        "anchors": [
          "anc_00049",
          "anc_00084"
        ],
        "appears_in": [
          "anc_00049",
          "anc_00084"
        ]
      },
      {
        "term": "JND",
        "definition": "最小可觉察差异任务，给定一个参考图像块和一个失真图像块，要求人类判断它们是否相同。",
        "anchors": [
          "anc_00083",
          "anc_00084",
          "anc_00085"
        ],
        "appears_in": [
          "anc_00083",
          "anc_00084",
          "anc_00085"
        ]
      },
      {
        "term": "LPIPS",
        "definition": "Learned Perceptual Image Patch Similarity，本文提出的基于深度特征校准的感知度量方法。",
        "anchors": [
          "anc_00100",
          "anc_00161",
          "anc_00162"
        ],
        "appears_in": [
          "anc_00100",
          "anc_00161",
          "anc_00162"
        ]
      },
      {
        "term": "涌现属性",
        "definition": "指深度视觉表征在训练用于其他任务（如分类）时，意外地获得了与人类感知相似性判断良好对齐的特性。",
        "anchors": [
          "anc_00009",
          "anc_00029",
          "anc_00030"
        ],
        "appears_in": [
          "anc_00009",
          "anc_00029",
          "anc_00030"
        ]
      }
    ]
  },
