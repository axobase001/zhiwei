  "formula_ir": {
    "formulas": [
      {
        "formula_id": "formula_001",
        "formula": "d(x, x') = \\sum_{l} \\frac{1}{H_l W_l} \\sum_{h,w} || w_l \\odot (\\hat{y}_{hw}^l - \\hat{y}_{hw}'^l) ||_2^2",
        "variables": [
          {
            "name": "d(x, x')",
            "description": "两个图像块x和x'之间的感知距离。",
            "confidence": "high",
            "anchors": [
              "anc_00096"
            ]
          },
          {
            "name": "l",
            "description": "网络层索引。",
            "confidence": "high",
            "anchors": [
              "anc_00094",
              "anc_00097"
            ]
          },
          {
            "name": "H_l, W_l",
            "description": "第l层特征图的高度和宽度。",
            "confidence": "high",
            "anchors": [
              "anc_00094"
            ]
          },
          {
            "name": "\\hat{y}_{hw}^l, \\hat{y}_{hw}'^l",
            "description": "在第l层空间位置(h,w)处，对图像块x和x'提取的、经过通道维度单位归一化的特征向量。",
            "confidence": "high",
            "anchors": [
              "anc_00094"
            ]
          },
          {
            "name": "w_l",
            "description": "第l层的通道权重向量，用于缩放特征距离。",
            "confidence": "high",
            "anchors": [
              "anc_00094",
              "anc_00097"
            ]
          },
          {
            "name": "\\odot",
            "description": "逐元素乘法。",
            "confidence": "high",
            "anchors": [
              "anc_00094"
            ]
          }
        ],
        "dependencies": [],
        "intuition": "该公式计算两个图像块在深度网络多层特征空间中的加权欧氏距离。通过单位归一化和可学习权重，使距离度量更符合人类感知判断。当所有w_l=1时，等价于余弦距离。",
        "anchors": [
          "anc_00090",
          "anc_00091",
          "anc_00094",
          "anc_00095",
          "anc_00096",
