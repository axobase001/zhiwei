{
  "paper_skeleton": {
    "problem": {
      "summary": "将Transformer从语言领域迁移到视觉领域面临挑战，包括视觉实体尺度变化大、图像分辨率高导致计算复杂度高（二次复杂度），且现有Transformer模型产生的特征图分辨率单一，不适合密集预测任务。",
      "anchors": [
        "anc_00003",
        "anc_00005",
        "anc_00010",
        "anc_00011",
        "anc_00012",
        "anc_00013",
        "anc_00014"
      ]
    },
    "motivation": {
      "summary": "CNN长期主导计算机视觉建模，但Transformer在NLP中取得巨大成功，有望成为视觉领域的通用骨干网络。需要解决视觉与语言模态间的差异，特别是尺度变化和计算效率问题。",
      "anchors": [
        "anc_00008",
        "anc_00009",
        "anc_00012",
        "anc_00017"
      ]
    },
    "core_idea": {
      "summary": "提出Swin Transformer，一种基于移位窗口的层次化视觉Transformer。通过在非重叠的局部窗口内计算自注意力实现线性计算复杂度，并通过移位窗口机制实现跨窗口连接，构建层次化特征图以适应多种视觉任务。",
      "anchors": [
        "anc_00003",
        "anc_00005",
        "anc_00010",
        "anc_00011",
        "anc_00013",
        "anc_00014",
        "anc_00015",
        "anc_00016"
      ]
    },
    "method": {
      "summary": "1. 将图像分割为4×4的patch，通过线性嵌入层投影到C维。2. 构建层次化结构：Stage 1保持分辨率，后续Stage通过patch merging层进行2倍下采样并增加通道数。3. 在每个Stage中应用Swin Transformer块，包含基于窗口的多头自注意力（W-MSA）和移位窗口自注意力（SW-MSA）。4. SW-MSA通过将窗口分区移位(⌊M/2⌋, ⌊M/2⌋)像素实现跨窗口连接。5. 使用相对位置偏置增强注意力计算。",
      "anchors": [
        "anc_00024",
        "anc_00025",
        "anc_00026",
        "anc_00027",
        "anc_00028",
        "anc_00029",
        "anc_00030",
