  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "Patch Partition & Linear Embedding",
        "label": "输入处理",
        "summary": "将输入图像分割为4×4的patch，并通过线性嵌入层投影到C维特征空间。",
        "description": "输入图像尺寸为H×W×3，被分割成H/4 × W/4个patch，每个patch的原始值特征维度为4×4×3=48。应用线性嵌入层将其投影到任意维度C。这是Stage 1的开始。",
        "type": "input_processing",
        "anchors": [
          "anc_00024",
          "anc_00025"
        ]
      },
      {
        "node_id": "node_002",
        "title": "Hierarchical Feature Map Construction",
        "label": "层次化特征图构建",
        "summary": "通过多个Stage逐步降低分辨率、增加通道数，构建层次化特征图。",
        "description": "Stage 1保持H/4 × W/4分辨率。Stage 2通过patch merging层将2×2相邻patch特征拼接，应用线性层将4C维特征映射到2C维，分辨率降为H/8 × W/8。类似地构建Stage 3（H/16 × W/16）和Stage 4（H/32 × W/32）。这产生了与典型CNN（如VGG、ResNet）相同的多尺度特征图。",
        "type": "architecture",
        "anchors": [
          "anc_00025",
          "anc_00026",
          "anc_00027",
          "anc_00030"
        ]
      },
      {
        "node_id": "node_003",
        "title": "Swin Transformer Block",
        "label": "核心变换模块",
        "summary": "Swin Transformer的基本构建块，包含基于窗口的自注意力模块和MLP模块。",
        "description": "每个Swin Transformer块由两个连续子块组成：第一个子块使用常规窗口分区的W-MSA，第二个子块使用移位窗口分区的SW-MSA。每个子块包含层归一化（LN）和残差连接。具体计算见公式(3)。",
        "type": "core_module",
        "anchors": [
          "anc_00028",
          "anc_00029",
          "anc_00030",
          "anc_00038",
          "anc_00040",
          "anc_00042",
          "anc_00044",
          "anc_00045"
        ]
      },
      {
        "node_id": "node_004",
        "title": "Window-based Multi-head Self-Attention (W-MSA)",
        "label": "窗口自注意力",
        "summary": "在非重叠的局部窗口内计算自注意力，实现线性计算复杂度。",
        "description": "将特征图划分为多个不重叠的M×M窗口（默认M=7），在每个窗口内独立计算自注意力。计算复杂度为Ω(W-MSA) = 4hwC² + 2M²hwC，相对于patch数量hw是线性的。",
        "type": "attention_mechanism",
        "anchors": [
          "anc_00031",
          "anc_00032",
          "anc_00033",
          "anc_00034"
        ]
      },
      {
        "node_id": "node_005",
        "title": "Shifted Window Partitioning",
        "label": "移位窗口机制",
        "summary": "在连续的Swin Transformer块之间交替使用常规和移位窗口分区，以实现跨窗口连接。",
        "description": "在层l使用常规窗口分区，在层l+1将窗口分区移位(⌊M/2⌋, ⌊M/2⌋)像素。移位后的窗口跨越前一层窗口的边界，从而建立跨窗口连接。这通过高效的批量计算实现，包括循环移位和掩码自注意力。",
        "type": "key_innovation",
        "anchors": [
          "anc_00035",
          "anc_00036",
          "anc_00037",
          "anc_00048",
          "anc_00049",
          "anc_00050"
        ]
      },
      {
        "node_id": "node_006",
        "title": "Relative Position Bias",
        "label": "相对位置偏置",
        "summary": "在自注意力计算中引入相对位置偏置矩阵，增强位置信息建模。",
        "description": "注意力计算公式为Attention(Q,K,V) = SoftMax(QKᵀ/√d + B)V，其中B是相对位置偏置矩阵。偏置矩阵B的值从一个较小尺寸的参数矩阵B̂∈R^(2M-1)×(2M-1)中获取。实验表明相对位置偏置比绝对位置嵌入更有效。",
        "type": "attention_enhancement",
        "anchors": [
          "anc_00051",
          "anc_00052"
        ]
      },
      {
        "node_id": "node_007",
        "title": "Model Variants",
        "label": "模型变体",
        "summary": "定义了不同容量的Swin Transformer变体：Swin-T、Swin-S、Swin-B、Swin-L。",
        "description": "所有变体默认窗口大小M=7，查询维度d=32，MLP扩展层α=4。具体超参数：Swin-T: C=96, 层数={2,2,6,2}；Swin-S: C=96, 层数={2,2,18,2}；Swin-B: C=128, 层数={2,2,18,2}；Swin-L: C=192, 层数={2,2,18,2}。",
        "type": "model_config",
        "anchors": [
          "anc_00053",
          "anc_00054",
          "anc_00055",
          "anc_00056",
          "anc_00057",
          "anc_00058",
          "anc_00059",
          "anc_00060"
        ]
      }
    ],
