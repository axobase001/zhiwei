{
  "paper_skeleton": {
    "problem": {
      "summary": "传统特征金字塔在深度学习目标检测中因计算和内存开销大而被避免使用，导致多尺度目标检测性能受限。",
      "anchors": [
        "anc_00005",
        "anc_00006",
        "anc_00007"
      ]
    },
    "motivation": {
      "summary": "深度卷积网络本身具有多尺度、金字塔式的层次结构，但现有方法未能充分利用这一特性来构建高效的特征金字塔。",
      "anchors": [
        "anc_00014",
        "anc_00015",
        "anc_00016"
      ]
    },
    "core_idea": {
      "summary": "提出特征金字塔网络（FPN），通过自顶向下架构和横向连接，以边际额外成本构建所有尺度的高级语义特征图。",
      "anchors": [
        "anc_00005",
        "anc_00006",
        "anc_00007",
        "anc_00022",
        "anc_00023"
      ]
    },
    "method": {
      "summary": "FPN包含自底向上路径（骨干网络前向计算）、自顶向下路径（上采样高层特征）和横向连接（融合低层细节特征），并应用于RPN和Fast R-CNN。",
      "anchors": [
        "anc_00023",
        "anc_00026",
        "anc_00029",
        "anc_00031",
        "anc_00032",
        "anc_00036",
