  "glossary": {
    "terms": [
      {
        "term": "特征金字塔网络 (FPN)",
        "definition": "一种通过自顶向下路径和横向连接，在深度卷积网络中构建多尺度特征金字塔的架构。",
        "anchors": [
          "anc_00007"
        ],
        "appears_in": [
          "anc_00007"
        ]
      },
      {
        "term": "自底向上路径",
        "definition": "骨干卷积网络的前向计算过程，生成多尺度特征图层次结构。",
        "anchors": [
          "anc_00023"
        ],
        "appears_in": [
          "anc_00023"
        ]
      },
      {
        "term": "自顶向下路径",
        "definition": "通过上采样高层特征图并融合低层特征，生成高分辨率强语义特征图的过程。",
        "anchors": [
          "anc_00023"
        ],
        "appears_in": [
          "anc_00023"
        ]
      },
      {
        "term": "横向连接",
        "definition": "连接自底向上路径和自顶向下路径的结构，通常使用1×1卷积减少通道维度后相加。",
        "anchors": [
          "anc_00022",
          "anc_00023"
        ],
        "appears_in": [
          "anc_00022",
          "anc_00023"
        ]
      },
      {
        "term": "锚框 (Anchors)",
        "definition": "在RPN中预定义的参考框，具有多种尺度和长宽比，用于覆盖不同形状的目标。",
        "anchors": [
          "anc_00039",
          "anc_00040"
        ],
        "appears_in": [
          "anc_00039",
          "anc_00040"
        ]
      },
      {
        "term": "RoI池化",
        "definition": "在Fast R-CNN中，将不同大小的区域提议（RoI）映射到固定大小特征图的操作。",
        "anchors": [
          "anc_00042"
        ],
        "appears_in": [
          "anc_00042"
        ]
      },
      {
        "term": "COCO基准",
        "definition": "一个大规模的目标检测、分割和关键点估计基准数据集。",
        "anchors": [
          "anc_00007",
          "anc_00091"
        ],
        "appears_in": [
          "anc_00007",
          "anc_00091"
        ]
      }
    ]
  },
