  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "自底向上路径",
        "label": "Bottom-up Pathway",
        "summary": "骨干卷积网络的前向计算过程，生成具有不同分辨率的多尺度特征图层次结构。",
        "description": "自底向上路径是骨干网络（如ResNet）的前向传播，计算特征层次结构，包含多个尺度的特征图，缩放步长为2。通常选择每个阶段最后一层的输出作为特征图集合，例如ResNet的{C2, C3, C4, C5}层。",
        "type": "feature_extraction",
        "anchors": [
          "anc_00023"
        ]
      },
      {
        "node_id": "node_002",
        "title": "自顶向下路径与横向连接",
        "label": "Top-down Pathway and Lateral Connections",
        "summary": "通过上采样高层特征并与低层特征横向连接，生成具有强语义信息的高分辨率特征图。",
        "description": "自顶向下路径通过最近邻上采样将高层特征图的空间分辨率放大2倍。横向连接使用1×1卷积层减少自底向上特征图的通道维度，然后通过逐元素相加与上采样后的特征图融合。融合后使用3×3卷积生成最终特征图以减少上采样混叠效应。",
        "type": "feature_fusion",
        "anchors": [
          "anc_00022",
          "anc_00023",
          "anc_00026",
          "anc_00029",
          "anc_00031",
          "anc_00032"
        ]
      },
      {
        "node_id": "node_003",
        "title": "FPN应用于RPN",
        "label": "FPN for RPN",
        "summary": "将FPN作为RPN的输入特征金字塔，为每个金字塔层级分配单尺度锚框。",
        "description": "将RPN的单尺度特征图替换为FPN生成的特征金字塔{P2, P3, P4, P5, P6}。在每个金字塔层级上附加相同设计的预测头（3×3卷积和两个1×1卷积分支）。为每个层级分配单尺度锚框，面积分别为{32², 64², 128², 256², 512²}像素，对应层级{P2, P3, P4, P5, P6}。",
        "type": "application",
        "anchors": [
          "anc_00036",
          "anc_00037",
          "anc_00039",
          "anc_00040",
          "anc_00041"
        ]
      },
      {
        "node_id": "node_004",
        "title": "FPN应用于Fast R-CNN",
        "label": "FPN for Fast R-CNN",
        "summary": "将不同尺度的RoI分配到FPN的相应金字塔层级进行特征提取和预测。",
        "description": "将FPN特征金字塔视为图像金字塔的近似。根据公式 k = ⌊k₀ + log₂(√(wh)/224)⌋ 将宽度为w、高度为h的RoI映射到金字塔层级k，其中k₀=4。在所有层级的RoI上附加共享参数的预测头（两个1024维全连接层）进行分类和边界框回归。",
        "type": "application",
        "anchors": [
          "anc_00042",
          "anc_00043",
          "anc_00045",
          "anc_00046",
          "anc_00048",
          "anc_00051"
        ]
      },
      {
        "node_id": "node_005",
        "title": "FPN应用于分割提案",
        "label": "FPN for Segmentation Proposals",
        "summary": "使用FPN生成密集的分割提案，替代基于图像金字塔的DeepMask/SharpMask方法。",
        "description": "在FPN的每个层级上应用小型MLP（5×5或7×7卷积核）以全卷积方式预测14×14的掩码和对象分数。使用两个不同大小的MLP处理半八度尺度。训练时采用图像中心策略，正负样本采样比例为1:3，掩码损失权重为分数损失的10倍。",
        "type": "application",
        "anchors": [
          "anc_00117",
          "anc_00118",
          "anc_00121",
