  "glossary": {
    "terms": [
      {
        "term": "焦点损失 (Focal Loss)",
        "definition": "一种动态缩放的交叉熵损失函数，通过调制因子 (1-pt)^γ 降低易分类样本的权重，使模型在训练时更关注难分类的样本。",
        "anchors": [
          "anc_00005",
          "anc_00007",
          "anc_00044",
          "anc_00065",
          "anc_00066"
        ],
        "appears_in": [
          "anc_00005",
          "anc_00007",
          "anc_00044",
          "anc_00065",
          "anc_00066"
        ]
      },
      {
        "term": "类别不平衡 (Class Imbalance)",
        "definition": "在单阶段目标检测训练中，前景（目标）样本数量远少于背景（非目标）样本数量的现象，比例可达1:1000。",
        "anchors": [
          "anc_00009",
          "anc_00035",
          "anc_00036",
          "anc_00044"
        ],
        "appears_in": [
          "anc_00009",
          "anc_00035",
          "anc_00036",
          "anc_00044"
        ]
      },
      {
        "term": "RetinaNet",
        "definition": "论文提出的一个单阶段目标检测器，其核心创新是使用焦点损失函数。它由ResNet-FPN骨干网络、分类子网络和边界框回归子网络组成。",
        "anchors": [
          "anc_00011",
          "anc_00024",
          "anc_00033",
          "anc_00089",
          "anc_00105",
