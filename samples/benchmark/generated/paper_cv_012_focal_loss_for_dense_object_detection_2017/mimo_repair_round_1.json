  "formula_ir": {
    "formulas": [
      {
        "formula_id": "formula_001",
        "name": "交叉熵损失 (Cross Entropy Loss)",
        "latex": "CE(p_t) = -\\log(p_t)",
        "variables": [
          {
            "name": "p_t",
            "description": "模型对真实类别的预测概率。当真实标签y=1时，p_t = p；当y=-1时，p_t = 1-p。",
            "confidence": "high",
            "anchors": [
              "anc_00004",
              "anc_00050",
              "anc_00054"
            ]
          }
        ],
        "dependencies": [],
        "intuition": "标准的二元分类损失函数，用于衡量预测概率与真实标签之间的差异。",
        "anchors": [
          "anc_00004",
          "anc_00050",
          "anc_00054"
        ]
      },
      {
        "formula_id": "formula_002",
        "name": "焦点损失 (Focal Loss)",
        "latex": "FL(p_t) = -\\alpha_t (1 - p_t)^\\gamma \\log(p_t)",
        "variables": [
          {
            "name": "p_t",
            "description": "模型对真实类别的预测概率。",
