          "anc_00105"
        ]
      },
      {
        "node_id": "node_003",
        "title": "分类子网络 (Classification Subnet)",
        "label": "目标分类",
        "summary": "对特征金字塔的每一层进行卷积分类，预测每个空间位置的锚框属于各个目标类别的概率。",
        "description": "分类子网络在骨干网络的输出上执行卷积目标分类。对于每个空间位置，有A=9个锚框，每个锚框预测K个类别的分类目标。",
        "type": "classification_subnet",
        "anchors": [
          "anc_00089",
          "anc_00096",
          "anc_00109",
          "anc_00111"
        ]
      },
      {
        "node_id": "node_004",
        "title": "边界框回归子网络 (Box Regression Subnet)",
        "label": "边界框回归",
        "summary": "预测每个锚框与真实边界框之间的偏移量。",
        "description": "边界框回归子网络与分类子网络结构类似，但输出4A个线性值，用于预测每个锚框相对于真实边界框的偏移。该子网络是类别无关的。",
        "type": "regression_subnet",
        "anchors": [
          "anc_00089",
          "anc_00097",
          "anc_00099",
          "anc_00111",
          "anc_00112"
        ]
      },
      {
        "node_id": "node_005",
        "title": "焦点损失 (Focal Loss)",
        "label": "损失函数",
        "summary": "一种动态缩放的交叉熵损失，通过调制因子降低易分类样本的权重，聚焦于难分类样本。",
        "description": "焦点损失定义为 FL(pt) = -αt (1-pt)^γ log(pt)，其中pt是模型对真实类别的预测概率，γ是聚焦参数（γ≥0），αt是平衡因子。当γ=0时，退化为标准的交叉熵损失。",
        "type": "loss_function",
        "anchors": [
          "anc_00005",
          "anc_00007",
          "anc_00044",
          "anc_00065",
          "anc_00066",
          "anc_00069",
          "anc_00071"
        ]
      },
      {
        "node_id": "node_006",
        "title": "模型初始化 (Model Initialization)",
        "label": "训练技巧",
        "summary": "通过设置前景类别的先验概率π（如0.01）来初始化模型，以稳定训练初期。",
        "description": "为了解决类别不平衡导致的训练不稳定问题，论文引入了‘先验’概念，将模型对前景类别的初始预测概率设置为较低的值π（如0.01）。这通过修改分类子网络最后一层卷积的偏置b来实现：b = -log((1-π)/π)。",
        "type": "initialization",
        "anchors": [
          "anc_00081",
          "anc_00082",
          "anc_00084",
          "anc_00085",
          "anc_00122",
          "anc_00123",
          "anc_00125",
          "anc_00135",
          "anc_00137"
        ]
      },
      {
        "node_id": "node_007",
        "title": "推理过程 (Inference)",
        "label": "推理",
        "summary": "在推理时，RetinaNet是一个单一的全卷积网络，对预测结果进行解码并应用非极大值抑制。",
        "description": "推理时，RetinaNet由ResNet-FPN骨干网络、分类子网络和边界框回归子网络组成。预测结果在所有层级上合并，并使用阈值为0.05的非极大值抑制（NMS）来产生最终检测结果。",
        "type": "inference",
        "anchors": [
          "anc_00112",
          "anc_00113"
        ]
      }
