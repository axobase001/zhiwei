{
  "paper_skeleton": {
    "problem": {
      "summary": "单阶段目标检测器在训练时面临严重的前景-背景类别不平衡问题，导致其精度长期落后于两阶段检测器。",
      "anchors": [
        "anc_00009",
        "anc_00012",
        "anc_00035",
        "anc_00036",
        "anc_00038"
      ]
    },
    "motivation": {
      "summary": "两阶段检测器通过候选区域生成和采样启发式方法缓解了类别不平衡，但单阶段检测器需要处理大量密集采样的候选位置（约10万个），其中绝大多数是简单的背景样本，导致训练效率低下且模型可能退化。",
      "anchors": [
        "anc_00014",
        "anc_00016",
        "anc_00018",
        "anc_00020",
        "anc_00036"
      ]
    },
    "core_idea": {
      "summary": "提出一种新的损失函数——焦点损失（Focal Loss），通过动态缩放交叉熵损失，降低易分类样本的权重，使模型在训练时更关注难分类的样本，从而解决单阶段检测器中的类别不平衡问题。",
      "anchors": [
        "anc_00005",
        "anc_00007",
        "anc_00022",
        "anc_00044",
        "anc_00065",
        "anc_00066"
      ]
    },
    "method": {
      "summary": "设计了一个名为RetinaNet的单阶段目标检测器，其核心是使用焦点损失函数。RetinaNet采用特征金字塔网络（FPN）作为骨干网络，并包含分类子网络和边界框回归子网络。",
      "anchors": [
        "anc_00089",
        "anc_00090",
        "anc_00092",
        "anc_00105",
        "anc_00107",
        "anc_00109",
        "anc_00111",
        "anc_00112"
      ]
    },
    "experiments": {
      "summary": "在COCO数据集上进行了广泛的实验，包括消融研究（分析α、γ等超参数）、与在线困难样本挖掘（OHEM）的对比、以及与当时最先进的单阶段和两阶段检测器的比较。",
      "anchors": [
