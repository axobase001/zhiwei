  "glossary": {
    "terms": [
      {
        "term": "CNN",
        "definition": "卷积神经网络，一种深度学习架构，特别适用于图像处理。",
        "anchors": [
          "anc_00003",
          "anc_00005"
        ]
      },
      {
        "term": "迁移学习",
        "definition": "将在一个任务（源任务）上学到的知识应用到另一个相关任务（目标任务）上的机器学习方法。",
        "anchors": [
          "anc_00032",
          "anc_00033",
          "anc_00034"
        ]
      },
      {
        "term": "中间层图像表示",
        "definition": "CNN中卷积层和全连接层提取的特征，这些特征比原始像素更抽象、更具语义信息。",
        "anchors": [
          "anc_00005",
          "anc_00009"
        ]
      },
      {
        "term": "适配层",
        "definition": "在迁移学习中，为了适应目标任务而添加的新层，用于重新映射特征空间。",
        "anchors": [
          "anc_00055",
          "anc_00056",
          "anc_00068",
          "anc_00070",
          "anc_00077",
          "anc_00079"
        ]
      },
      {
        "term": "滑动窗口",
        "definition": "一种目标检测方法，通过在图像上滑动固定大小的窗口来提取图像块并进行分类。",
        "anchors": [
          "anc_00112",
          "anc_00148",
          "anc_00149"
        ]
      },
      {
        "term": "平均精度 (AP)",
