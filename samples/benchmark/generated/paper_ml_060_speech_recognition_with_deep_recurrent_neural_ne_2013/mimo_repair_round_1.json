{
  "paper_skeleton": {
    "problem": {
      "summary": "传统RNN在语音识别任务上的表现不如深度前馈网络，且端到端训练方法（如CTC）在手写识别中成功，但在语音识别中效果有限。",
      "anchors": [
        "anc_00003",
        "anc_00005"
      ]
    },
    "motivation": {
      "summary": "探索深度循环神经网络（Deep RNNs），结合深度网络的多层次表示能力和RNN的长程上下文利用能力，以提升语音识别性能。",
      "anchors": [
        "anc_00003",
        "anc_00005"
      ]
    },
    "core_idea": {
      "summary": "使用深度双向长短期记忆（LSTM）循环神经网络，结合端到端训练（CTC或RNN Transducer）和正则化技术，在TIMIT音素识别基准上实现最优结果。",
      "anchors": [
        "anc_00003",
        "anc_00045",
        "anc_00100"
      ]
    },
    "method": {
      "summary": "提出深度双向LSTM架构，采用CTC和RNN Transducer两种端到端训练方法，并使用早停和权重噪声进行正则化。",
      "anchors": [
        "anc_00045",
        "anc_00049",
        "anc_00064",
        "anc_00092"
      ]
    },
    "experiments": {
      "summary": "在TIMIT音素识别数据集上评估多种RNN配置（不同层数、单元类型、训练方法），比较音素错误率（PER）。",
      "anchors": [
        "anc_00093",
        "anc_00095",
        "anc_00100",
        "anc_00102"
      ]
    },
    "claims": [
      {
        "claim_id": "claim_1",
        "claim": "深度LSTM RNNs在TIMIT上达到17.7%的测试集错误率，为当时最佳记录；深度比层大小更重要；LSTM优于tanh和单向LSTM；预训练的RNN Transducer表现更好。",
        "anchors": [
          "anc_00100",
          "anc_00102"
        ]
      }
    ],
    "limitations": [
      {
        "limitation": "实验仅运行一次，随机初始化和权重噪声的方差未知；未扩展到大词汇量语音识别；未结合卷积神经网络。",
        "anchors": [
          "anc_00095",
          "anc_00105",
          "anc_00106"
        ]
      }
    ]
  },
