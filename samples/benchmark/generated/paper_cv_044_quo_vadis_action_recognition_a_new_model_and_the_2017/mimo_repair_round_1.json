{
  "paper_skeleton": {
    "problem": {
      "summary": "现有动作识别数据集（如UCF-101和HMDB-51）规模过小，导致难以区分不同视频架构的性能优劣，且现有模型在小规模基准上表现相似。",
      "anchors": [
        "anc_00003",
        "anc_00011",
        "anc_00012",
        "anc_00013"
      ]
    },
    "motivation": {
      "summary": "需要一个大规模、真实且具有挑战性的视频数据集来重新评估现有架构，并探索视频预训练对动作识别任务的价值。",
      "anchors": [
        "anc_00003",
        "anc_00007",
        "anc_00011",
        "anc_00012",
        "anc_00013"
      ]
    },
    "core_idea": {
      "summary": "提出一个新的大规模Kinetics数据集，并引入一种新的Two-Stream Inflated 3D ConvNet (I3D)模型，该模型通过将成功的2D图像分类网络（如Inception-v1）的滤波器和池化核扩展到3D，从而利用ImageNet架构设计和参数，学习无缝的时空特征提取器。",
      "anchors": [
        "anc_00003",
        "anc_00011",
        "anc_00012",
        "anc_00013",
        "anc_00023",
        "anc_00024",
        "anc_00025",
        "anc_00033"
      ]
    },
    "method": {
      "summary": "1. 构建Kinetics数据集（400类，每类400+片段）。2. 重新实现并评估多种现有架构（ConvNet+LSTM, 3D-ConvNet, Two-Stream, 3D-Fused）。3. 提出I3D模型：通过将2D滤波器和池化核“膨胀”为3D，并采用双流配置（RGB和光流）。4. 在Kinetics上预训练I3D模型，然后在UCF-101和HMDB-51上微调。",
      "anchors": [
        "anc_00003",
        "anc_00011",
