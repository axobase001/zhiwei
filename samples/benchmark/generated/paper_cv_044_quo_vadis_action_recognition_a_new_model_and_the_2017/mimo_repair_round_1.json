  "glossary": {
    "terms": [
      {
        "term": "Kinetics",
        "definition": "本文提出的大规模人类动作视频数据集，包含400个类别，每类超过400个片段，总训练视频约24万。",
        "anchors": [
          "anc_00003",
          "anc_00011",
          "anc_00012",
          "anc_00013",
          "anc_00043"
        ],
        "appears_in": [
          "anc_00003",
          "anc_00011",
          "anc_00012",
          "anc_00013",
          "anc_00043"
        ]
      },
      {
        "term": "I3D (Inflated 3D ConvNet)",
        "definition": "本文提出的模型，通过将2D ConvNet（如Inception-v1）的滤波器和池化核膨胀到3D，并采用双流配置（RGB和光流）来处理视频。",
        "anchors": [
          "anc_00022",
          "anc_00023",
          "anc_00033",
          "anc_00039"
        ],
        "appears_in": [
          "anc_00022",
          "anc_00023",
          "anc_00033",
          "anc_00039"
        ]
      },
      {
        "term": "膨胀 (Inflation)",
        "definition": "将2D卷积滤波器或池化核扩展一个时间维度（例如，从k×k变为t×k×k）的操作，通常使用2D权重沿时间维度复制进行初始化。",
        "anchors": [
          "anc_00023",
          "anc_00024",
          "anc_00025"
        ],
        "appears_in": [
          "anc_00023",
          "anc_00024",
          "anc_00025"
        ]
      },
      {
        "term": "双流 (Two-Stream)",
        "definition": "一种视频分类架构范式，使用两个独立的网络分支分别处理RGB图像和光流图像，然后融合它们的预测。",
        "anchors": [
          "anc_00022",
          "anc_00027",
          "anc_00033"
        ],
        "appears_in": [
          "anc_00022",
          "anc_00027",
          "anc_00033"
        ]
      },
      {
        "term": "无聊视频固定点 (Boring Video Fixed Point)",
        "definition": "一个设计原则，指对于内容不变（如静态场景）的视频，网络的输出应保持不变。这指导了膨胀操作中非线性层和池化层的设计。",
        "anchors": [
          "anc_00024",
          "anc_00025"
        ],
        "appears_in": [
          "anc_00024",
          "anc_00025"
        ]
      },
      {
        "term": "预训练 (Pre-training)",
        "definition": "在大型数据集（如ImageNet或Kinetics）上训练模型以学习通用特征表示，然后将其用于初始化下游任务模型的过程。",
        "anchors": [
          "anc_00007",
          "anc_00014",
          "anc_00036",
          "anc_00054",
          "anc_00057",
          "anc_00058"
        ],
