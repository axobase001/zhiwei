{
  "paper_skeleton": {
    "problem": {
      "summary": "现有面部识别方法在大规模场景下实现高效验证和识别面临挑战，传统深度学习方法依赖中间瓶颈层表示，效率低且泛化能力有限。",
      "anchors": [
        "anc_00003",
        "anc_00011",
        "anc_00012"
      ]
    },
    "motivation": {
      "summary": "需要一种直接学习面部图像到紧凑欧氏空间映射的方法，使距离直接对应面部相似性，从而简化识别、验证和聚类任务。",
      "anchors": [
        "anc_00003",
        "anc_00011"
      ]
    },
    "core_idea": {
      "summary": "提出FaceNet系统，通过深度卷积网络直接优化嵌入表示，使用三元组损失函数训练，学习128维紧凑嵌入，实现高效面部识别。",
      "anchors": [
        "anc_00003",
        "anc_00005",
        "anc_00014",
        "anc_00035"
      ]
    },
    "method": {
      "summary": "使用深度卷积网络（Zeiler&Fergus或Inception架构）训练，采用三元组损失函数，通过在线三元组挖掘策略选择难样本，直接优化嵌入空间。",
      "anchors": [
        "anc_00023",
        "anc_00025",
        "anc_00035",
        "anc_00047",
        "anc_00048",
        "anc_00050",
        "anc_00060",
        "anc_00062"
      ]
    },
    "experiments": {
      "summary": "在LFW、YouTube Faces DB等数据集上评估，比较不同网络架构、嵌入维度、训练数据规模的影响，展示聚类效果。",
      "anchors": [
        "anc_00098",
        "anc_00109",
        "anc_00119",
        "anc_00123",
        "anc_00126",
        "anc_00133",
        "anc_00135",
        "anc_00143",
        "anc_00148",
        "anc_00149",
        "anc_00150"
      ]
    },
