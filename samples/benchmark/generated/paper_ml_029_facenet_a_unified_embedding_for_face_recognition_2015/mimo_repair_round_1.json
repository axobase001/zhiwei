    "paper_id": "paper_ml_029_facenet_a_unified_embedding_for_face_recognition_2015",
    "title": "FaceNet: A unified embedding for face recognition and clustering",
    "authors": [
      "Florian Schroff",
      "Dmitry Kalenichenko",
      "James Philbin"
    ],
    "venue": "Computer Vision and Pattern Recognition",
    "year": 2015,
