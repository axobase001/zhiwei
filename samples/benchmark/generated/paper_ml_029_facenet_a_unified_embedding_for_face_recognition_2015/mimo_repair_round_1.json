  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "输入预处理",
        "label": "数据预处理",
        "summary": "对输入图像进行人脸检测和裁剪，生成紧贴人脸区域的缩略图，调整到网络输入尺寸。",
        "description": "运行人脸检测器，生成紧贴人脸的边界框，将缩略图调整到网络输入尺寸（96x96到224x224像素）。",
        "type": "preprocessing",
        "anchors": [
          "anc_00109"
        ]
      },
      {
        "node_id": "node_002",
        "title": "深度卷积网络",
        "label": "特征提取网络",
        "summary": "使用深度卷积网络提取面部特征，支持Zeiler&Fergus和Inception两种架构。",
        "description": "网络架构包括：1) Zeiler&Fergus风格网络，添加1x1卷积层，22层深，1.4亿参数；2) Inception模型，参数减少20倍，FLOPS减少5倍。",
        "type": "neural_network",
        "anchors": [
          "anc_00023",
          "anc_00024",
          "anc_00025",
          "anc_00094",
          "anc_00095"
        ]
      },
      {
        "node_id": "node_003",
        "title": "L2归一化",
        "label": "嵌入归一化",
        "summary": "对网络输出进行L2归一化，将嵌入映射到超球面上。",
        "description": "网络输出经过L2归一化，使得嵌入位于d维超球面上，即∥f(x)∥2=1。",
        "type": "normalization",
        "anchors": [
          "anc_00042"
        ]
      },
      {
        "node_id": "node_004",
        "title": "三元组损失",
        "label": "损失函数",
        "summary": "使用三元组损失函数直接优化嵌入空间，使同类样本距离小，异类样本距离大。",
        "description": "损失函数L = Σ[∥f(xa_i) - f(xp_i)∥² - ∥f(xa_i) - f(xn_i)∥² + α]+，其中α是边距（设为0.2）。",
        "type": "loss_function",
        "anchors": [
          "anc_00044",
          "anc_00046",
          "anc_00047",
          "anc_00084"
        ]
      },
      {
        "node_id": "node_005",
        "title": "在线三元组挖掘",
        "label": "样本选择策略",
        "summary": "采用在线三元组挖掘策略选择难样本，确保训练收敛和性能。",
        "description": "在mini-batch内选择难正样本（argmax∥f(xa)-f(xp)∥²）和难负样本（argmin∥f(xa)-f(xn)∥²），使用半难负样本避免模型坍塌。",
        "type": "training_strategy",
        "anchors": [
          "anc_00048",
          "anc_00050",
          "anc_00052",
          "anc_00060",
          "anc_00062",
          "anc_00075",
          "anc_00076",
          "anc_00078"
        ]
      },
      {
        "node_id": "node_006",
        "title": "嵌入输出",
        "label": "特征表示",
        "summary": "输出128维紧凑嵌入向量，可用于面部验证、识别和聚类。",
        "description": "网络输出128维嵌入向量，可量化为128字节，用于后续任务。",
        "type": "output",
        "anchors": [
          "anc_00005",
