        ]
      },
      {
        "node_id": "node_004",
        "title": "联合损失函数",
        "label": "多任务损失",
        "summary": "结合兴趣点检测损失和描述子匹配损失，通过单应性变换建立对应关系进行自监督训练。",
        "description": "兴趣点损失为交叉熵损失，描述子损失为铰链损失（正负边距分别为1和0.2），权重λd=250，总损失权重λ=0.0001。训练使用Adam优化器，学习率0.001。",
        "type": "loss_function",
        "anchors": [
