  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "合成数据预训练",
        "label": "MagicPoint训练",
        "summary": "在Synthetic Shapes数据集上训练基础兴趣点检测器MagicPoint，该数据集包含简单几何形状的精确角点标签。",
        "description": "使用全卷积网络在合成数据上训练，数据在线生成，包含三角形、四边形、线条、立方体、棋盘格和星形等类别。训练200,000次迭代，网络架构为SuperPoint的检测头部分。",
        "type": "training_stage",
        "anchors": [
          "anc_00021",
          "anc_00050",
          "anc_00068",
          "anc_00074",
          "anc_00119"
        ]
      },
      {
        "node_id": "node_002",
        "title": "Homographic Adaptation",
        "label": "自监督标签生成",
        "summary": "对未标记的真实图像应用随机单应性变换，使用基础检测器生成伪标签，通过多次变换平均提升检测一致性。",
        "description": "对输入图像应用Nh次随机单应性变换（包括根中心裁剪、平移、缩放、平面内旋转等），在每个变换后的图像上运行基础检测器，将检测结果反变换回原图并平均，生成伪标签。Nh=100时重复性提升21%。",
        "type": "data_augmentation",
        "anchors": [
          "anc_00080",
          "anc_00085",
          "anc_00086",
          "anc_00087",
          "anc_00096",
          "anc_00101",
