  "glossary": {
    "interest_point": "图像中具有显著局部特征的位置，如角点、边缘端点等，用于几何视觉任务。",
    "descriptor": "附加在兴趣点上的固定长度向量，用于描述局部外观，实现点匹配。",
    "homography": "平面之间的投影变换，描述同一平面从不同视角观察时的图像变换关系。",
    "Homographic Adaptation": "本文提出的自监督方法，通过对图像应用随机单应性变换并平均检测结果，提升检测器重复性。",
    "MagicPoint": "在合成数据集Synthetic Shapes上预训练的基础兴趣点检测器。",
    "SuperPoint": "最终模型，结合兴趣点检测和描述子计算的全卷积网络。",
    "Synthetic Shapes": "本文创建的合成数据集，包含简单几何形状及其精确角点标签。",
    "repeatability": "衡量检测器在不同图像条件下检测相同物理点的一致性指标。",
    "NMS": "非最大抑制，用于从检测概率图中筛选出局部最大值作为兴趣点。",
    "dustbin": "检测头输出中的额外通道，用于表示“无兴趣点”的概率。",
    "terms": []
  },
