{
  "paper_skeleton": {
    "problem": {
      "summary": "传统兴趣点检测器在真实图像上泛化能力不足，且缺乏大规模人工标注的兴趣点数据集，难以用监督学习训练神经网络检测器。",
      "anchors": [
        "anc_00013",
        "anc_00014",
        "anc_00015",
        "anc_00016"
      ]
    },
    "motivation": {
      "summary": "兴趣点检测是几何计算机视觉任务（如SLAM、SfM）的基础，但语义定义模糊，难以通过人工监督训练。需要一种自监督方法，利用合成数据和自训练生成伪标签，提升检测器在真实图像上的重复性和描述子质量。",
      "anchors": [
        "anc_00003",
        "anc_00005",
        "anc_00007",
        "anc_00013"
      ]
    },
    "core_idea": {
      "summary": "提出一个自监督框架：1) 在合成数据集上预训练基础检测器MagicPoint；2) 通过Homographic Adaptation（多尺度、多单应性变换）为真实图像生成伪标签；3) 联合训练一个全卷积网络SuperPoint，同时输出兴趣点位置和描述子。",
      "anchors": [
        "anc_00005",
        "anc_00018",
        "anc_00019",
        "anc_00020",
        "anc_00021"
      ]
    },
    "method": {
      "summary": "三阶段流程：合成预训练（MagicPoint）、Homographic Adaptation生成伪标签、联合训练SuperPoint（兴趣点检测头+描述子头）。网络采用共享编码器和两个解码头，描述子通过半密集网格和双三次插值生成。",
      "anchors": [
        "anc_00028",
        "anc_00029",
        "anc_00030",
        "anc_00032",
        "anc_00033",
        "anc_00034",
        "anc_00036",
        "anc_00037"
      ]
    },
    "experiments": {
      "summary": "在HPatches数据集上评估重复性和单应性估计，与LIFT、SIFT、ORB对比。SuperPoint在光照变化下重复性最高，单应性估计性能与SIFT相当，优于LIFT和ORB。运行速度达70 FPS（480×640图像，Titan X GPU）。",
      "anchors": [
        "anc_00138",
        "anc_00139",
        "anc_00140",
        "anc_00141",
        "anc_00142",
        "anc_00152",
        "anc_00154",
