  "glossary": {
    "terms": [
      {
        "term": "条件GAN (Conditional GAN)",
        "definition": "一种生成对抗网络，其生成器和判别器都以额外信息（如语义标签图）为条件。",
        "anchors": [
          "anc_00005",
          "anc_00029",
          "anc_00033"
        ]
      },
      {
        "term": "语义标签图 (Semantic Label Map)",
        "definition": "图像中每个像素所属类别（如道路、汽车、天空）的标注图。",
        "anchors": [
          "anc_00002",
          "anc_00005",
          "anc_00033"
        ]
      },
      {
        "term": "粗到精生成器 (Coarse-to-fine Generator)",
        "definition": "一种生成器架构，先生成低分辨率图像，再逐步细化到高分辨率。本文中由全局生成器G1和局部增强网络G2组成。",
        "anchors": [
