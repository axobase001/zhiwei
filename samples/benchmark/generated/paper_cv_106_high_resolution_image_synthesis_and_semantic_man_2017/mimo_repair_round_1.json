          "anc_00092"
        ]
      },
      {
        "node_id": "node_005",
        "title": "实例级信息整合",
        "label": "Input_Enhancement",
        "summary": "将实例边界图与语义标签图通道拼接作为判别器输入，以更好地区分同一类别的不同对象实例。",
        "description": "从实例分割信息中提取实例边界图。将边界图、语义标签图和图像通道拼接后输入判别器，有助于生成更逼真的对象边界。",
        "type": "data_processing",
        "anchors": [
          "anc_00078",
          "anc_00079",
          "anc_00094",
          "anc_00096",
          "anc_00097",
          "anc_00099",
          "anc_00100"
        ]
      },
      {
        "node_id": "node_006",
        "title": "实例级特征嵌入",
        "label": "Feature_Embedding",
        "summary": "为每个对象实例学习一个低维特征向量，用于控制生成图像的外观（如纹理、颜色），并支持多样化生成和交互编辑。",
        "description": "训练一个编码器，为每个实例生成特征向量。训练后，对每个语义类别的特征进行K-means聚类（K=10）。推理时，随机选择聚类中心作为特征输入生成器，与标签图拼接。",
        "type": "model_component",
        "anchors": [
          "anc_00100",
