  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "基线模型：pix2pix",
        "label": "Baseline",
        "summary": "使用条件GAN（生成器G和判别器D）从语义标签图s生成图像x，通过最小化对抗损失LGAN。",
        "description": "基于pix2pix框架，输入语义标签图s，输出生成图像G(s)。判别器D尝试区分真实图像对(s, x)和生成图像对(s, G(s))。训练数据为成对的{(si, xi)}。",
        "type": "model_component",
        "anchors": [
          "anc_00029",
          "anc_00030",
          "anc_00033",
          "anc_00034",
          "anc_00035",
          "anc_00036"
        ]
      },
      {
        "node_id": "node_002",
        "title": "粗到精生成器",
        "label": "Generator",
        "summary": "由全局生成器G1和局部增强网络G2组成，逐步提升生成图像的分辨率。",
        "description": "G1基于Johnson等人的架构，包含卷积前端、残差块和转置卷积后端，处理1024×512输入。G2在G1输出的基础上，进一步处理以生成2048×1024图像。可扩展至G3生成4096×2048。",
        "type": "model_component",
        "anchors": [
          "anc_00042",
          "anc_00045",
          "anc_00047",
          "anc_00048",
          "anc_00049"
        ]
      },
      {
        "node_id": "node_003",
        "title": "多尺度判别器",
        "label": "Discriminator",
        "summary": "使用三个结构相同但作用于不同图像尺度的判别器D1、D2、D3，以稳定高分辨率训练并捕捉多尺度信息。",
        "description": "判别器在图像金字塔的三个尺度上操作。最粗尺度判别器具有最大感受野，关注全局结构；最细尺度判别器鼓励生成细节。这使得将低分辨率模型扩展到高分辨率更容易。",
        "type": "model_component",
        "anchors": [
          "anc_00050",
          "anc_00051",
          "anc_00053",
          "anc_00055",
          "anc_00057",
          "anc_00058",
          "anc_00059",
          "anc_00061",
          "anc_00063",
          "anc_00065",
          "anc_00067",
          "anc_00068",
          "anc_00069",
          "anc_00070"
        ]
      },
      {
        "node_id": "node_004",
        "title": "改进的对抗损失与特征匹配损失",
        "label": "Loss",
        "summary": "在标准GAN损失LGAN的基础上，加入基于判别器中间特征的特征匹配损失LFM，以稳定训练并提升质量。",
        "description": "特征匹配损失LFM计算生成图像和真实图像在判别器各层特征表示上的L1距离。总损失为LGAN和LFM的加权和，权重λ控制重要性。",
        "type": "loss_function",
        "anchors": [
          "anc_00079",
          "anc_00080",
          "anc_00082",
          "anc_00084",
          "anc_00086",
          "anc_00087",
