{
  "paper_skeleton": {
    "problem": {
      "summary": "现有计算机视觉模型在感知任务（如图像分类）上取得进展，但在认知任务（如图像描述和问答）上表现不佳。认知任务需要理解图像中物体之间的交互和关系，而现有模型仍使用为感知任务设计的数据集进行训练。",
      "anchors": [
        "anc_00007",
        "anc_00015"
      ]
    },
    "motivation": {
      "summary": "要实现认知任务的成功，模型需要理解图像中物体之间的交互和关系。例如，回答“那个人在骑什么交通工具？”需要识别物体以及关系 riding(man, carriage) 和 pulling(horse, carriage)。现有数据集（如 Flickr 30K 和 MS-COCO）侧重于图像的高层整体描述，缺乏密集的物体、属性和关系标注。",
      "anchors": [
        "anc_00015",
        "anc_00016",
        "anc_00018"
      ]
    },
    "core_idea": {
      "summary": "提出 Visual Genome 数据集，通过众包收集密集的图像标注，包括区域描述、物体、属性、关系、区域图、场景图和问答对，以支持对图像的全面认知理解。",
      "anchors": [
        "anc_00034",
        "anc_00036",
        "anc_00059"
      ]
    },
    "method": {
      "summary": "数据集收集方法：1) 收集人类生成的图像区域描述，每个区域由边界框定位；2) 从描述中提取物体、属性和关系；3) 将物体、属性、关系和名词短语规范化到 WordNet 同义词集；4) 收集自由形式和基于区域的问答对。",
      "anchors": [
        "anc_00036",
        "anc_00059",
        "anc_00288",
        "anc_00290",
        "anc_00295",
        "anc_00296"
      ]
    },
    "experiments": {
      "summary": "在 Visual Genome 数据集上进行了基线实验，包括属性预测、关系分类、区域描述生成和问答任务。使用了 VGG 网络和 NeuralTalk 模型。",
      "anchors": [
        "anc_00306",
        "anc_00308",
        "anc_00313",
        "anc_00317",
        "anc_00320",
        "anc_00331",
        "anc_00341",
        "anc_00356"
      ]
    },
