            "confidence": "medium",
            "anchors": [
              "anc_00004"
            ]
          },
          {
            "name": "\\Gamma_i",
            "description": "第i张人脸图像（向量形式）",
            "confidence": "medium",
            "anchors": [
              "anc_00004"
            ]
          }
        ],
        "dependencies": [],
        "intuition": "计算所有训练人脸的平均图像，用于后续的中心化处理，消除整体亮度等共同因素。",
        "anchors": [
          "anc_00004"
        ]
      },
      {
        "formula_id": "formula_002",
        "latex": "\\Phi_i = \\Gamma_i - \\Psi",
        "variables": [
          {
            "name": "\\Phi_i",
            "description": "中心化后的人脸图像（差值图像）",
            "confidence": "medium",
            "anchors": [
