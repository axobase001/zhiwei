  "formula_ir": {
    "formulas": [
      {
        "formula_id": "formula_001",
        "latex": "\\text{平均脸} \\Psi = \\frac{1}{N} \\sum_{i=1}^{N} \\Gamma_i",
        "variables": [
          {
            "name": "\\Psi",
            "description": "平均脸图像",
            "confidence": "medium",
            "anchors": [
              "anc_00004"
            ]
          },
          {
            "name": "N",
