        "label": "分类",
        "summary": "通过比较特征向量进行人脸识别。",
        "description": "将待识别人脸的特征向量与数据库中已知人脸的特征向量进行比较（如欧氏距离），找到最相似的匹配。",
        "type": "classification",
        "anchors": [
          "anc_00004"
        ]
      }
