            ]
          },
          {
            "name": "\\Gamma_i",
            "description": "第i张原始人脸图像",
            "confidence": "medium",
            "anchors": [
              "anc_00004"
            ]
          },
          {
            "name": "\\Psi",
            "description": "平均脸图像",
            "confidence": "medium",
            "anchors": [
              "anc_00004"
            ]
          }
        ],
        "dependencies": [],
        "intuition": "将每张人脸图像减去平均脸，得到反映个体差异的差值图像，用于计算协方差矩阵。",
        "anchors": [
          "anc_00004"
        ]
      },
      {
        "formula_id": "formula_003",
        "latex": "C = \\frac{1}{N} \\sum_{i=1}^{N} \\Phi_i \\Phi_i^T",
        "variables": [
          {
            "name": "C",
            "description": "协方差矩阵",
            "confidence": "medium",
            "anchors": [
