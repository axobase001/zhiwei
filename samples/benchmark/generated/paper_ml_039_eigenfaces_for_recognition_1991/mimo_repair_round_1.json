      },
      {
        "node_id": "node_003",
        "title": "计算协方差矩阵",
        "label": "特征提取",
        "summary": "基于中心化后的人脸图像计算协方差矩阵。",
        "description": "将每张人脸图像减去平均脸得到差值图像，计算这些差值图像的协方差矩阵，用于描述像素间的相关性。",
        "type": "feature_extraction",
        "anchors": [
          "anc_00004"
        ]
      },
      {
        "node_id": "node_004",
        "title": "提取主成分（特征脸）",
        "label": "降维",
        "summary": "对协方差矩阵进行特征分解，选取最大的特征值对应的特征向量作为特征脸。",
        "description": "通过特征分解得到特征向量，这些特征向量（特征脸）代表了人脸图像中的主要变化模式。通常选取前k个最大特征值对应的特征向量。",
        "type": "dimensionality_reduction",
        "anchors": [
          "anc_00004"
        ]
      },
      {
        "node_id": "node_005",
        "title": "人脸投影",
        "label": "特征表示",
        "summary": "将人脸图像投影到特征脸空间，得到低维特征向量。",
        "description": "对于任意人脸图像，减去平均脸后，与每个特征脸进行点积，得到一组系数，构成该人脸的特征向量。",
        "type": "feature_representation",
        "anchors": [
          "anc_00004"
        ]
      },
      {
