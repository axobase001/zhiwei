            ]
          }
        ],
        "dependencies": [],
        "intuition": "计算差值图像的协方差矩阵，描述像素间的统计相关性，其特征向量即为特征脸。",
        "anchors": [
          "anc_00004"
        ]
      },
      {
        "formula_id": "formula_004",
        "latex": "C u_k = \\lambda_k u_k",
        "variables": [
          {
            "name": "u_k",
