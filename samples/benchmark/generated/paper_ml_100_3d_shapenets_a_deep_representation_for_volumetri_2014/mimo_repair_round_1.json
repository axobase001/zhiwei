  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "3D体素表示",
        "label": "输入表示",
        "summary": "将3D形状表示为3D体素网格上的二元变量概率分布。",
        "description": "输入为3D体素网格，每个体素表示为二元变量（占据或空闲）。模型学习这些变量的概率分布。",
        "type": "representation",
        "anchors": [
          "anc_00006",
          "anc_00046"
        ]
      },
      {
        "node_id": "node_002",
        "title": "卷积深度置信网络",
        "label": "模型架构",
        "summary": "使用卷积深度置信网络学习3D形状的层次化表示。",
        "description": "架构包括卷积层（如48个6x6x6滤波器，步长2）和全连接层，通过无监督预训练和有监督微调学习。",
        "type": "model",
        "anchors": [
          "anc_00006",
          "anc_00015",
          "anc_00041"
        ]
      },
      {
        "node_id": "node_003",
        "title": "能量函数",
        "label": "模型目标",
        "summary": "定义卷积深度置信网络的能量函数，用于建模可见单元和隐藏单元之间的关系。",
        "description": "能量函数E(v, h) = -∑_f ∑_j (h_f^j (W_f * v)_j + c_f h_f^j) - ∑_l b_l v_l，其中v_l是可见单元，h_f^j是隐藏单元，W_f是卷积滤波器。",
        "type": "formula",
        "anchors": [
          "anc_00035",
          "anc_00036"
        ]
      },
      {
        "node_id": "node_004",
        "title": "Gibbs采样推理",
        "label": "推理过程",
        "summary": "使用Gibbs采样进行物体识别和形状补全。",
        "description": "给定观测体素x_o，通过Gibbs采样估计后验分布p(y|x_o)和p(x_u|x_o)，其中x_u是未知体素。",
        "type": "inference",
        "anchors": [
          "anc_00046",
          "anc_00047",
