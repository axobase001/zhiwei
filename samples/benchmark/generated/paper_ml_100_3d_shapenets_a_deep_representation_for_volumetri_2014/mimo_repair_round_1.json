{
  "paper_skeleton": {
    "problem": {
      "summary": "3D形状是计算机视觉中的关键线索，但缺乏通用的3D形状表示方法，限制了其在物体类别识别和形状补全等任务中的应用。",
      "anchors": [
        "anc_00004",
        "anc_00006",
        "anc_00008",
        "anc_00010"
      ]
    },
    "motivation": {
      "summary": "随着廉价2.5D深度传感器（如Microsoft Kinect）的出现，需要强大的3D形状表示来支持物体识别和从深度图恢复完整3D形状。现有方法（如基于部件的组装）依赖昂贵的部件标注，且难以处理跨类别和姿态的大变化。",
      "anchors": [
        "anc_00004",
        "anc_00006",
        "anc_00010",
        "anc_00017",
        "anc_00023",
        "anc_00024",
        "anc_00025"
      ]
    },
    "core_idea": {
      "summary": "提出3D ShapeNets，使用卷积深度置信网络（Convolutional Deep Belief Network）将3D形状表示为3D体素网格上二元变量的概率分布，从原始CAD数据中学习复杂3D形状分布，并自动发现层次化的部件表示。",
      "anchors": [
        "anc_00006",
        "anc_00015",
        "anc_00041"
      ]
    },
    "method": {
      "summary": "模型架构包括卷积层和全连接层，通过无监督预训练和有监督微调学习。使用Gibbs采样进行推理，支持物体识别、形状补全和下一最佳视角预测。构建了ModelNet大规模3D CAD数据集。",
      "anchors": [
        "anc_00006",
        "anc_00015",
        "anc_00041",
        "anc_00046",
        "anc_00047",
        "anc_00048",
        "anc_00049",
