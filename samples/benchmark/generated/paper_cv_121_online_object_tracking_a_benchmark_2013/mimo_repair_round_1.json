{
  "paper_skeleton": {
    "problem": {
      "summary": "在线单目标跟踪领域缺乏统一的评估基准、代码库和标准化数据集，导致不同算法难以进行公平、全面的比较，且现有评估方法对初始化条件敏感，无法全面反映算法的鲁棒性。",
      "anchors": [
        "anc_00010",
        "anc_00012",
        "anc_00016"
      ]
    },
    "motivation": {
      "summary": "尽管在线目标跟踪取得了显著进展，但缺乏一个综合性的基准来系统评估算法性能、识别其优缺点并指导未来研究方向。现有数据集和评估方法存在局限性，如标注不一致、评估条件单一等。",
      "anchors": [
        "anc_00003",
        "anc_00005",
        "anc_00008",
        "anc_00010"
      ]
    },
    "core_idea": {
      "summary": "构建一个包含50个全标注序列的数据集、一个集成29种公开跟踪算法的代码库，并提出一种通过空间和时间扰动初始化来评估跟踪器鲁棒性的新方法，从而进行大规模、全面的性能评估。",
      "anchors": [
        "anc_00018",
        "anc_00019",
        "anc_00020"
      ]
    },
    "method": {
      "summary": "1. 收集并标注50个具有11种属性的跟踪序列。2. 集成29种公开跟踪算法到统一代码库。3. 提出三种评估协议：一次通过评估（OPE）、空间鲁棒性评估（SRE）和时间鲁棒性评估（TRE）。4. 使用精度图（基于中心位置误差）和成功率图（基于重叠率）进行定量分析。",
      "anchors": [
        "anc_00018",
        "anc_00019",
        "anc_00020",
        "anc_00061",
        "anc_00083",
        "anc_00094",
        "anc_00099"
      ]
    },
    "experiments": {
      "summary": "在50个序列上对29种跟踪器进行了大规模评估，包括OPE、SRE和TRE。分析了不同属性（如遮挡、快速运动、尺度变化）下的性能。评估了超过66万个边界框输出。",
      "anchors": [
        "anc_00105",
        "anc_00106",
        "anc_00113",
        "anc_00115",
        "anc_00120"
      ]
    },
    "claims": [
