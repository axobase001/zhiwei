{
  "paper_skeleton": {
    "problem": "设计高效的移动设备神经网络架构，在保持高精度的同时显著降低计算量和内存占用，以支持实时推理。",
    "motivation": "现有移动网络（如MobileNetV1）在精度和效率之间仍有改进空间。作者提出通过改进残差块结构（倒残差）和移除窄层中的非线性激活（线性瓶颈）来提升性能，并扩展至目标检测和语义分割任务。",
    "core_idea": "提出MobileNetV2架构，核心创新是倒残差结构（inverted residuals）和线性瓶颈（linear bottlenecks）。倒残差在薄瓶颈层之间使用跳跃连接，中间扩展层使用轻量级深度卷积作为非线性源；线性瓶颈通过移除窄层中的非线性激活来保持表示能力。",
    "method": "基于深度可分离卷积构建倒残差瓶颈块：先通过1x1卷积扩展通道数（扩展因子t），然后进行3x3深度卷积，最后通过1x1线性卷积压缩回低维。跳跃连接在瓶颈层之间。使用ReLU6作为非线性激活。通过宽度乘子和输入分辨率调整模型大小。",
    "experiments": "在ImageNet分类、COCO目标检测（使用SSDLite）和PASCAL VOC语义分割（使用Mobile DeepLabv3）上评估。与MobileNetV1、ShuffleNet、NASNet等基线比较，分析精度、计算量（MAdds）、参数量和延迟。",
    "claims": [
      "倒残差结构比传统残差结构更高效且性能更好。",
      "线性瓶颈对保持低维流形的信息至关重要，移除非线性激活可提升性能。",
      "MobileNetV2在多个任务和基准上达到或超过现有移动模型的精度，同时计算量和参数量更少。",
      "SSDLite和Mobile DeepLabv3是高效的目标检测和语义分割移动解决方案。",
      "倒残差设计允许内存高效的推理实现。"
    ],
    "limitations": "论文未详细讨论在不同硬件平台上的实际部署优化；扩展因子t的选择基于经验；对于极小模型（宽度乘子<0.35）的性能未深入分析；语义分割中ASPP模块的移除会带来精度损失。"
  },
