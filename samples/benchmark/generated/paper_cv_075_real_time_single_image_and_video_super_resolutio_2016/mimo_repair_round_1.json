{
  "paper_skeleton": {
    "problem": {
      "summary": "单图像超分辨率（SISR）任务中，现有基于深度神经网络的方法通常先使用双三次插值等单一滤波器将低分辨率（LR）图像上采样到高分辨率（HR）空间，然后在HR空间进行重建。这种做法是次优的，并增加了计算复杂度。",
      "anchors": [
        "anc_00003"
      ]
    },
    "motivation": {
      "summary": "在HR空间进行超分辨率操作计算成本高昂，且非自适应的上采样（如双三次插值）无法为重建问题提供额外信息。需要一种更高效、更有效的架构，能够在LR空间进行特征提取，并学习自适应的上采样滤波器。",
      "anchors": [
        "anc_00003",
        "anc_00012",
        "anc_00013"
      ]
    },
    "core_idea": {
      "summary": "提出一种新颖的卷积神经网络架构（ESPCN），在LR空间进行特征提取，并在最后一层引入高效的亚像素卷积层（sub-pixel convolution layer），通过学习一组上采样滤波器，直接将LR特征图转换为HR输出图像。这避免了在HR空间进行大部分计算，显著降低了计算复杂度。",
      "anchors": [
        "anc_00003",
        "anc_00015",
        "anc_00018",
        "anc_00030",
        "anc_00038"
      ]
    },
    "method": {
      "summary": "网络由多个卷积层在LR空间提取特征，最后一层是亚像素卷积层。该层对LR特征图进行卷积，生成通道数为C·r²的输出，然后通过周期性混洗（Periodic Shuffling, PS）操作将这些通道重新排列成rH×rW×C的HR图像。训练使用均方误差（MSE）作为损失函数。",
      "anchors": [
        "anc_00020",
        "anc_00021",
        "anc_00022",
        "anc_00023",
        "anc_00024",
        "anc_00025",
        "anc_00030",
        "anc_00032",
        "anc_00033",
        "anc_00034",
        "anc_00035",
        "anc_00043",
        "anc_00044"
      ]
    },
    "experiments": {
      "summary": "在多个公开图像数据集（Set5, Set14, BSD300, BSD500, SuperTexture）和视频数据集（Xiph, Ultra Video Group）上进行了评估。与双三次插值、SRCNN和TNRD等方法进行了比较，评估了PSNR、运行时间和视觉质量。",
      "anchors": [
        "anc_00046",
        "anc_00049",
        "anc_00051",
        "anc_00052",
        "anc_00053",
        "anc_00063",
        "anc_00064",
