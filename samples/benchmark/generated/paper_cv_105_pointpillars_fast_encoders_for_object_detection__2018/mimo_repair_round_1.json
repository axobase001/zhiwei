      {
        "node_id": "node_005",
        "title": "数据增强",
        "label": "训练技巧",
        "summary": "使用关键的数据增强策略提升模型性能。",
        "description": "1. 从地面真值数据库中采样物体并添加到当前点云中（汽车15个，行人0个，骑车人8个）。2. 对每个地面真值框进行旋转和平移增强。3. 对整个点云进行全局旋转和平移增强。",
        "type": "augmentation",
        "anchors": [
          "anc_00087",
          "anc_00088"
        ]
      }
