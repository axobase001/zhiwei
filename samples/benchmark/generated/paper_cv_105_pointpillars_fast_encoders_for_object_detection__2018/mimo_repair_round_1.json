  "glossary": {
    "terms": [
      {
        "term": "PointPillars",
        "definition": "本文提出的点云编码器，将点云组织成垂直柱体（pillars），并使用简化的PointNet学习特征。",
        "anchors": [
          "anc_00003",
          "anc_00035"
        ],
        "appears_in": [
          "anc_00003",
          "anc_00035"
        ]
      },
      {
        "term": "Pillar",
        "definition": "垂直柱体，是PointPillars中组织点云的基本单元。点云被划分到XY平面上的网格中，每个网格单元（柱体）包含该垂直列中的所有点。",
        "anchors": [
          "anc_00035",
          "anc_00036"
        ],
        "appears_in": [
          "anc_00035",
          "anc_00036"
        ]
      },
      {
        "term": "Pseudo-image",
