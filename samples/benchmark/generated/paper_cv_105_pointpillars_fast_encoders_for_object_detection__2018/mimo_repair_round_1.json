  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "点云到伪图像转换",
        "label": "输入处理",
        "summary": "将原始点云转换为适合2D卷积处理的伪图像表示。",
        "description": "1. 将点云组织成垂直柱体（pillars）。2. 对每个点进行特征增强（添加到柱体中心的距离和偏移）。3. 创建密集张量（D, P, N）。4. 使用简化的PointNet学习特征。5. 将特征散射回原始位置形成伪图像（C, H, W）。",
        "type": "encoder",
        "anchors": [
          "anc_00035",
          "anc_00036",
          "anc_00037",
          "anc_00038",
          "anc_00039",
          "anc_00043",
          "anc_00044",
          "anc_00045"
        ]
      },
      {
        "node_id": "node_002",
        "title": "骨干网络",
        "label": "特征提取",
        "summary": "使用2D卷积骨干网络处理伪图像，提取多尺度特征。",
        "description": "骨干网络包含两个子网络：一个自上而下的网络生成越来越小的空间分辨率特征，另一个网络执行上采样和特征拼接。具体结构为Block1(S, 4, C), Block2(2S, 6, 2C), Block3(4S, 6, 4C)，以及对应的上采样步骤Up1, Up2, Up3，最终拼接得到6C特征。",
        "type": "backbone",
        "anchors": [
          "anc_00045",
          "anc_00050",
          "anc_00051",
          "anc_00052"
        ]
      },
      {
        "node_id": "node_003",
        "title": "检测头",
        "label": "预测",
        "summary": "使用SSD检测头从骨干网络特征中预测3D边界框。",
        "description": "检测头接收骨干网络输出的6C特征，预测物体的类别、位置、尺寸和方向。使用锚框匹配策略和非极大值抑制（NMS）生成最终检测结果。",
        "type": "head",
        "anchors": [
          "anc_00031",
          "anc_00045",
          "anc_00046",
          "anc_00078",
          "anc_00079"
        ]
      },
      {
        "node_id": "node_004",
        "title": "损失函数",
        "label": "优化目标",
        "summary": "定义并优化用于训练的多任务损失函数。",
        "description": "损失函数包括定位损失（Lloc）、分类损失（Lcls，使用焦点损失）和方向损失（Ldir）。总损失为L = 1/Npos * (βloc*Lloc + βcls*Lcls + βdir*Ldir)，其中Npos为正锚框数量，βloc=2, βcls=1, βdir=0.2。",
        "type": "loss",
        "anchors": [
          "anc_00052",
