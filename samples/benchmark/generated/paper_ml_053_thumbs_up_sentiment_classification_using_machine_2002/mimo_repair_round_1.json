{
  "paper_skeleton": {
    "problem": {
      "summary": "将文档按整体情感（如正面或负面）而非主题进行分类，即情感分类问题。",
      "anchors": [
        "anc_00003",
        "anc_00004",
        "anc_00005",
        "anc_00012"
      ]
    },
    "motivation": {
      "summary": "在线评论和讨论组的快速增长使得自动情感分类变得重要，但情感表达比主题分类更微妙，需要更深层次的理解。",
      "anchors": [
        "anc_00012",
        "anc_00014"
      ]
    },
    "core_idea": {
      "summary": "探索标准机器学习技术（朴素贝叶斯、最大熵、支持向量机）在情感分类上的有效性，并与人工基线进行比较。",
      "anchors": [
        "anc_00005",
        "anc_00006",
        "anc_00007",
        "anc_00057",
        "anc_00058"
      ]
    },
    "method": {
      "summary": "使用电影评论数据集，采用词袋模型表示文档，应用三种机器学习算法进行分类，并尝试不同特征（如一元词、二元词、否定标签等）。",
      "anchors": [
