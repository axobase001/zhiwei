        "node_id": "node_003",
        "title": "特征表示",
        "label": "词袋模型",
        "summary": "将文档表示为特征向量，特征可以是单词、二元词等。",
        "description": "使用标准词袋框架，文档d表示为向量(n1(d), n2(d), ..., nm(d))，其中ni(d)是特征fi在文档中的出现次数。",
        "type": "representation",
        "anchors": [
          "anc_00059",
          "anc_00060"
        ]
      },
      {
        "node_id": "node_004",
        "title": "朴素贝叶斯分类器",
        "label": "NB",
        "summary": "基于贝叶斯定理和条件独立假设的概率分类器。",
        "description": "通过相对频率估计P(c)和P(fi|c)，使用加一平滑。分类决策为c* = arg max_c P(c|d)。",
        "type": "algorithm",
        "anchors": [
          "anc_00063",
          "anc_00064",
          "anc_00065",
          "anc_00066",
          "anc_00067",
          "anc_00069",
          "anc_00071",
          "anc_00073"
        ]
      },
      {
        "node_id": "node_005",
        "title": "最大熵分类器",
        "label": "MaxEnt",
        "summary": "基于最大熵原理的概率分类器，不假设特征独立性。",
        "description": "PME(c|d) = (1/Z(d)) exp(∑_i λ_{i,c} F_{i,c}(d,c))，其中F_{i,c}是特征/类别函数，λ_{i,c}是特征权重参数。",
        "type": "algorithm",
        "anchors": [
          "anc_00079",
          "anc_00080",
          "anc_00081",
          "anc_00082",
          "anc_00083",
