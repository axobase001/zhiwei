          "anc_00088"
        ]
      },
      {
        "node_id": "node_006",
        "title": "支持向量机",
        "label": "SVM",
        "summary": "大间隔分类器，通过寻找最大间隔超平面进行分类。",
        "description": "训练过程寻找超平面w⃗，使得文档向量分离且间隔最大。解为w⃗ = ∑_j α_j c_j d⃗_j，其中α_j ≥ 0。",
        "type": "algorithm",
        "anchors": [
          "anc_00090",
