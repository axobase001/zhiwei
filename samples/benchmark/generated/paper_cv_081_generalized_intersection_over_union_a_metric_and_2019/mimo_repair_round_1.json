    "paper_id": "paper_cv_081_generalized_intersection_over_union_a_metric_and_2019",
    "title": "Generalized Intersection Over Union: A Metric and a Loss for Bounding Box Regression",
    "authors": [
      "S. H. Rezatofighi",
      "Nathan Tsoi",
      "JunYoung Gwak",
      "Amir Sadeghian",
      "I. Reid",
      "S. Savarese"
    ],
    "venue": "Computer Vision and Pattern Recognition",
    "year": 2019,
