    "semantic_scholar_url": "https://www.semanticscholar.org/paper/889c81b4d7b7ed43a3f69f880ea60b0572e02e27",
    "importance_rank": 81,
    "selection_source": "semantic_scholar_top_cited_cv_open_pdf_2026_05_03",
