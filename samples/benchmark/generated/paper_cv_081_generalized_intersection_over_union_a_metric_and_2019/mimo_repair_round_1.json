{
  "paper_skeleton": {
    "problem": {
      "summary": "传统边界框回归中使用的距离损失（如ℓ1、ℓ2范数）与评估指标IoU之间存在优化目标不一致的问题，导致优化效果不佳。",
      "anchors": [
        "anc_00003",
        "anc_00005",
        "anc_00010",
        "anc_00012",
        "anc_00014"
      ]
    },
    "motivation": {
      "summary": "IoU作为最流行的评估指标，但在非重叠边界框情况下存在梯度为零的平台问题，无法直接用作损失函数进行优化。需要一种既能作为评估指标又能作为损失函数的广义IoU。",
      "anchors": [
        "anc_00005",
        "anc_00028",
        "anc_00048"
      ]
    },
    "core_idea": {
      "summary": "提出广义交并比（GIoU），它在保持IoU所有优点的同时，解决了其在非重叠情况下的优化难题，可同时作为评估指标和回归损失。",
      "anchors": [
        "anc_00024",
        "anc_00030",
        "anc_00032",
        "anc_00036",
        "anc_00037",
        "anc_00038",
        "anc_00044"
      ]
    },
    "method": {
      "summary": "通过引入最小外接矩形C，定义GIoU = IoU - |C \\ (A ∪ B)| / |C|，并推导出其作为损失函数的解析解和梯度计算方法（算法2）。",
      "anchors": [
