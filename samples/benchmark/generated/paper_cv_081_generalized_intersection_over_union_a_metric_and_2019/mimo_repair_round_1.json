  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "IoU定义与问题",
        "label": "基础概念",
        "summary": "IoU是评估两个形状相似性的标准指标，但在非重叠情况下梯度为零，无法直接优化。",
        "description": "IoU = |A ∩ B| / |A ∪ B|。当两个边界框不重叠时，IoU=0且梯度为零，导致优化停滞。",
        "type": "concept",
        "anchors": [
          "anc_00003",
          "anc_00005",
          "anc_00020",
          "anc_00022",
          "anc_00028"
        ]
      },
      {
        "node_id": "node_002",
        "title": "GIoU定义",
        "label": "核心创新",
        "summary": "提出广义交并比（GIoU），通过引入最小外接矩形来度量非重叠情况下的距离。",
        "description": "GIoU = IoU - |C \\ (A ∪ B)| / |C|，其中C是A和B的最小外接矩形。GIoU的取值范围为[-1, 1]。",
        "type": "formula",
        "anchors": [
          "anc_00024",
          "anc_00030",
          "anc_00032",
          "anc_00036",
          "anc_00037",
          "anc_00038"
        ]
      },
      {
        "node_id": "node_003",
        "title": "GIoU作为损失函数",
        "label": "方法实现",
        "summary": "将GIoU转化为损失函数L_GIoU = 1 - GIoU，并推导出用于反向传播的梯度计算算法。",
        "description": "算法2详细描述了如何计算两个边界框的IoU和GIoU，包括交集、并集、最小外接矩形面积的计算，以及梯度的传播。",
        "type": "algorithm",
        "anchors": [
