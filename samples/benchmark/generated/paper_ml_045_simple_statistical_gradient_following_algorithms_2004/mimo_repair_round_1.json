  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "随机单元模型",
        "label": "基础组件",
        "summary": "定义网络中的随机单元，其输出由概率分布决定。",
        "description": "每个单元i的输出yi由概率质量函数gi(ξ, wi, xi) = Pr{yi = ξ | wi, xi}决定，其中wi是权重向量，xi是输入向量。支持离散和连续输出。",
        "type": "model_component",
        "anchors": [
          "anc_00012",
          "anc_00013",
          "anc_00014",
          "anc_00015"
        ]
      },
      {
        "node_id": "node_002",
        "title": "伯努利-逻辑单元",
        "label": "特殊单元类型",
        "summary": "一种常用的随机单元，输出为0或1，概率由逻辑函数决定。",
        "description": "对于伯努利逻辑单元，输出yi是伯努利随机变量，参数pi = f(si)，其中si = wi·xi，f是逻辑函数。概率质量函数为：Pr{yi=1|wi,xi}=pi，Pr{yi=0|wi,xi}=1-pi。",
        "type": "model_component",
        "anchors": [
          "anc_00018",
          "anc_00019",
          "anc_00020",
          "anc_00022",
          "anc_00024"
        ]
      },
      {
        "node_id": "node_003",
        "title": "期望强化函数",
        "label": "优化目标",
        "summary": "定义网络性能的度量，是权重W的函数。",
        "description": "E{r | W}表示在权重W下期望获得的强化信号r。假设环境输入和强化信号由平稳分布决定，该函数是确定性的。",
        "type": "objective",
        "anchors": [
          "anc_00029",
          "anc_00031",
          "anc_00032",
          "anc_00034"
        ]
      },
      {
        "node_id": "node_004",
        "title": "REINFORCE算法框架",
        "label": "核心算法",
        "summary": "一类基于梯度估计的权重更新算法。",
        "description": "权重更新规则：Δwij = αij(r - bij)eij，其中αij是学习率，bij是基线，eij = ∂ln gi/∂wij是特征资格。该更新方向是梯度∇_W E{r|W}的无偏估计。",
        "type": "algorithm",
        "anchors": [
          "anc_00039",
          "anc_00041",
          "anc_00043",
          "anc_00046",
          "anc_00048"
        ]
      },
      {
        "node_id": "node_005",
        "title": "基线引入",
        "label": "方差缩减技术",
        "summary": "通过引入基线bij来降低梯度估计的方差。",
        "description": "基线bij可以是常数或自适应估计，不影响梯度估计的无偏性，但能显著降低方差。最优基线可最小化权重更新的方差。",
        "type": "technique",
        "anchors": [
          "anc_00039",
          "anc_00183",
          "anc_00186"
        ]
      },
      {
        "node_id": "node_006",
        "title": "AR-I算法",
        "label": "具体算法变体",
        "summary": "针对伯努利逻辑单元的特定REINFORCE算法。",
        "description": "设置αij = α，bij = 0，得到Δwij = α(r)(yi - pi)xj。这是最简单的REINFORCE形式。",
        "type": "algorithm",
        "anchors": [
          "anc_00064",
          "anc_00065",
          "anc_00067",
          "anc_00069"
        ]
      },
      {
        "node_id": "node_007",
        "title": "与反向传播结合",
        "label": "混合网络方法",
        "summary": "将REINFORCE与反向传播结合用于混合随机-确定性网络。",
        "description": "对于包含确定性隐藏单元和随机输出单元的网络，可以使用反向传播计算确定性部分的梯度，然后应用REINFORCE到随机部分。",
        "type": "extension",
        "anchors": [
          "anc_00118",
          "anc_00119",
          "anc_00121",
          "anc_00123",
          "anc_00125",
          "anc_00127"
        ]
      },
      {
        "node_id": "node_008",
        "title": "高斯单元扩展",
        "label": "连续输出扩展",
        "summary": "将REINFORCE扩展到输出为连续值的随机单元。",
        "description": "对于输出服从高斯分布的单元，均值μ和标准差σ由网络确定性计算，然后从该分布采样输出。REINFORCE可以应用于这种单元。",
        "type": "extension",
        "anchors": [
          "anc_00096",
          "anc_00098",
