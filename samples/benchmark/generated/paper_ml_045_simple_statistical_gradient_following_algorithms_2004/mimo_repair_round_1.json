{
  "paper_skeleton": {
    "problem": {
      "summary": "如何为包含随机单元的连接主义网络设计简单有效的强化学习算法，使其能够沿着期望强化的梯度方向调整权重。",
      "anchors": [
        "anc_00001",
        "anc_00003",
        "anc_00006"
      ]
    },
    "motivation": {
      "summary": "现有强化学习算法在处理随机单元网络时缺乏理论保证，且梯度下降方法在监督学习中已证明有效，但需要将其推广到强化学习场景。",
      "anchors": [
        "anc_00001",
        "anc_00008"
      ]
    },
    "core_idea": {
      "summary": "提出REINFORCE算法族，通过计算期望强化函数的梯度无偏估计来更新权重，确保权重调整方向与梯度方向一致。",
      "anchors": [
        "anc_00001",
        "anc_00039",
        "anc_00041",
        "anc_00043"
      ]
    },
    "method": {
      "summary": "基于随机单元的输出概率分布，推导出梯度估计公式，并设计了多种具体算法变体（如AR-I、AR-P等）。",
      "anchors": [
        "anc_00012",
        "anc_00013",
        "anc_00039",
        "anc_00064",
        "anc_00065"
      ]
    },
    "experiments": {
      "summary": "论文主要通过理论分析和简单模拟实验验证算法性质，未提供大规模基准测试。",
      "anchors": [
        "anc_00153",
