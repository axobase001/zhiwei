  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "ControlNet架构",
        "label": "核心架构",
        "summary": "ControlNet通过锁定预训练模型参数并创建可训练副本，使用零卷积层连接，以注入条件控制。",
        "description": "ControlNet将条件输入注入神经网络块。原始块参数Θ被锁定，同时克隆为可训练副本Θc。可训练副本接收外部条件向量c。通过两个零卷积层Z(·;·)连接，输出yc = F(x; Θ) + Z(F(x + Z(c; Θz1); Θc); Θz2)。训练初期，零卷积输出为零，确保yc = y，保护预训练模型。",
        "type": "architecture",
        "anchors": [
          "anc_00048",
          "anc_00049",
          "anc_00050",
          "anc_00054",
          "anc_00055",
          "anc_00056",
          "anc_00057"
        ]
      },
      {
        "node_id": "node_002",
        "title": "零卷积层",
        "label": "关键组件",
        "summary": "零卷积层是1×1卷积层，权重和偏置初始化为零，用于连接可训练副本和锁定模型，确保训练初期不引入噪声。",
        "description": "零卷积层Z(·;·)的权重和偏置初始化为零。在训练第一步，Z(c; Θz1) = 0，因此可训练副本的输入仅为x，输出为F(x; Θc)。零卷积层保护预训练骨干网络，消除初始训练步骤中的随机噪声梯度。",
        "type": "component",
        "anchors": [
          "anc_00054",
          "anc_00055",
          "anc_00056",
          "anc_00057",
          "anc_00059",
          "anc_00062",
          "anc_00063"
        ]
      },
      {
        "node_id": "node_003",
        "title": "ControlNet应用于Stable Diffusion",
        "label": "应用实例",
        "summary": "ControlNet被应用于Stable Diffusion的U-Net架构，创建12个编码块和1个中间块的可训练副本。",
        "description": "Stable Diffusion是U-Net架构，包含编码器、中间块和解码器。ControlNet为12个编码块和1个中间块创建可训练副本。条件向量cf通过编码器E(ci)从条件图像ci生成。ControlNet输出添加到Stable Diffusion的对应块。",
        "type": "application",
        "anchors": [
          "anc_00065",
          "anc_00066",
          "anc_00068",
          "anc_00069",
          "anc_00070",
          "anc_00071",
          "anc_00072"
        ]
      },
      {
        "node_id": "node_004",
        "title": "训练过程",
        "label": "训练策略",
        "summary": "训练使用扩散模型的标准学习目标，随机替换50%文本提示为空字符串，以增强条件图像语义识别。",
        "description": "训练目标L = E[∥ϵ − ϵθ(zt, t, ct, cf)∥²]，其中ϵ是噪声，ϵθ是预测噪声。训练时随机替换50%文本提示ct为空字符串，使ControlNet能直接识别条件图像中的语义。零卷积确保训练初期模型始终能预测高质量图像。",
        "type": "training",
        "anchors": [
          "anc_00073",
          "anc_00074",
          "anc_00075"
        ]
      },
      {
        "node_id": "node_005",
        "title": "分类器自由引导分辨率加权",
        "label": "推理技术",
        "summary": "在推理时，通过分辨率加权调整分类器自由引导（CFG）强度，以平衡条件控制和生成质量。",
        "description": "CFG公式为ϵprd = ϵuc + βcfg(ϵc − ϵuc)。ControlNet将条件图像添加到ϵc。为避免CFG引导过强或过弱，引入分辨率加权wi = 64 / hi，其中hi是第i个块的大小。通过降低CFG引导强度实现更好的控制。",
        "type": "inference",
        "anchors": [
          "anc_00081",
          "anc_00082",
          "anc_00083",
          "anc_00091",
          "anc_00092",
          "anc_00093"
        ]
      },
      {
        "node_id": "node_006",
        "title": "多条件组合",
        "label": "扩展功能",
        "summary": "多个ControlNet的输出可以直接相加到Stable Diffusion模型，实现多条件组合控制。",
        "description": "要应用多个条件图像（如Canny边缘和姿态），可以直接将对应ControlNet的输出添加到Stable Diffusion模型。无需额外权重或线性插值。",
        "type": "extension",
        "anchors": [
          "anc_00080",
          "anc_00094"
        ]
      }
    ],
