{
  "paper_skeleton": {
    "problem": {
      "summary": "文本到图像扩散模型（如Stable Diffusion）在空间构图控制方面存在局限，难以通过文本提示精确表达复杂的布局、姿态、形状和形式。",
      "anchors": [
        "anc_00016"
      ]
    },
    "motivation": {
      "summary": "现有方法（如训练免费技术）无法解决深度到图像、姿态到图像等需要端到端学习和数据驱动的问题。直接微调大型预训练模型在有限数据下容易导致过拟合和灾难性遗忘。",
      "anchors": [
        "anc_00018",
        "anc_00020",
        "anc_00022",
        "anc_00024"
      ]
    },
    "core_idea": {
      "summary": "提出ControlNet架构，通过锁定预训练模型参数并创建其编码层的可训练副本，使用“零卷积”层连接，以渐进方式从零开始学习条件控制，避免有害噪声影响微调。",
      "anchors": [
        "anc_00010",
        "anc_00011",
        "anc_00012",
        "anc_00013",
        "anc_00014",
        "anc_00025",
        "anc_00026",
        "anc_00027",
        "anc_00028",
        "anc_00029",
        "anc_00030",
        "anc_00031",
        "anc_00032"
      ]
    },
    "method": {
      "summary": "ControlNet将条件输入（如边缘、深度图、分割图）注入预训练扩散模型的编码块和中间块。使用零卷积层（权重和偏置初始化为零）连接可训练副本和锁定模型，确保训练初期不引入噪声。训练时随机替换50%文本提示为空字符串，增强模型对条件图像语义的识别能力。",
      "anchors": [
        "anc_00048",
        "anc_00049",
        "anc_00050",
        "anc_00051",
