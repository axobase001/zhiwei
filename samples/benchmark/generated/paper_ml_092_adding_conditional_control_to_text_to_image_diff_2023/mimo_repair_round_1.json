  "glossary": {
    "terms": [
      {
        "term": "ControlNet",
        "definition": "一种神经网络架构，用于向大型预训练文本到图像扩散模型添加空间条件控制。",
        "anchors": [
          "anc_00010",
          "anc_00011",
          "anc_00012"
        ],
        "appears_in": [
          "anc_00010",
          "anc_00011",
          "anc_00012"
        ]
      },
      {
        "term": "零卷积层",
        "definition": "1×1卷积层，权重和偏置初始化为零，用于连接ControlNet的可训练副本和锁定模型，确保训练初期不引入噪声。",
        "anchors": [
          "anc_00054",
          "anc_00055",
          "anc_00056"
        ],
        "appears_in": [
          "anc_00054",
          "anc_00055",
          "anc_00056"
        ]
      },
      {
        "term": "Stable Diffusion",
        "definition": "一种大规模潜在扩散模型，用于文本到图像生成。",
        "anchors": [
          "anc_00039",
          "anc_00040"
        ],
        "appears_in": [
          "anc_00039",
          "anc_00040"
        ]
      },
      {
        "term": "分类器自由引导（CFG）",
        "definition": "一种技术，通过结合无条件和有条件输出来提高扩散模型生成质量，公式为ϵprd = ϵuc + βcfg(ϵc − ϵuc)。",
        "anchors": [
          "anc_00081",
          "anc_00082"
        ],
        "appears_in": [
          "anc_00081",
          "anc_00082"
        ]
      },
      {
        "term": "CFG分辨率加权",
        "definition": "ControlNet中用于调整CFG引导强度的技术，权重wi = 64 / hi，其中hi是块大小。",
        "anchors": [
          "anc_00091",
          "anc_00092",
          "anc_00093"
        ],
        "appears_in": [
          "anc_00091",
          "anc_00092",
          "anc_00093"
        ]
      },
      {
        "term": "可训练副本",
        "definition": "ControlNet中从预训练模型编码层克隆的、参数可训练的副本。",
        "anchors": [
          "anc_00050",
          "anc_00053"
        ],
        "appears_in": [
          "anc_00050",
          "anc_00053"
        ]
      },
      {
        "term": "锁定模型",
        "definition": "ControlNet中参数被冻结（锁定）的原始预训练模型。",
        "anchors": [
          "anc_00050",
          "anc_00052"
        ],
        "appears_in": [
          "anc_00050",
          "anc_00052"
        ]
      }
    ]
  },
