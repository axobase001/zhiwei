{
  "paper_skeleton": {
    "problem": {
      "summary": "RGB图像在人群计数中易受光照、遮挡和复杂背景等因素影响，导致计数精度下降。现有RGB-T方法在特征融合和模型复杂度方面存在不足，难以有效利用多模态互补信息并平衡精度与计算成本。",
      "anchors": [
        "anc_00001",
        "anc_00003",
        "anc_00005",
        "anc_00006",
        "anc_00007"
      ]
    },
    "motivation": {
      "summary": "热红外图像能提供温度和轮廓信息，弥补RGB图像在低光照下的不足。需要一种能有效融合多级RGB和热特征、同时保持模型简洁性的方法，以提升复杂场景下的计数精度和泛化能力。",
      "anchors": [
        "anc_00003",
        "anc_00008",
        "anc_00024",
        "anc_00025"
      ]
    },
    "core_idea": {
      "summary": "提出基于编码器-融合-解码器结构的MMFFNet，通过特征融合模块（FFM）采用类注意力机制融合多级RGB-T特征，并设计基于三种注意力机制的特征解码模块（FDM）来优化密度图估计，实现精度与计算成本的平衡。",
      "anchors": [
        "anc_00003",
        "anc_00008",
        "anc_00017"
      ]
    },
    "method": {
      "summary": "MMFFNet采用ConvNeXt-Tiny作为编码器提取多级特征。FFM包含三个子模块：F1（自融合）、F2（交叉融合）和F3（增强融合），通过相互注意力机制融合RGB和热特征。FDM使用通道注意力（CA）、空间注意力（SA）和转置卷积（ConvT）来解码融合特征。损失函数结合计数损失、OT损失和TV损失。",
      "anchors": [
        "anc_00037",
        "anc_00039",
        "anc_00041",
        "anc_00043",
        "anc_00045",
        "anc_00058",
        "anc_00059",
