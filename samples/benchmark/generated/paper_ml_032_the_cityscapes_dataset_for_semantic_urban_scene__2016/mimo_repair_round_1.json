{
  "paper_skeleton": {
    "problem": {
      "summary": "现有城市街景语义理解数据集无法充分捕捉真实世界城市场景的复杂性，限制了自动驾驶等应用的发展。",
      "anchors": [
        "anc_00005",
        "anc_00019",
        "anc_00022"
      ]
    },
    "motivation": {
      "summary": "深度学习在物体检测等领域受益于大规模数据集，但针对语义城市场景理解的数据集在规模、标注丰富度、场景多样性和复杂性方面存在不足。",
      "anchors": [
        "anc_00003",
        "anc_00004",
        "anc_00005",
        "anc_00017",
        "anc_00019",
        "anc_00020"
      ]
    },
    "core_idea": {
      "summary": "引入Cityscapes基准套件和大规模数据集，用于训练和测试像素级和实例级语义标注方法，其规模、标注丰富度、场景多样性和复杂性显著超越以往数据集。",
      "anchors": [
        "anc_00006",
        "anc_00007",
        "anc_00008",
        "anc_00009",
        "anc_00011",
        "anc_00026"
      ]
    },
    "method": {
      "summary": "数据集构建方法：在50个不同城市录制立体视频序列，选取5000张图像进行高质量像素级标注，20000张图像进行粗略标注。提供像素级和实例级语义标注，并配套评估指标和基准测试。",
      "anchors": [
        "anc_00032",
        "anc_00034",
        "anc_00035",
