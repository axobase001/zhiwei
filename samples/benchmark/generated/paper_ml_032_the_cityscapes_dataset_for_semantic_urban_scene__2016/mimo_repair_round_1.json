  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "数据采集与录制",
        "label": "数据采集",
        "summary": "在50个不同城市使用车载立体相机系统录制视频序列，覆盖春、夏、秋三季，避免恶劣天气。",
        "description": "使用汽车级22厘米基线立体相机录制，应用对数压缩曲线进行色调映射，生成16位HDR和8位LDR立体图像对。同时记录车辆里程计、外部温度和GPS轨迹。",
        "type": "data_collection",
        "anchors": [
          "anc_00032",
          "anc_00033",
          "anc_00034"
        ]
      },
      {
        "node_id": "node_002",
        "title": "图像选择与标注",
        "label": "数据标注",
        "summary": "从27个城市中手动选择5000张图像进行高质量像素级标注，从23个城市中选择20000张图像进行粗略标注。",
        "description": "像素级标注在30帧视频片段的第20帧上进行，标注时间控制在每张图像7分钟内。粗略标注通过标注多边形完成，每个像素仅属于一个对象类别。标注质量通过双标注实验验证，像素一致性达96-98%。",
        "type": "annotation",
        "anchors": [
          "anc_00034",
          "anc_00035",
          "anc_00036",
          "anc_00040",
          "anc_00041"
        ]
      },
      {
        "node_id": "node_003",
        "title": "数据集划分",
        "label": "数据划分",
        "summary": "将数据集划分为训练集、验证集和测试集，确保在城市规模、地理位置和时间上的均匀分布。",
        "description": "划分在城市级别进行，确保每个划分在大型、中型、小型城市，地理西、中、东部，地理北、中、南部，以及年初、年中、年末的数据上均匀分布。最终得到2975张训练图像、500张验证图像和1525张测试图像。",
        "type": "data_split",
        "anchors": [
          "anc_00044",
          "anc_00045"
        ]
      },
      {
        "node_id": "node_004",
        "title": "评估指标定义",
        "label": "评估指标",
        "summary": "定义像素级语义标注的IoU和iIoU指标，以及实例级语义标注的评估指标。",
        "description": "像素级任务使用标准IoU和实例归一化iIoU指标。iIoU中每个像素的贡献按类别平均实例大小与相应地面真值实例大小的比率加权。实例级任务使用基于区域提案的检测和分割评估。",
        "type": "evaluation_metric",
        "anchors": [
          "anc_00070",
          "anc_00072",
          "anc_00075",
          "anc_00076"
        ]
      },
      {
