    "terms": [
      {
        "term": "像素级语义标注",
        "definition": "为图像中的每个像素分配一个语义类别标签（如道路、汽车、行人等）。",
        "anchors": [
          "anc_00007"
        ],
        "appears_in": [
          "anc_00007"
        ]
      },
      {
        "term": "实例级语义标注",
        "definition": "在像素级语义标注的基础上，进一步区分同一类别的不同实例（如不同的汽车、行人）。",
        "anchors": [
          "anc_00007",
          "anc_00008"
        ],
        "appears_in": [
