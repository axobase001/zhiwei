{
  "paper_skeleton": {
    "problem": {
      "summary": "句子级别的分类任务（如情感分析、问题分类）在深度学习时代缺乏简单有效的CNN模型，且预训练词向量的利用方式有待探索。",
      "anchors": [
        "anc_00003",
        "anc_00005"
      ]
    },
    "motivation": {
      "summary": "深度学习在计算机视觉和语音识别中取得显著成果，但在NLP中，基于词向量的组合方法仍需改进。CNN在视觉中成功，但其在文本分类中的应用潜力未被充分挖掘。",
      "anchors": [
        "anc_00005",
        "anc_00007"
      ]
    },
    "core_idea": {
      "summary": "提出一个简单的CNN架构，结合预训练词向量（word2vec），通过卷积和最大池化提取句子特征，并探索静态、非静态和多通道词向量变体，以提升句子分类性能。",
      "anchors": [
        "anc_00003",
        "anc_00008",
        "anc_00057"
      ]
    },
    "method": {
      "summary": "模型包括：词向量输入层（静态或可微调）、卷积层（多种窗口大小）、最大池化层、全连接层和softmax输出。使用dropout和L2正则化。训练采用Adadelta优化器。",
      "anchors": [
        "anc_00008",
        "anc_00009",
        "anc_00015",
        "anc_00020",
        "anc_00024",
        "anc_00027",
        "anc_00051"
      ]
    },
    "experiments": {
      "summary": "在7个基准数据集（MR, SST-1, SST-2, Subj, TREC, CR, MPQA）上评估模型变体（CNN-rand, CNN-static, CNN-non-static, CNN-multichannel），并与现有方法（如RAE, MV-RNN, RNTN, DCNN等）比较。",
      "anchors": [
        "anc_00038",
        "anc_00043",
        "anc_00058"
      ]
    },
    "claims": [
      {
        "claim_id": "claim_1",
        "claim": "简单的CNN结合预训练静态词向量即可在多个基准上取得优异结果。",
        "anchors": [
          "anc_00003",
          "anc_00064"
        ]
      },
      {
        "claim_id": "claim_2",
        "claim": "通过微调学习任务特定词向量（非静态）能进一步提升性能。",
        "anchors": [
          "anc_00003",
          "anc_00057",
          "anc_00067"
        ]
      },
      {
        "claim_id": "claim_3",
        "claim": "多通道架构（同时使用静态和非静态词向量）是一种有效的改进。",
        "anchors": [
          "anc_00025",
          "anc_00057",
          "anc_00058"
        ]
      },
      {
        "claim_id": "claim_4",
        "claim": "CNN模型在4/7任务上超越了当时的技术水平。",
        "anchors": [
          "anc_00003",
          "anc_00058",
          "anc_00064"
        ]
      },
      {
        "claim_id": "claim_5",
        "claim": "预训练词向量是深度学习NLP中的重要组成部分。",
        "anchors": [
          "anc_00064",
          "anc_00075"
        ]
      }
    ],
    "limitations": [
      {
        "limitation": "论文未深入探讨更复杂的CNN架构（如更深的网络）、不同预训练词向量（如GloVe）的影响、以及在大规模数据集上的可扩展性。实验主要基于英文数据集，对其他语言的泛化性未验证。",
        "anchors": [
          "anc_00073",
          "anc_00075"
        ]
      }
    ]
  },
  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "词向量输入层",
        "label": "输入表示",
        "summary": "将句子中的每个词映射为k维词向量，通过拼接形成句子矩阵。支持静态（固定）和非静态（可微调）两种模式。",
        "description": "句子长度为n，每个词xi∈R^k。句子表示为x1:n = x1⊕x2⊕...⊕xn，其中⊕是拼接操作。词向量可来自预训练（如word2vec）或随机初始化。",
        "type": "输入处理",
        "anchors": [
          "anc_00009",
          "anc_00014",
          "anc_00055"
        ]
      },
      {
        "node_id": "node_002",
        "title": "卷积层",
        "label": "特征提取",
        "summary": "使用多个不同窗口大小的滤波器对句子矩阵进行卷积，生成特征图。",
        "description": "滤波器w∈R^(hk)应用于h个词的窗口，生成特征ci = f(w·xi:i+h-1 + b)，其中f是非线性函数（如tanh）。对所有窗口应用滤波器得到特征图c = [c1, c2, ..., cn-h+1]。",
        "type": "卷积操作",
        "anchors": [
          "anc_00015",
          "anc_00016",
          "anc_00017",
          "anc_00018"
        ]
      },
      {
        "node_id": "node_003",
        "title": "最大池化层",
        "label": "池化",
        "summary": "对每个特征图取最大值，以捕获最重要的特征，并处理变长句子。",
        "description": "应用max-over-time pooling：ĉ = max{c}。每个滤波器产生一个特征，多个滤波器的特征组成倒数第二层表示。",
        "type": "池化操作",
        "anchors": [
          "anc_00020",
          "anc_00021",
          "anc_00022",
          "anc_00023"
        ]
      },
      {
        "node_id": "node_004",
        "title": "全连接层与输出",
        "label": "分类",
        "summary": "将池化后的特征通过全连接层和softmax输出类别概率分布。",
        "description": "倒数第二层z = [ĉ1, ..., ĉm]（m为滤波器数量），通过全连接层和softmax输出概率分布。使用dropout和L2正则化。",
        "type": "分类层",
        "anchors": [
          "anc_00024",
          "anc_00025",
          "anc_00027",
          "anc_00030"
        ]
      },
      {
        "node_id": "node_005",
        "title": "正则化",
        "label": "防止过拟合",
        "summary": "采用dropout和L2范数约束来防止过拟合。",
        "description": "dropout随机将隐藏单元置零（概率p），测试时权重缩放p倍。L2约束通过梯度下降后重缩放权重实现，使||w||2 ≤ s。",
        "type": "正则化",
        "anchors": [
          "anc_00027",
          "anc_00032",
          "anc_00033",
          "anc_00034",
          "anc_00036"
        ]
      },
      {
        "node_id": "node_006",
        "title": "多通道架构",
        "label": "变体",
        "summary": "使用两个词向量通道（静态和非静态），滤波器应用于两个通道并将结果相加。",
        "description": "在多通道模型中，每个滤波器同时应用于静态和非静态通道，结果相加计算ci。这允许模型同时利用通用和任务特定的词表示。",
        "type": "架构变体",
        "anchors": [
          "anc_00025",
          "anc_00057"
        ]
      }
    ],
    "edges": [
      {
