{
  "paper_skeleton": {
    "problem": {
      "summary": "原始FlowNet在光流估计质量上仍落后于传统方法，尤其在小位移和真实世界数据上无法与变分方法竞争。",
      "anchors": [
        "anc_00005"
      ]
    },
    "motivation": {
      "summary": "推进端到端光流学习概念，使其在质量和速度上取得显著提升，达到与最先进方法相当的精度，同时保持交互式帧率。",
      "anchors": [
        "anc_00005",
        "anc_00007",
        "anc_00009"
      ]
    },
    "core_idea": {
      "summary": "通过三个主要贡献改进FlowNet：1) 训练数据调度策略；2) 堆叠架构与中间光流的图像扭曲；3) 专门处理小位移的子网络。",
      "anchors": [
        "anc_00007"
      ]
    },
    "method": {
      "summary": "提出FlowNet 2.0，包括数据调度（先Chairs后Things3D）、堆叠网络（带扭曲的FlowNetS/FlowNetC）、小位移网络（FlowNet2-SD）和融合网络。",
      "anchors": [
        "anc_00007",
        "anc_00015",
        "anc_00017"
      ]
    },
    "experiments": {
      "summary": "在Sintel、KITTI、Middlebury基准上评估，并在运动分割和动作识别任务上测试应用性能。",
      "anchors": [
        "anc_00067",
        "anc_00073",
        "anc_00079",
        "anc_00083",
        "anc_00085"
      ]
    },
    "claims": [
      {
        "claim_id": "claim_1",
        "claim": "FlowNet 2.0比原始FlowNet误差降低50%以上，与最先进方法性能相当，运行速度达8-140fps。",
        "anchors": [
          "anc_00008",
          "anc_00009",
          "anc_00075",
          "anc_00076"
        ]
      }
    ],
    "limitations": [
      {
        "limitation": "在Middlebury测试集上表现不佳；对极小位移的噪声问题仍有挑战；需要大量训练数据和计算资源。",
        "anchors": [
          "anc_00073",
          "anc_00065"
        ]
      }
    ]
  },
