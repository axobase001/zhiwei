  "glossary": {
    "terms": [
      {
        "term": "自下而上注意力",
        "definition": "由图像内容本身（如显著性、物体）驱动的注意力机制，不依赖于任务上下文。本文中基于Faster R-CNN实现。",
        "anchors": [
          "anc_00003",
          "anc_00009",
          "anc_00014"
        ],
        "appears_in": [
          "anc_00003",
          "anc_00009",
          "anc_00014"
        ]
      },
      {
        "term": "自上而下注意力",
        "definition": "由任务上下文（如部分生成的描述、问题）驱动的注意力机制。本文中根据LSTM状态或问题表示计算权重。",
        "anchors": [
          "anc_00003",
          "anc_00009",
          "anc_00011"
        ],
        "appears_in": [
          "anc_00003",
          "anc_00009",
          "anc_00011"
        ]
      },
      {
        "term": "Faster R-CNN",
        "definition": "一种目标检测框架，包含区域提议网络（RPN）和检测网络，能同时提议区域并提取特征。",
        "anchors": [
          "anc_00003",
          "anc_00014",
          "anc_00033"
        ],
        "appears_in": [
          "anc_00003",
          "anc_00014",
          "anc_00033"
        ]
      },
      {
        "term": "Visual Genome",
        "definition": "一个大规模数据集，包含图像、物体、属性、关系和视觉问答的密集标注。",
        "anchors": [
          "anc_00033",
          "anc_00104"
        ],
        "appears_in": [
          "anc_00033",
          "anc_00104"
        ]
      },
      {
        "term": "自批判序列训练 (SCST)",
        "definition": "一种强化学习方法，用于直接优化序列生成任务的评估指标（如CIDEr）。通过采样和贪婪解码的对比来估计梯度。",
        "anchors": [
          "anc_00080",
          "anc_00081",
          "anc_00082",
          "anc_00083"
        ],
        "appears_in": [
          "anc_00080",
          "anc_00081",
          "anc_00082",
          "anc_00083"
        ]
      },
      {
        "term": "门控双线性池化",
