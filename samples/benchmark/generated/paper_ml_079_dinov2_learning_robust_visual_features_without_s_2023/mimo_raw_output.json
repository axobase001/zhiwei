  "glossary": {
    "terms": [
      {
        "term": "自监督学习 (Self-Supervised Learning, SSL)",
        "definition": "一种机器学习范式，模型从数据本身（如图像的变换、掩码部分）生成监督信号进行训练，无需人工标注。",
        "context": "DINOv2的核心训练方法。",
        "anchors": [
          "anc_00005",
          "anc_00009",
          "anc_00013",
          "anc_00014"
        ]
      },
      {
        "term": "弱监督学习 (Weakly-Supervised Learning, WSL)",
        "definition": "使用弱标注（如图像级别的标签或文本描述）进行训练的学习方法。在本文中特指使用文本-图像对齐（如CLIP）的方法。",
        "context": "作为DINOv2的主要比较基线。",
        "anchors": [
