  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "Slow路径",
        "label": "SlowPathway",
        "summary": "以低帧率处理视频，专注于捕获空间语义和静态特征。",
        "description": "Slow路径是一个标准的卷积模型（如ResNet），以较大的时间步长τ（例如16）从原始视频片段中采样帧。它处理T帧，原始片段长度为T×τ帧。该路径主要关注空间域和语义信息，可以使用更复杂的网络结构。",
        "type": "pathway",
        "anchors": [
          "anc_00023",
          "anc_00024",
          "anc_00025"
        ]
      },
      {
        "node_id": "node_002",
        "title": "Fast路径",
        "label": "FastPathway",
        "summary": "以高帧率处理视频，专注于捕获快速运动和时间细节，且设计轻量级。",
        "description": "Fast路径是另一个卷积模型，以较小的时间步长τ/α（α>1，例如8）处理相同的原始视频片段，保持高时间分辨率。其关键特性包括：1) 高帧率；2) 在整个网络层次中保持高时间分辨率特征（无时间下采样）；3) 低通道容量（通道数为Slow路径的β倍，β<1，例如1/8），使其计算高效。该路径通常占总计算量的约20%。",
        "type": "pathway",
        "anchors": [
          "anc_00025",
          "anc_00026",
          "anc_00027",
          "anc_00028",
          "anc_00029",
          "anc_00030",
          "anc_00031"
        ]
      },
      {
        "node_id": "node_003",
        "title": "横向连接",
        "label": "LateralConnections",
        "summary": "将Fast路径的特征融合到Slow路径中，以匹配特征尺寸并实现信息交互。",
        "description": "横向连接用于融合Fast路径和Slow路径的特征。由于两个路径的特征尺寸不同（Slow: {T, S², C}; Fast: {αT, S², βC}），需要进行变换。论文实验了多种变换方法，例如使用时间步长卷积（如5×1核，步长=α）将Fast特征下采样并增加通道数，然后通过求和或拼接融合到Slow路径中。",
        "type": "connection",
        "anchors": [
          "anc_00038",
          "anc_00052",
          "anc_00053",
          "anc_00054"
        ]
      },
      {
        "node_id": "node_004",
        "title": "SlowFast网络整体",
        "label": "SlowFastNetwork",
        "summary": "由Slow路径、Fast路径和横向连接组成的双路径视频识别架构。",
        "description": "SlowFast网络是一个单流架构，但以两种不同的帧率运行。Slow路径和Fast路径并行处理相同的原始视频片段，通过横向连接融合特征。最后，对每个路径的输出进行全局平均池化，将两个池化后的特征向量拼接，输入到全连接分类器层进行预测。",
        "type": "architecture",
        "anchors": [
          "anc_00020",
          "anc_00023",
          "anc_00038"
        ]
      },
      {
        "node_id": "node_005",
        "title": "实例化（基于ResNet）",
        "label": "Instantiation_ResNet",
        "summary": "基于ResNet-50/101骨干网络的具体SlowFast网络实例化。",
        "description": "论文以ResNet-50为例进行了实例化（见表1）。Slow路径：T=4帧，τ=16，使用非退化时间卷积（时间核大小>1）仅在res4和res5中，之前层本质上是2D卷积。Fast路径：α=8，β=1/8，具有更高的时间分辨率（绿色）和更低的通道容量（橙色），每个块中都有非退化时间卷积，且无时间下采样层。横向连接使用时间步长卷积进行融合。",
        "type": "instantiation",
