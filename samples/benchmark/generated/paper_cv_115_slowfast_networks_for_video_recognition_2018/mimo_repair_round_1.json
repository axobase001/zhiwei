{
  "paper_skeleton": {
    "problem": {
      "summary": "视频识别中，如何有效捕捉视频信号中不同速度的时空信息（空间语义与快速运动）。",
      "anchors": [
        "anc_00005",
        "anc_00009"
      ]
    },
    "motivation": {
      "summary": "传统方法（如3D卷积、双流网络）在处理视频时，通常对时间维度进行对称处理或依赖手工设计的光流，计算成本高且未能充分利用不同时间分辨率的信息。受灵长类视觉系统中视网膜神经节细胞（P细胞和M细胞）的启发，提出一种双路径架构，以不同帧率处理视频，分别专注于空间语义和快速运动。",
      "anchors": [
        "anc_00011",
        "anc_00012",
        "anc_00013",
        "anc_00014",
        "anc_00015",
        "anc_00016",
        "anc_00017",
        "anc_00018",
        "anc_00019",
        "anc_00020"
      ]
    },
    "core_idea": {
      "summary": "设计一个SlowFast网络，包含一个低帧率的Slow路径（用于捕获空间语义）和一个高帧率的Fast路径（用于捕获精细时间分辨率的运动）。Fast路径通过减少通道容量变得轻量级，但仍能学习有用的时间信息。两个路径通过横向连接融合。",
      "anchors": [
        "anc_00005",
        "anc_00009",
        "anc_00023",
        "anc_00024",
        "anc_00025",
        "anc_00026",
        "anc_00027",
        "anc_00028",
        "anc_00029",
        "anc_00030",
        "anc_00031"
      ]
    },
    "method": {
      "summary": "Slow路径以较大时间步长τ（如16）处理视频帧，捕获空间语义；Fast路径以较小时间步长τ/α（α>1，如8）处理相同视频，保持高时间分辨率，但通道数减少为Slow路径的β倍（β<1，如1/8）。两个路径的特征通过横向连接（如时间步长卷积）融合，最终将全局平均池化后的特征拼接用于分类。",
      "anchors": [
        "anc_00023",
        "anc_00024",
        "anc_00025",
        "anc_00026",
        "anc_00027",
        "anc_00028",
        "anc_00029",
        "anc_00030",
        "anc_00031",
        "anc_00038",
        "anc_00052",
        "anc_00053",
        "anc_00054"
      ]
    },
    "experiments": {
      "summary": "在Kinetics-400、Kinetics-600、Charades和AVA数据集上进行评估。包括动作分类和动作检测任务。进行了详细的消融实验，验证SlowFast设计的有效性。",
      "anchors": [
        "anc_00054",
        "anc_00059",
        "anc_00060",
        "anc_00065",
        "anc_00066",
        "anc_00067",
        "anc_00068",
