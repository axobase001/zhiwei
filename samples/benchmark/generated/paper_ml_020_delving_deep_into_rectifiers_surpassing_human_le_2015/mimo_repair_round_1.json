{
  "paper_skeleton": {
    "problem": {
      "summary": "传统ReLU激活函数在深度神经网络中存在局限性，且深度网络的初始化方法不够鲁棒，限制了模型性能的进一步提升。",
      "anchors": [
        "anc_00011"
      ]
    },
    "motivation": {
      "summary": "尽管ReLU是深度网络成功的关键，但其固定形式可能不是最优的。同时，训练极深网络时，不恰当的初始化会导致收敛困难。本文旨在从激活函数和初始化两个方面改进深度整流网络。",
      "anchors": [
        "anc_00011",
        "anc_00051"
      ]
    },
    "core_idea": {
      "summary": "提出可学习的参数化整流线性单元（PReLU）来替代ReLU，并推导出专门针对整流非线性的鲁棒初始化方法，从而能够训练极深的网络并超越人类水平性能。",
      "anchors": [
        "anc_00019",
        "anc_00051"
      ]
    },
    "method": {
      "summary": "1. 定义PReLU激活函数，其负半轴斜率可学习。2. 推导基于前向传播方差和反向传播梯度方差的初始化方法，确保信号在深层网络中不指数级衰减或爆炸。3. 设计并训练了更深、更宽的网络架构（模型A、B、C）。",
      "anchors": [
        "anc_00019",
        "anc_00051",
        "anc_00152"
      ]
    },
    "experiments": {
      "summary": "在ImageNet 2012数据集上进行了广泛实验。比较了ReLU和PReLU在不同模型上的性能。评估了单模型和多模型集成的结果。与人类水平性能进行了对比。",
      "anchors": [
        "anc_00189",
        "anc_00199",
        "anc_00215"
      ]
    },
    "claims": [
      {
        "claim_id": "claim_1",
        "claim": "1. PReLU能以几乎零额外计算成本和过拟合风险提升模型拟合能力。2. 所提出的初始化方法能有效训练极深的整流网络。3. 结合PReLU和初始化方法，最终模型在ImageNet 2012测试集上取得了4.94%的top-5错误率，首次超越了报告的人类水平（5.1%）。",
        "anchors": [
          "anc_00005",
          "anc_00029",
          "anc_00051",
          "anc_00199",
          "anc_00215"
        ]
      }
    ],
    "limitations": [
      {
        "limitation": "1. 尝试训练极深（如30层）模型时，观察到准确率饱和或下降，表明单纯增加深度可能不是最合适的方法。2. 实验主要在ImageNet分类任务上进行，其在其他更复杂任务上的有效性有待验证。",
        "anchors": [
          "anc_00150"
        ]
      }
    ]
  },
  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "PReLU激活函数定义",
        "label": "核心创新",
        "summary": "提出参数化整流线性单元（PReLU），其负半轴斜率是一个可学习的参数，而非ReLU的固定零。",
        "description": "PReLU定义为 f(y_i) = max(0, y_i) + a_i * min(0, y_i)，其中a_i是可学习的系数。当a_i=0时退化为ReLU。该函数允许网络自适应地学习激活函数的形状。",
        "type": "activation_function",
        "anchors": [
          "anc_00019",
          "anc_00020",
          "anc_00022",
          "anc_00023",
          "anc_00024",
          "anc_00025",
          "anc_00026"
        ]
      },
      {
        "node_id": "node_002",
        "title": "PReLU优化方法",
        "label": "训练细节",
        "summary": "PReLU参数通过标准反向传播和动量法进行优化，不使用权重衰减。",
        "description": "PReLU参数a_i的梯度通过链式法则计算。更新时使用动量法，且不使用权重衰减（L2正则化），以避免将参数推向零而偏向ReLU。初始化为a_i=0.25。",
        "type": "optimization",
        "anchors": [
          "anc_00031",
          "anc_00032",
