  "glossary": {
    "terms": [
      {
        "term": "内容寻址记忆 (Content-Addressable Memory)",
        "definition": "一种记忆系统，可以通过部分内容或关联线索检索整个记忆，而不是通过精确地址。",
        "anchors": [
          "anc_00005",
          "anc_00007",
          "anc_00022",
          "anc_00023"
        ],
        "appears_in": [
          "anc_00005",
          "anc_00007",
          "anc_00022",
          "anc_00023"
        ]
      },
      {
        "term": "涌现集体计算能力 (Emergent Collective Computational Abilities)",
        "definition": "从大量简单组件的相互作用中自发产生的复杂计算功能，如记忆、分类、纠错等。",
        "anchors": [
          "anc_00001",
          "anc_00003",
          "anc_00004",
          "anc_00005",
          "anc_00007",
          "anc_00160"
        ],
        "appears_in": [
          "anc_00001",
          "anc_00003",
          "anc_00004",
          "anc_00005",
          "anc_00007",
          "anc_00160"
        ]
      },
      {
        "term": "Hebbian学习 (Hebbian Learning)",
        "definition": "一种学习规则，其基本思想是“一起激发的神经元连在一起”，即如果两个神经元同时活跃，则它们之间的连接强度增加。",
        "anchors": [
          "anc_00050",
          "anc_00051",
          "anc_00052"
        ],
        "appears_in": [
          "anc_00050",
          "anc_00051",
          "anc_00052"
        ]
      },
      {
        "term": "能量函数 (Energy Function)",
        "definition": "在Hopfield网络中定义的一个标量函数，其局部最小值对应于存储的记忆状态。系统状态演化会单调降低该能量。",
        "anchors": [
          "anc_00054",
          "anc_00056"
        ],
        "appears_in": [
          "anc_00054",
          "anc_00056"
        ]
      },
      {
        "term": "异步并行处理 (Asynchronous Parallel Processing)",
        "definition": "一种计算模式，其中多个处理单元（神经元）可以同时更新，但更新是独立且随机顺序的，没有全局时钟同步。",
        "anchors": [
          "anc_00007",
          "anc_00032",
          "anc_00050"
        ],
        "appears_in": [
          "anc_00007",
          "anc_00032",
          "anc_00050"
        ]
      },
      {
        "term": "相空间流动 (Phase Space Flow)",
        "definition": "系统状态随时间演化的轨迹集合。在Hopfield网络中，流动由局部稳定点（吸引子）主导。",
        "anchors": [
          "anc_00005",
          "anc_00019",
          "anc_00020",
          "anc_00022",
          "anc_00023"
        ],
        "appears_in": [
          "anc_00005",
          "anc_00019",
          "anc_00020",
          "anc_00022",
          "anc_00023"
        ]
      },
      {
        "term": "汉明距离 (Hamming Distance)",
        "definition": "两个等长字符串（如二进制向量）之间对应位置不同字符的个数。用于衡量两个状态之间的差异。",
        "anchors": [
          "anc_00064",
          "anc_00066",
          "anc_00134",
          "anc_00135",
          "anc_00136"
        ],
        "appears_in": [
          "anc_00064",
          "anc_00066",
          "anc_00134",
          "anc_00135",
          "anc_00136"
        ]
      }
    ]
  },
