{
  "paper_skeleton": {
    "problem": {
      "summary": "如何从大量简单相互作用的神经元中涌现出有用的集体计算能力，如内容寻址记忆、泛化、分类和纠错等。",
      "anchors": [
        "anc_00001",
        "anc_00003",
        "anc_00004",
        "anc_00005",
        "anc_00007"
      ]
    },
    "motivation": {
      "summary": "生物神经系统和物理系统中，大量简单组件的相互作用可以产生集体现象（如磁性系统中的稳定磁化方向）。本文探索神经元系统中是否存在类似的集体计算特性。",
      "anchors": [
        "anc_00011",
        "anc_00012",
        "anc_00013",
        "anc_00014",
        "anc_00015"
      ]
    },
    "core_idea": {
      "summary": "提出一个基于神经元相互作用的模型，其动力学在相空间中由多个局部稳定状态主导，从而实现内容寻址记忆。该模型具有对称连接权重（T_ij = T_ji），并定义了一个能量函数，系统状态演化会单调降低该能量，最终收敛到局部最小值（即存储的记忆）。",
      "anchors": [
        "anc_00005",
        "anc_00007",
        "anc_00022",
        "anc_00023",
        "anc_00054",
        "anc_00056",
        "anc_00057"
      ]
    },
    "method": {
      "summary": "模型神经元具有二值状态（0或1）。连接权重T_ij通过Hebbian学习规则（公式[2]）存储一组记忆状态。系统状态按异步并行算法更新，每次更新一个神经元的状态，使其趋向于降低能量函数E（公式[7]）。该过程是确定性的（除非引入随机性）。",
      "anchors": [
        "anc_00024",
        "anc_00029",
        "anc_00031",
        "anc_00033",
        "anc_00035",
        "anc_00037",
        "anc_00038",
        "anc_00050",
        "anc_00054",
        "anc_00056",
        "anc_00057"
      ]
    },
    "experiments": {
      "summary": "通过蒙特卡洛模拟（N=30和N=100）验证了模型的性质：1) 随机连接权重下的相空间流动特性；2) 存储记忆的容量（约0.15N）；3) 记忆召回的准确性；4) 对连接权重对称性、裁剪、噪声等的鲁棒性。",
      "anchors": [
