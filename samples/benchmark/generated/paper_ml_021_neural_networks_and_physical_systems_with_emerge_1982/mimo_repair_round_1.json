  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "神经元模型",
        "label": "神经元状态",
        "summary": "每个神经元具有二值状态（0或1），类似于McCulloch-Pitts神经元。",
        "description": "神经元i的状态V_i取0（不发放）或1（最大发放率）。状态更新基于输入总和与阈值（通常设为0）。",
        "type": "component",
        "anchors": [
          "anc_00024",
          "anc_00029",
          "anc_00031"
        ]
      },
      {
        "node_id": "node_002",
        "title": "连接权重存储",
        "label": "Hebbian学习",
        "summary": "通过Hebbian规则存储一组记忆状态到连接权重矩阵T_ij中。",
        "description": "给定要存储的状态集合{V^s}，连接权重定义为T_ij = Σ_s (2V_i^s - 1)(2V_j^s - 1)，且T_ii = 0。这实现了记忆的存储。",
        "type": "process",
        "anchors": [
          "anc_00033",
          "anc_00035",
          "anc_00037",
          "anc_00038"
        ]
      },
      {
        "node_id": "node_003",
        "title": "能量函数",
        "label": "能量定义",
        "summary": "定义系统能量函数E，其局部最小值对应于存储的记忆状态。",
        "description": "能量函数为 E = -1/2 Σ_{i≠j} T_ij V_i V_j。当连接权重对称（T_ij = T_ji）时，状态更新会导致能量单调下降。",
        "type": "objective",
        "anchors": [
          "anc_00054",
          "anc_00056"
        ]
      },
      {
        "node_id": "node_004",
        "title": "状态更新算法",
        "label": "异步并行处理",
        "summary": "系统状态按异步并行算法更新，每次随机选择一个神经元，根据其输入总和更新状态以降低能量。",
        "description": "对于神经元i，计算输入总和 Σ_j T_ij V_j。如果总和大于阈值（通常为0），则V_i设为1；否则设为0。该过程是确定性的（除非引入随机性），并导致能量单调下降。",
        "type": "algorithm",
        "anchors": [
          "anc_00050",
          "anc_00057"
        ]
      },
      {
        "node_id": "node_005",
        "title": "内容寻址记忆",
        "label": "记忆召回",
        "summary": "系统从部分或损坏的输入状态出发，通过动力学演化收敛到最近的存储记忆状态。",
        "description": "给定一个初始状态（可能包含错误或部分信息），系统通过状态更新算法演化，最终稳定在一个局部能量最小值，该最小值对应于一个存储的记忆。这实现了内容寻址记忆。",
        "type": "function",
        "anchors": [
          "anc_00005",
          "anc_00007",
          "anc_00022",
          "anc_00023"
        ]
      },
      {
        "node_id": "node_006",
