{
  "paper_skeleton": {
    "problem": {
      "summary": "Q-learning算法在特定条件下会高估动作值，但此前不清楚这种高估在实践中是否常见、是否损害性能、以及能否普遍防止。",
      "anchors": [
        "anc_00003",
        "anc_00005",
        "anc_00006",
        "anc_00007"
      ]
    },
    "motivation": {
      "summary": "DQN算法（结合Q-learning与深度神经网络）在Atari 2600游戏中存在显著高估，这可能导致学习不稳定和策略质量下降。需要一种方法来减少高估，提高深度强化学习的稳定性和性能。",
      "anchors": [
        "anc_00003",
        "anc_00005",
        "anc_00006",
        "anc_00007",
        "anc_00009",
        "anc_00010",
        "anc_00011"
      ]
    },
    "core_idea": {
      "summary": "将表格型Double Q-learning的思想推广到大规模函数逼近（包括深度神经网络），提出Double DQN算法，通过解耦动作选择和评估来减少高估。",
      "anchors": [
        "anc_00040",
        "anc_00041",
        "anc_00042",
        "anc_00044",
        "anc_00046",
        "anc_00048",
        "anc_00050",
        "anc_00051",
        "anc_00113",
        "anc_00115",
        "anc_00117",
        "anc_00119"
      ]
    },
    "method": {
      "summary": "Double DQN使用两个网络：在线网络用于选择动作，目标网络用于评估该动作的值。具体地，目标值计算为 Y_DoubleDQN = R_{t+1} + γ Q(S_{t+1}, argmax_a Q(S_{t+1}, a; θ_t); θ'_t)，其中θ_t是在线网络参数，θ'_t是目标网络参数。",
      "anchors": [
        "anc_00113",
        "anc_00115",
        "anc_00117",
        "anc_00119",
        "anc_00123",
        "anc_00125",
        "anc_00127"
      ]
    },
    "experiments": {
      "summary": "在49个Atari 2600游戏上评估DQN和Double DQN，包括无操作启动和人类专家轨迹启动两种评估条件。结果表明Double DQN减少了高估，提高了分数和学习稳定性。",
