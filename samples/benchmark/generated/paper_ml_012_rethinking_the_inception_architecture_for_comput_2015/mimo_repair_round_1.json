  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "设计原则",
        "label": "设计原则",
        "summary": "提出了四个指导网络扩展的设计原则，用于避免表征瓶颈、利用高维表征、因式分解卷积和平衡网络深度宽度。",
        "description": "1. 避免表征瓶颈，尤其是在网络早期。2. 高维表征在网络局部更容易处理。3. 低维嵌入不会减少太多信息，可以用于空间聚合。4. 平衡网络的宽度和深度。",
        "type": "principle",
        "anchors": [
          "anc_00014",
          "anc_00015",
          "anc_00016"
        ]
      },
      {
        "node_id": "node_002",
        "title": "卷积因式分解",
        "label": "卷积因式分解",
        "summary": "将大尺寸卷积核分解为多个小尺寸卷积核，以减少计算成本和参数量。",
        "description": "将5x5卷积分解为两个3x3卷积，计算成本减少约28%。进一步将nxn卷积分解为1xn和nx1卷积，在中等网格尺寸上效果良好。",
        "type": "technique",
        "anchors": [
