  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "输入词表示",
        "label": "Input Representation",
        "summary": "将输入词表示为其字符n-gram的集合。",
        "description": "对于词汇表中的每个词，提取其所有长度在3到6之间的字符n-gram。例如，对于词'where'和n=3，其n-gram集合包括'<wh', 'whe', 'her', 'ere', 're>'等。使用哈希函数将这些n-gram映射到固定大小的向量表中。",
        "type": "data_processing",
        "anchors": [
          "anc_00076",
          "anc_00080"
        ]
      },
      {
        "node_id": "node_002",
        "title": "词向量计算",
        "label": "Word Vector Computation",
        "summary": "词向量通过对其所有字符n-gram向量求和得到。",
        "description": "给定一个词w，其向量表示v_w是其所有n-gram向量z_g的和：v_w = Σ_{g∈G(w)} z_g，其中G(w)是词w的n-gram集合。这使得模型能够共享形态相似的词之间的参数。",
        "type": "computation",
        "anchors": [
          "anc_00009",
          "anc_00027"
        ]
      },
      {
        "node_id": "node_003",
        "title": "Skipgram训练目标",
        "label": "Skipgram Objective",
        "summary": "使用skipgram的负采样目标函数进行训练。",
        "description": "训练目标是最大化给定中心词w_t预测其上下文词w_c的对数似然。使用负采样近似，损失函数为：L = -log σ(s(w_t, w_c)) - Σ_{n∈N} log σ(-s(w_t, n))，其中s(w, c)是词w和c的点积相似度，N是负样本集合。",
        "type": "objective",
        "anchors": [
          "anc_00056",
          "anc_00057",
          "anc_00058",
          "anc_00066",
          "anc_00067",
          "anc_00068"
        ]
      },
      {
        "node_id": "node_004",
        "title": "优化与训练",
        "label": "Optimization and Training",
        "summary": "使用随机梯度下降和异步并行更新进行训练。",
        "description": "使用随机梯度下降（SGD）优化负对数似然。学习率线性衰减。采用Hogwild!算法进行异步并行训练，所有线程共享参数并异步更新向量。",
        "type": "optimization",
        "anchors": [
          "anc_00088",
          "anc_00089"
        ]
      },
      {
        "node_id": "node_005",
        "title": "未登录词处理",
        "label": "OOV Handling",
        "summary": "为未登录词生成向量表示。",
        "description": "对于训练集中未出现的词（OOV），通过对其字符n-gram向量求和来生成其向量表示。这使得模型能够处理新词，无需重新训练。",
        "type": "inference",
        "anchors": [
          "anc_00011",
          "anc_00105",
          "anc_00191"
        ]
      }
    ],
