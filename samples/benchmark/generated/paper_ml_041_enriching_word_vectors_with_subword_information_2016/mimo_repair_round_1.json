{
  "paper_skeleton": {
    "problem": {
      "summary": "传统词向量模型（如skipgram）为词汇表中的每个词分配独立的向量，忽略了词的内部形态结构。这在形态丰富的语言（如德语、芬兰语）中是一个主要限制，因为这些语言包含大量词形变化和罕见词，导致模型难以学习到良好的词向量表示。",
      "anchors": [
        "anc_00023",
        "anc_00024",
        "anc_00025"
      ]
    },
    "motivation": {
      "summary": "形态丰富的语言中，许多词形遵循规则，利用字符级信息可以改善词向量表示。现有方法要么忽略形态信息，要么需要复杂的形态学分析或监督数据。本文旨在提出一种简单、快速、无需预处理的方法，通过字符n-gram来丰富词向量，从而更好地处理罕见词和未登录词。",
      "anchors": [
        "anc_00025",
        "anc_00026",
        "anc_00027"
      ]
    },
    "core_idea": {
      "summary": "扩展skipgram模型，将每个词表示为其字符n-gram向量的和。为每个字符n-gram学习一个向量表示，词向量则通过对其包含的所有n-gram向量求和得到。这种方法能够捕捉词的内部结构，并为未登录词生成有意义的向量。",
      "anchors": [
        "anc_00009",
        "anc_00027"
      ]
    },
    "method": {
      "summary": "基于skipgram框架，将词表示为字符n-gram的集合（bag of character n-grams）。使用哈希函数将n-gram映射到固定大小的向量表中。训练目标与skipgram相同，即最大化给定中心词预测上下文词的对数似然。通过负采样进行优化。",
      "anchors": [
        "anc_00053",
        "anc_00056",
        "anc_00068",
        "anc_00076",
        "anc_00080"
      ]
    },
    "experiments": {
      "summary": "在九种语言上评估了词相似度和词类比任务。与基线模型（skipgram, cbow）和现有形态学词向量方法进行了比较。进行了消融实验，研究了训练数据规模和n-gram长度范围的影响。还在语言建模任务上评估了预训练词向量的效果。",
      "anchors": [
        "anc_00097",
        "anc_00098",
        "anc_00099",
        "anc_00101",
        "anc_00103",
        "anc_00108",
        "anc_00109",
