{
  "paper_skeleton": {
    "problem": {
      "summary": "在基于提议的实例分割框架中，信息传播路径存在局限性，导致低层精确的定位信号难以有效传递到顶层特征，且每个提议仅从单一特征层级池化特征，限制了预测性能。",
      "anchors": [
        "anc_00013"
      ]
    },
    "motivation": {
      "summary": "信息在神经网络中的传播方式至关重要。现有方法（如FPN）中，低层特征到顶层特征的路径较长，且提议的特征池化层级分配是启发式的，可能丢弃其他层级的有用信息。此外，掩码预测仅基于单一视图，缺乏多样性信息。",
      "anchors": [
        "anc_00013",
        "anc_00033",
        "anc_00034",
        "anc_00035",
        "anc_00036",
        "anc_00037",
        "anc_00038",
        "anc_00039",
        "anc_00040",
        "anc_00041",
        "anc_00042",
        "anc_00043",
        "anc_00044",
        "anc_00045",
        "anc_00046",
        "anc_00047",
        "anc_00048",
        "anc_00049",
        "anc_00050",
        "anc_00053"
      ]
    },
    "core_idea": {
      "summary": "提出路径聚合网络（PANet），通过三个关键改进增强信息流：1）自下而上的路径增强，缩短低层与顶层特征的信息路径；2）自适应特征池化，使每个提议能聚合所有特征层级的信息；3）全连接融合分支，捕获每个提议的不同视图以提升掩码预测。",
      "anchors": [
        "anc_00013",
        "anc_00016",
        "anc_00033",
        "anc_00034",
        "anc_00035",
        "anc_00036",
        "anc_00037",
        "anc_00038",
        "anc_00039",
        "anc_00040",
