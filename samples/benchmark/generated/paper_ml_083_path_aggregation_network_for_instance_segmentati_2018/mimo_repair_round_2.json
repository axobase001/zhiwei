  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "FPN骨干网络",
        "label": "backbone",
        "summary": "基于ResNet或ResNeXt的特征金字塔网络（FPN），生成多尺度特征图{P2, P3, P4, P5}。",
        "description": "FPN通过自上而下的路径和横向连接，从骨干网络的不同阶段生成多尺度特征图，用于后续的提议生成和特征提取。",
        "type": "backbone",
        "anchors": [
          "anc_00014",
          "anc_00015"
        ]
      },
      {
        "node_id": "node_002",
        "title": "自下而上的路径增强",
        "label": "bottom_up_path_augmentation",
        "summary": "在FPN的基础上，增加自下而上的路径，通过横向连接和卷积层将低层特征传递到高层，生成增强的特征金字塔{N2, N3, N4, N5}。",
        "description": "该模块旨在缩短低层特征到顶层特征的信息路径，使低层精确的定位信号更容易传播。每个构建块包含一个横向连接和一个3×3卷积层，迭代进行直至P5。",
        "type": "augmentation",
        "anchors": [
          "anc_00013",
          "anc_00023",
          "anc_00024",
          "anc_00031",
          "anc_00032"
        ]
      },
      {
        "node_id": "node_003",
        "title": "自适应特征池化",
        "label": "adaptive_feature_pooling",
        "summary": "对每个提议，从所有特征层级（N2-N5）池化特征网格，并通过元素级最大操作融合，以聚合多尺度信息。",
        "description": "该模块解决了FPN中提议仅从单一特征层级池化的问题。首先将提议映射到所有特征层级，使用ROIAlign池化特征网格，然后通过融合操作（如最大操作）合并。融合操作置于第一个参数层之后，以允许网络适应不同层级的特征。",
        "type": "pooling",
        "anchors": [
