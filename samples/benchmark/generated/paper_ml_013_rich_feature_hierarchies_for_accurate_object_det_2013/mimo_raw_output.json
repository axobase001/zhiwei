  "glossary": {
    "terms": [
      {
        "term": "R-CNN",
        "definition": "Regions with CNN features。本文提出的目标检测方法，结合区域建议和CNN特征。",
        "anchors": [
          "anc_00005",
          "anc_00009",
          "anc_00010"
        ]
      },
      {
        "term": "区域建议 (Region Proposals)",
        "definition": "类别无关的候选物体区域，由选择性搜索等算法生成，用于后续特征提取和分类。",
        "anchors": [
          "anc_00010",
          "anc_00011",
          "anc_00025",
          "anc_00037",
          "anc_00039"
        ]
      },
      {
        "term": "选择性搜索 (Selective Search)",
        "definition": "一种生成区域建议的算法，通过层次化地合并超像素来产生多尺度的候选区域。",
        "anchors": [
          "anc_00039",
          "anc_00153"
        ]
      },
      {
        "term": "微调 (Fine-tuning)",
        "definition": "在预训练模型的基础上，使用目标领域的数据继续训练模型参数，以适应新任务。",
        "anchors": [
          "anc_00005",
          "anc_00029",
          "anc_00030",
          "anc_00031",
          "anc_00059",
          "anc_00060",
          "anc_00062",
          "anc_00063",
          "anc_00065",
          "anc_00067",
          "anc_00069",
          "anc_00070",
          "anc_00071",
          "anc_00073",
          "anc_00097"
        ]
      },
      {
        "term": "预训练 (Pre-training)",
        "definition": "在大型数据集（如ImageNet）上训练模型，学习通用的特征表示。",
        "anchors": [
          "anc_00005",
          "anc_00029",
          "anc_00030",
          "anc_00059",
          "anc_00060"
        ]
      },
      {
        "term": "mAP (mean Average Precision)",
        "definition": "平均精度均值，是目标检测任务的标准评估指标，综合考虑了精确率和召回率。",
        "anchors": [
          "anc_00005",
          "anc_00013",
          "anc_00014",
          "anc_00026",
          "anc_00027",
          "anc_00031",
          "anc_00075",
          "anc_00078",
          "anc_00079",
          "anc_00080",
          "anc_00097",
          "anc_00120",
          "anc_00121",
          "anc_00161"
        ]
      },
      {
        "term": "IoU (Intersection over Union)",
        "definition": "交并比，用于衡量两个边界框重叠程度的指标，是定义正负样本和评估检测结果的关键。",
        "anchors": [
          "anc_00065",
          "anc_00204"
        ]
      },
      {
        "term": "非极大值抑制 (Non-Maximum Suppression, NMS)",
        "definition": "一种后处理技术，用于去除同一物体周围的冗余检测框，保留置信度最高的框。",
        "anchors": [
          "anc_00032",
          "anc_00047",
          "anc_00053",
          "anc_00083"
        ]
      },
      {
        "term": "边界框回归 (Bounding-Box Regression)",
        "definition": "一种后处理技术，用于修正检测框的位置和大小，使其更接近真实边界框。",
        "anchors": [
          "anc_00033",
          "anc_00034",
          "anc_00097",
          "anc_00120",
          "anc_00121",
          "anc_00210",
          "anc_00226"
        ]
      },
      {
        "term": "硬负例挖掘 (Hard Negative Mining)",
        "definition": "在训练SVM时，专门选择那些容易被错误分类为正样本的负样本（即难负例）进行训练，以提升分类器性能。",
        "anchors": [
          "anc_00070",
          "anc_00071"
        ]
      },
      {
        "term": "仿射图像变形 (Affine Image Warping)",
        "definition": "将任意形状的区域建议通过仿射变换扭曲到CNN所需的固定尺寸（如正方形）。",
        "anchors": [
          "anc_00025",
          "anc_00041",
          "anc_00045",
          "anc_00188",
          "anc_00190",
          "anc_00195"
        ]
      }
    ]
  },
