  "method_graph": {
    "nodes": [
      {
        "node_id": "node_001",
        "title": "图像投影",
        "label": "投影变换",
        "summary": "将图像矩阵A通过线性变换投影到单位向量X上，得到投影特征向量Y。",
        "description": "给定一个n维单位列向量X，将m×n的图像矩阵A投影到X上，得到m维投影向量Y=AX。这一步骤避免了将图像矩阵转换为向量的过程。",
        "type": "transformation",
        "anchors": [
          "anc_00016"
        ]
      },
      {
        "node_id": "node_002",
        "title": "总散度准则",
        "label": "优化目标",
        "summary": "通过最大化投影样本的总散度来确定最优投影方向X。",
        "description": "采用准则J(X)=tr(Sx)，其中Sx是投影特征向量的协方差矩阵。最大化该准则意味着找到投影方向X，使得投影后样本的总散度最大。",
        "type": "objective",
        "anchors": [
          "anc_00020",
          "anc_00025",
          "anc_00026",
          "anc_00027",
          "anc_00028"
        ]
      },
      {
        "node_id": "node_003",
        "title": "图像协方差矩阵",
        "label": "协方差矩阵",
        "summary": "定义图像协方差矩阵Gt，用于计算最优投影轴。",
        "description": "定义Gt=E[(A-EA)^T(A-EA)]，这是一个n×n的非负定矩阵。Gt可以从训练图像样本中直接计算得到，其大小远小于传统PCA的协方差矩阵。",
        "type": "matrix",
        "anchors": [
          "anc_00029"
        ]
      },
      {
        "node_id": "node_004",
        "title": "最优投影轴",
        "label": "特征分解",
        "summary": "通过求解Gt的特征向量来获得最优投影轴。",
        "description": "最优投影轴Xopt是Gt的最大特征值对应的特征向量。通常需要选择一组正交投影轴X1,...,Xd，它们是Gt的前d个最大特征值对应的正交特征向量。",
        "type": "decomposition",
        "anchors": [
          "anc_00034",
          "anc_00035",
          "anc_00036",
          "anc_00037",
          "anc_00038",
          "anc_00039",
          "anc_00040"
        ]
      },
      {
        "node_id": "node_005",
        "title": "特征提取",
        "label": "特征矩阵",
        "summary": "使用最优投影轴提取图像的主成分向量，形成特征矩阵。",
        "description": "对于图像样本A，计算Yk=AXk (k=1,...,d)，得到d个主成分向量。这些向量组成m×d的特征矩阵B=[Y1,...,Yd]，称为图像A的特征矩阵或特征图像。",
        "type": "extraction",
        "anchors": [
          "anc_00042"
        ]
      },
      {
        "node_id": "node_006",
        "title": "分类方法",
        "label": "最近邻分类",
        "summary": "使用最近邻分类器基于特征矩阵进行分类。",
        "description": "定义两个特征矩阵Bi和Bj之间的距离为d(Bi,Bj)=∑_{k=1}^d ||Y_k^{(i)}-Y_k^{(j)}||^2。对于测试样本B，如果d(B,Bl)=min_j d(B,Bj)且Bl属于类别ωk，则将B分类为ωk。",
        "type": "classification",
        "anchors": [
          "anc_00044",
          "anc_00045",
          "anc_00046"
        ]
      },
      {
        "node_id": "node_007",
        "title": "图像重建",
        "label": "重建方法",
        "summary": "使用2DPCA的主成分向量和投影轴重建图像。",
        "description": "给定正交特征向量X1,...,Xd和主成分向量Yk=AXk，令V=[Y1,...,Yd]和U=[X1,...,Xd]，则重建图像Ã=VU^T=∑_{k=1}^d Yk Xk^T。当d=n时，可以完全重建原始图像。",
        "type": "reconstruction",
        "anchors": [
          "anc_00048",
          "anc_00049",
          "anc_00050"
        ]
      }
    ],
