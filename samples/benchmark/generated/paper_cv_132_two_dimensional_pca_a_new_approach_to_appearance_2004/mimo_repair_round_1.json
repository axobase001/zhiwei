  "glossary": {
    "terms": [
      {
        "term": "2DPCA",
        "definition": "二维主成分分析，一种直接基于二维图像矩阵进行特征提取的方法，避免了将图像转换为向量的过程。",
        "anchors": [
          "anc_00012"
        ],
        "appears_in": [
          "anc_00012"
        ]
      },
      {
        "term": "PCA",
        "definition": "主成分分析，一种经典的特征提取方法，需要将图像转换为向量后计算协方差矩阵。",
        "anchors": [
          "anc_00003"
        ],
        "appears_in": [
          "anc_00003"
        ]
      },
      {
        "term": "Eigenfaces",
        "definition": "基于PCA的人脸识别方法，使用特征脸（协方差矩阵的特征向量）进行人脸表示。",
        "anchors": [
          "anc_00003"
        ],
        "appears_in": [
          "anc_00003"
        ]
      },
      {
        "term": "图像协方差矩阵",
        "definition": "在2DPCA中定义的矩阵Gt=E[(A-EA)^T(A-EA)]，用于计算最优投影轴。",
        "anchors": [
          "anc_00029"
        ],
        "appears_in": [
          "anc_00029"
        ]
      },
      {
        "term": "投影轴",
        "definition": "用于将图像矩阵投影到低维空间的单位向量，通过最大化总散度准则获得。",
        "anchors": [
          "anc_00033",
          "anc_00034"
        ],
        "appears_in": [
          "anc_00033",
          "anc_00034"
        ]
      },
      {
        "term": "特征矩阵",
        "definition": "由2DPCA提取的主成分向量组成的矩阵B=[Y1,...,Yd]，用于表示图像。",
        "anchors": [
          "anc_00042"
        ],
        "appears_in": [
          "anc_00042"
        ]
      },
      {
        "term": "总散度",
        "definition": "投影样本的协方差矩阵的迹，用于衡量投影方向的区分能力。",
        "anchors": [
          "anc_00020",
          "anc_00025",
          "anc_00026",
          "anc_00027",
          "anc_00028"
        ],
        "appears_in": [
          "anc_00020",
          "anc_00025",
          "anc_00026",
          "anc_00027",
          "anc_00028"
        ]
      },
      {
        "term": "最近邻分类器",
        "definition": "一种分类方法，将测试样本分类到与其最近的训练样本所属的类别。",
        "anchors": [
          "anc_00044",
          "anc_00045",
          "anc_00046"
        ],
        "appears_in": [
          "anc_00044",
          "anc_00045",
          "anc_00046"
        ]
      }
    ]
  },
