      },
      {
        "node_id": "node_004",
        "title": "最优投影轴",
        "label": "特征分解",
        "summary": "通过求解Gt的特征向量来获得最优投影轴。",
        "description": "最优投影轴Xopt是Gt的最大特征值对应的特征向量。通常需要选择一组正交投影轴X1,...,Xd，它们是Gt的前d个最大特征值对应的正交特征向量。",
        "type": "decomposition",
        "anchors": [
