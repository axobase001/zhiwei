  "glossary": {
    "开放集目标检测": "检测由人类语言输入（如类别名称或指代表达）指定的任意物体，包括训练时未见过的类别。",
    "闭集目标检测": "检测预定义类别的物体。",
    "指代表达理解": "根据自然语言描述（通常包含属性）定位图像中的特定物体。",
    "接地预训练": "在区域-文本对数据上进行预训练，学习视觉区域与语言短语之间的对齐。",
    "子句级文本表示": "一种文本处理技术，通过注意力掩码阻止无关类别名称之间的注意力交互，使每个类别名称的特征提取只关注自身。",
    "语言引导的查询选择": "根据文本特征动态选择初始对象查询，用于解码器阶段。",
    "特征增强器": "用于早期跨模态融合的模块，通过自注意力和交叉注意力增强图像和文本特征。",
    "跨模态解码器": "解码器阶段，进一步融合图像和文本信息以生成最终检测结果。",
    "匈牙利匹配": "一种算法，用于在训练期间将预测框与真实框进行最优匹配。",
    "GIoU": "广义交并比，一种用于边界框回归的损失函数。",
    "terms": []
  },
  "reproduction_roadmap": {
    "reproduction": {
      "required_datasets": [
        "COCO（检测数据）",
        "Objects365（O365，检测数据）",
